---
import '../styles/global.css';
interface Props { title: string; description?: string }
const { title, description = 'Gemlik ve Mudanya kıyısında meralar için saatlik LRF av puanı.' } = Astro.props;
---
<!doctype html>
<html lang="tr" data-app="av-livn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0e1c27" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/">av<span>.</span>livn</a>
        <span class="species">İstavrit, lamba altında</span>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site">
      <div class="wrap">
        <p>Puan kural tabanlıdır (v1) ve sahada kalibre edilecektir. Denize çıkmadan önce hava durumunu ve güvenliği kendiniz kontrol edin.</p>
        <p>Veri: <a href="https://open-meteo.com/">Open-Meteo</a> (CC BY 4.0) ve DWD ICON, Copernicus Marine Service, EMODnet Bathymetry, © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> katkıcıları.</p>
      </div>
    </footer>
    <script>
      if ('serviceWorker' in navigator && location.hostname !== 'localhost') {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      }
    </script>
  </body>
</html>
