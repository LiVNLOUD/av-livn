---
import '../styles/global.css';
import { PARAMS, LEVREK_PARAMS, paramBasis, type ParamDef } from '@av-livn/scoring';
// I4: counts computed from the parameter tables (never hand-written): evidence letter and basis of the number
const tally = (defs: ParamDef[]) => {
  const ev = (l: string) => defs.filter((d) => d.evidence === l).length;
  const guess = defs.filter((d) => paramBasis(d) === 'varsayim').length;
  return `${defs.length} parametreden ${['A', 'B', 'C'].map((l) => `${l} ${ev(l)}`).join(', ')}; değeri varsayım olan ${guess}`;
};
const IST = tally(Object.values(PARAMS) as ParamDef[]);
const LEV = tally(Object.values(LEVREK_PARAMS) as ParamDef[]);
interface Props { title: string; description?: string; fullscreen?: boolean; app?: boolean }
const { title, description = 'Gemlik ve Mudanya kıyısında meralar için saatlik LRF av puanı.', fullscreen = false, app = false } = Astro.props;
const path = Astro.url.pathname;
const cur = (p: string): 'page' | undefined => ((p === '/' ? path === '/' : path.startsWith(p)) ? 'page' : undefined);
// M1: visitors see Plan, Harita, Model; the owner's tools appear only with the admin key on this device
const NAV: [string, string][] = [['/', 'Plan'], ['/harita/', 'Harita'], ['/model/', 'Model']];
const NAV_ADMIN: [string, string][] = [['/sahadayim/', 'Sahadayım'], ['/gunluk/', 'Günlük'], ['/ayarlar/', 'Ayarlar']];
const TABS: [string, string, string, boolean][] = [
  ['/', 'Plan', 'M4 6h16M4 12h16M4 18h10', false],
  ['/harita/', 'Harita', 'M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2zm0 0v14m6-12v14', false],
  ['/model/', 'Model', 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zm0 5v5m0 3v.5', false],
  ['/sahadayim/', 'Sahadayım', 'M12 5v14M5 12h14', true],
  ['/gunluk/', 'Günlük', 'M6 4h12v16H6zM9 8h6M9 12h6M9 16h4', true],
];
---
<!doctype html>
<html lang="tr" data-app="av-livn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0e1c27" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <title>{title}</title>
    <script is:inline>if (/[?&]embed=1/.test(location.search)) document.documentElement.classList.add('embed');</script>
  </head>
  <body class:list={{ fullscreen, app }}>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/">av<span>.</span>livn</a>
        <nav aria-label="Ana menü">
          {NAV.map(([href, label]) => <a href={href} aria-current={cur(href)}>{label}</a>)}
          <span class="sep admin-only" hidden></span>
          {NAV_ADMIN.map(([href, label]) => <a class="admin-only" href={href} aria-current={cur(href)} hidden>{label}</a>)}
          <a class="admin-only" href="/admin/adaylar/" aria-current={cur('/admin/adaylar')} hidden>Adaylar</a>
          <a class="admin-only" href="/admin/" aria-current={path === '/admin/' ? 'page' : undefined} hidden>Panel</a>
        </nav>
      </div>
    </header>
    <p class="stale" id="stale" role="status"></p>
    <main><slot /></main>
    <footer class="site">
      <div class="wrap">
        <p>Model v2.0: habitat uygunluk indeksi (HSI). Kanıt: istavrit {IST}; levrek (deneysel) {LEV}. Kaynak bir etkinin varlığını destekleyebilir; katsayıların çoğu henüz av günlüğüyle kalibre edilmedi. Ayrıntı: <a href="/model/">Model nasıl çalışıyor?</a>, <a href="https://github.com/LiVNLOUD/av-livn/blob/main/docs/MODEL.md">MODEL.md</a>, <a href="https://github.com/LiVNLOUD/av-livn/blob/main/docs/RESEARCH.md">kaynaklar</a>. Denize çıkmadan önce hava durumunu ve güvenliği kendiniz kontrol edin. Lamba = iskele/limanın mevcut aydınlatması; kendi ışığınızla balık toplamak yasaktır (6/2 Tebliğ md. 8/8). <a href="/ayarlar/">Ayarlar ve Takımım</a></p>
        <p>Tür: istavrit, LRF. Veri: <a href="https://open-meteo.com/">Open-Meteo</a> (CC BY 4.0) ve DWD ICON, <a href="https://marine.copernicus.eu/">Copernicus Marine Service</a> (Karadeniz/Marmara 500 m), <a href="https://emodnet.ec.europa.eu/en/bathymetry">EMODnet Bathymetry Consortium (2024): EMODnet Digital Bathymetry (DTM 2024)</a>, EMODnet Seabed Habitats (EUSeaMap 2025), © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> katkıcıları, <a href="https://openfreemap.org">OpenFreeMap</a>.</p>
      </div>
    </footer>
    <nav class="tabbar" aria-label="Sekmeler">
      {TABS.map(([href, label, d, adm]) => (
        <a href={href} aria-current={cur(href)} class:list={{ 'admin-only': adm }} hidden={adm}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={d} /></svg>{label}</a>
      ))}
    </nav>
    <script>
      import { freshness, type WeatherRunInfo } from '../scripts/format';
      // Admin links only when the owner key is on this device (the pages themselves still ask for it).
      try { if (localStorage.getItem('av-livn-admin')) document.querySelectorAll<HTMLElement>('.admin-only').forEach((e) => (e.hidden = false)); } catch {}
      // E8/N5: data freshness, one rule for every page and the plan card (scripts/format.ts freshness)
      fetch('/api/spots', { cache: 'no-cache' })
        .then((r) => (r.ok ? r.json() : null))
        .then((b: { scored_at?: string | null; data_fetched_at?: string | null; weather_run?: WeatherRunInfo | null } | null) => {
          if (!b) return;
          const f = freshness(b.scored_at, b.data_fetched_at, Date.now(), b.weather_run ?? null);
          if (f.banner) {
            const el = document.getElementById('stale')!;
            el.textContent = f.banner;
            el.classList.add('on');
          }
        })
        .catch(() => {});
      if ('serviceWorker' in navigator && location.hostname !== 'localhost') {
        // A new deploy installs a new worker that claims the page; reload once so HTML and assets match.
        const hadController = !!navigator.serviceWorker.controller;
        let reloaded = false;
        navigator.serviceWorker.addEventListener('controllerchange', () => {
          if (hadController && !reloaded) { reloaded = true; location.reload(); }
        });
        navigator.serviceWorker.register('/sw.js', { updateViaCache: 'none' }).catch(() => {});
      }
    </script>
  </body>
</html>
