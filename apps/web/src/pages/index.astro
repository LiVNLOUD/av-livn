  :global(.timeline .tl-sky.day) { fill: rgb(232 239 243 / .34); } :global(.timeline .tl-sky.tw) { fill: rgb(232 239 243 / .14); } :global(.timeline .tl-sky.night) { fill: rgb(0 0 0 / .45); }
