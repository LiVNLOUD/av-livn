---
import Base from '../layouts/Base.astro';
---
<Base title="av.livn — Av planı" app themeable>
  <!-- Q2: start the plan's data requests at once, before the page modules load (~0.6 s earlier on the critical path).
       Same URLs as scripts/species.ts api(); the page takes each response once (preFetch) or fetches itself.
       V1.7 (D8): in <head> before the stylesheets, and as soon as the windows arrive the details of the likely picks
       (first three of each window list, at most six spots, ~6 KB each compressed) start too, so the decision card does
       not wait for a second round trip after the page modules have run. -->
  <script is:inline slot="head">
    (function () {
      // V1.7 (D8): on a first visit the web font (~60 KB) would share the slow link with the plan's requests; the page
      // draws in the system font until the card is ready, then the font loads (it swaps in, as it always did)
      try { if (!localStorage.getItem('av-livn-font')) document.documentElement.setAttribute('data-font-wait', ''); } catch (e) {}
      setTimeout(function () { document.documentElement.removeAttribute('data-font-wait'); }, 3000);
      var sp = 'istavrit';
      try {
        var q = new URLSearchParams(location.search).get('tur');
        var v = localStorage.getItem('av-livn-species');
        sp = q === 'levrek' || q === 'istavrit' ? q : v === 'levrek' || v === 'istavrit' ? v : 'istavrit';
      } catch (e) {}
      var api = function (p) { return sp === 'istavrit' ? p : p + (p.indexOf('?') >= 0 ? '&' : '?') + 'species=' + sp; };
      var pre = {};
      var details = function (d) {
        var ids = [];
        var take = function (b) { if (b && b.windows) b.windows.slice(0, 3).forEach(function (w) { if (ids.indexOf(w.spot_id) < 0) ids.push(w.spot_id); }); };
        var pb = d && d.plan && d.plan.bursa;
        [pb && pb.today, pb, d && d.today].forEach(function (g) { if (g) { take(g.all); take(g.open); } });
        ids.slice(0, 6).forEach(function (id) { var u = api('/api/spots/' + encodeURIComponent(id) + '?model=v2'); if (!pre[u]) { pre[u] = fetch(u, { priority: 'high' }); pre[u].catch(function () {}); } });
      };
      ['/api/windows', '/api/spots', '/api/trust-gate'].forEach(function (p) {
        var u = api(p);
        pre[u] = fetch(u, { cache: 'no-cache', priority: 'high' });
        if (p === '/api/windows') pre[u] = pre[u].then(function (r) { if (r.ok) r.clone().json().then(details).catch(function () {}); return r; });
        // the header's freshness check reads the same answer (a copy) instead of downloading the spot list again
        if (p === '/api/spots') window.__avSpots = pre[u].then(function (r) { return r.clone(); });
        pre[u].catch(function () {});
      });
      window.__avPre = pre;
    })();
  </script>
  <div class="app" id="app" data-view="plan">
    <!-- M1: the plan is the first view at every width; the hour chart and the full list are one tap away -->
    <div class="views" role="tablist" aria-label="Görünüm">
      <button type="button" role="tab" data-v="plan" aria-selected="true">Plan</button>
      <button type="button" role="tab" data-v="heat" aria-selected="false">Saat çizelgesi</button>
      <button type="button" role="tab" data-v="spots" aria-selected="false">Tüm meralar</button>
      <label class="sp-pick"><span class="lbl-t">Tür</span>
        <select id="species" aria-label="Tür">
          <option value="istavrit">İstavrit</option>
          <option value="levrek">Levrek (deneysel)</option>
          <option disabled>Lüfer / çinekop (araştırılıyor)</option>
          <option disabled>Mırmır / karagöz (araştırılıyor)</option>
          <option disabled>Kolyoz (araştırılıyor)</option>
        </select>
      </label>
    </div>
    <!-- O3: the hour the map and the list show; follows the plan's hour -->
    <p class="timebar" id="timebar" hidden><span>Gösterilen saat: <b id="tb-time"></b></span><button type="button" class="tb-now" id="tb-now">şimdiye dön</button></p>

    <section class="r-win" aria-labelledby="t-main">
      <h1 id="t-main" class="vh">Av planı</h1>
      <div class="plan" id="plan" aria-live="polite">
       <div class="plan-main">
        <p class="eq-note" id="eq-note" hidden></p>
        <div class="eq-pick" id="eq-pick" role="radiogroup" aria-label="Eşdeğer seçenekler" hidden></div>
        <p class="stale-card" id="stale-card" role="alert" hidden></p>
        <article class="card main-pick" id="pick">
          <div class="qa q1"><h2 class="q">Bugün gitmeye değer mi?</h2><p class="a big" id="verdict">Yükleniyor…</p><p class="a-sub"><span id="verdict-sub"></span> <span class="fresh" id="fresh"></span></p></div>
          <div class="qa q2" hidden><h2 class="q q-row">Nereye, ne zaman? <a id="a-maplink" class="q-link" href="/harita/" title="Bu saatte rüzgar, dalga, akıntı ve yağış haritası">haritada aç</a></h2><p class="a big nm" id="a-where"></p><p class="a-sub tm" id="a-when"></p><p class="cond" id="a-cond" hidden></p><p class="a-sub now-line" id="a-now" hidden></p></div>
          <div class="qa q3" hidden><h2 class="q">Ne ile başla?</h2><p class="a tk-line" id="a-tackle">hesaplanıyor…</p><p class="a-sub" id="a-tackle-sub"></p><details class="rig-more" id="rig-card" hidden><summary><span id="t-rig">Yöntem, bağlama ve kullanım </span><span class="muted fs-1" id="rig-hour"></span></summary><div class="rig-box" id="rig"></div></details></div>
          <div class="qa q4" hidden><h2 class="q">Neden?</h2><ul class="a why" id="a-why"></ul></div>
          <div class="qa q5" hidden><h2 class="q">Ne kadar güvenilir?</h2><p class="a big trust" id="a-trust"></p><p class="a-sub" id="a-trust-sub"></p><ul class="trust3" id="a-trust3" aria-label="Üç ayrı güven"></ul><p class="a-sub models-line" id="a-models" hidden></p></div>
          <details class="why-more" id="why-more" hidden>
            <summary>Neden? Ayrıntılar (puan, belirsizlik, kanıt, kaynaklar)</summary>
            <div id="why-detail"></div>
            <p class="fs-2">Puan, o saatteki koşulların bu tür için tanımlı <b>ideal senaryoya göre yeri</b> (0–100); sahada doğrulanmış yakalama olasılığı değildir. <b>Bant</b> ve <b>“ilk 3'te”</b> payı yalnız model parametrelerinin belirsizliğini gösterir; hava tahmininin hatası dahil değildir. <b>Güçlü:</b> zirve ≥ 65 ve veri tam; <b>görece:</b> mevcut seçeneklerin en iyisi. Rüzgar ya da dalga verisi yoksa öneri verilmez.</p>
            <p class="fs-2"><a href="/model/">Model nasıl çalışıyor?</a> · <a href="https://github.com/LiVNLOUD/av-livn/blob/main/docs/DATA-SOURCES.md">Veri kaynakları</a></p>
          </details>
          <!-- V1.4 / D9: on phones the first screen is the decision and the conditions; map and timeline one tap away -->
          <div class="m-jump" id="m-jump"><button type="button" class="btn" id="m-tl">Saat saat çizelge</button><a class="btn secondary" id="m-map" href="/harita/">Harita</a><button type="button" class="btn secondary" id="m-more" aria-expanded="false">Takım ve güven</button></div>
          <div class="go" id="pick-go" hidden><button type="button" class="btn" id="pick-open">Merayı ve saatleri aç</button><a class="btn secondary admin-only" id="pick-field" href="/sahadayim/" hidden>Sahadayım'da başlat</a></div>
        </article>
       </div>
      </div>
    </section>

    <!-- V1.4 (direction A): the dock under the map — the spot's av zaman çizelgesi, equivalent options, tackle picture -->
    <section class="r-dock" id="dock" aria-label="Av zaman çizelgesi ve seçenekler">
      <section class="card dock-tl" id="strip-card" hidden aria-labelledby="t-strip">
        <h2 class="side-h" id="t-strip">Av zaman çizelgesi <span class="muted fs-1" id="strip-name"></span></h2>
        <div class="tl-box"><div class="tl-labs" id="tl-labs" aria-hidden="true"></div><div class="strip-box" id="strip"></div></div>
        <p class="fs-1 muted strip-legend">yerel saat · <span class="lg-win" aria-hidden="true"></span> önerilen pencere · dikey çizgi: seçili saat (harita ve kart bu saati gösterir) · bir saate dokununca hepsi o saate geçer · rüzgar ekseni 0–40 km/sa</p>
      </section>
      <section class="dock-alts" id="alts-box" hidden aria-labelledby="alts-h">
        <h2 class="side-h" id="alts-h">Eşdeğer seçenekler <span class="muted fs-1">sıralama yok</span></h2>
        <div class="alts-t" role="table" aria-labelledby="alts-h">
          <div class="alts-h" role="row"><span role="columnheader">Mera</span><span role="columnheader">Uygunluk</span><span role="columnheader">Erişim</span><span role="columnheader">Rüzgara göre</span><span role="columnheader">Veri</span></div>
          <ol class="alts" id="alts"></ol>
        </div>
      </section>
    </section>

    <section class="r-heat" aria-labelledby="t-heat">
      <details class="more-win" id="more-win">
        <summary>En iyi pencereler <span class="muted fs-2">önümüzdeki 72 saat</span></summary>
        <ol class="windows" id="windows" aria-live="polite"><li class="muted">Yükleniyor…</li></ol>
        <p class="muted fs-1" id="win-note"></p>
      </details>
      <div class="heat-head">
        <h2 id="t-heat">Mera × saat</h2>
        <div class="heat-ctl">
          <div class="seg-sm" role="radiogroup" aria-label="Isı haritası görünümü">
            <button type="button" role="radio" aria-checked="true" data-mode="score">Puan</button>
            <button type="button" role="radio" aria-checked="false" data-mode="diff">Meraya özgü fark</button>
          </div>
          <label class="toggle sm"><input type="checkbox" id="hm-unc" /> Belirsizliği göster</label>
        </div>
      </div>
      <p class="fs-1 muted legend-line" id="hm-legend"></p>
      <div class="heat" id="heat"><p class="muted fs-2">Yükleniyor…</p></div>
      <div class="card heat-sum" id="heat-sum" hidden aria-live="polite"></div>
    </section>

    <section class="r-spots" aria-labelledby="t-spots">
      <h2 class="sec" id="t-spots">Tüm meralar</h2>
      <div class="when" role="group" aria-label="Saat seçimi">
        <button type="button" id="now" class="btn secondary on">Şimdi</button>
        <select id="day" aria-label="Gün"></select>
        <select id="hour" aria-label="Saat"></select>
      </div>
      <p class="muted fs-2" id="meta">Meralar yükleniyor…</p>
      <label class="toggle"><input type="checkbox" id="hide-access" /> Erişimi belirsiz/kısıtlı olanları gizle</label>
      <ol class="spots" id="spots" aria-live="polite"></ol>
      <div class="spot-table-box" id="spot-table" hidden></div>
      <p class="empty muted" id="empty" hidden></p>
    </section>

    <section class="r-map" aria-label="Harita">
      <div class="mapbox" id="map"></div>
      <p class="mini-legend fs-1"><span class="sw-pick" aria-hidden="true"></span> önerilen mera <span class="sw-forb" aria-hidden="true"></span> liman, sanayi, askeri alan: mera eklenmez · <a href="/harita/">tam harita</a></p>
    </section>

    <aside class="r-card" id="drawer" hidden aria-label="Mera kartı">
      <div class="drawer-head">
        <span class="fs-2 muted" id="drawer-title">Mera kartı</span>
        <div class="actions">
          <a class="btn small secondary" id="drawer-open" href="/mera/">Tam sayfa</a>
          <button type="button" class="btn small secondary" id="drawer-close" aria-label="Kartı kapat">Kapat</button>
        </div>
      </div>
      <iframe id="drawer-frame" title="Mera kartı" loading="lazy"></iframe>
    </aside>
  </div>
</Base>

<style>
  /* M1: one grid; the plan is the first view. ≥768 px: plan ~60 % | compact map ~40 %; hour chart full width. */
  .app { display: grid; gap: var(--s4); padding: var(--s4); grid-template-columns: minmax(0, 1fr); grid-template-areas: 'views' 'tb' 'main'; }
  .timebar { grid-area: tb; }
  .views { grid-area: views; display: flex; flex-wrap: wrap; align-items: center; gap: var(--s2); }
  .views button { min-height: 44px; padding: 0 var(--s4); border-radius: 999px; border: 1px solid var(--swell); background: transparent; color: var(--mist); font: inherit; font-size: var(--fs-2); font-weight: 650; cursor: pointer; }
  .views button[aria-selected='true'] { background: var(--swell); color: var(--foam); border-color: var(--mist); }
  .sp-pick { margin-left: auto; display: flex; align-items: center; gap: var(--s2); font-size: var(--fs-2); color: var(--mist); }
  .sp-pick select { height: 44px; padding-top: 0; padding-bottom: 0; }
  .r-win, .r-heat, .r-spots { grid-area: main; min-width: 0; }
  /* decision first at every width (V1.4, D9): the equal-options chips follow the card */
  .app[data-view='plan'] .r-win :global(.plan-main) { display: flex; flex-direction: column; gap: var(--s3); }
  .app[data-view='plan'] .r-win :global(#stale-card) { order: -1; }
  .app[data-view='plan'] .r-win :global(#eq-note), .app[data-view='plan'] .r-win :global(#eq-pick) { order: 2; margin: 0; }
  .r-dock { grid-area: dock; min-width: 0; }
  .app:not([data-view='plan']) .r-win, .app:not([data-view='heat']) .r-heat, .app:not([data-view='spots']) .r-spots, .app:not([data-view='plan']) .r-dock { display: none; }
  .r-map { grid-area: map; display: none; }
  .r-card { grid-area: card; }
  :global(.vh) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (max-width: 767px) {
    .views { gap: var(--s1); }
    .views button { padding: 0 var(--s3); }
    /* M4: the species picker sits in the header bar on phones so the five answers fit the first screen */
    .sp-pick { position: absolute; top: calc((var(--header-h) - 44px) / 2); right: var(--s4); z-index: 31; }
    .sp-pick .lbl-t { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .app { gap: var(--s3); padding-top: var(--s3); }
  }
  @media (min-width: 768px) {
    .app { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); grid-template-areas: 'views views' 'tb tb' 'main map'; }
    .app[data-view='heat'] { grid-template-areas: 'views views' 'tb tb' 'main main'; }
    .app[data-view='heat'] .r-map { display: none !important; }
    .r-map { display: block; position: sticky; top: var(--s4); height: calc(100dvh - var(--header-h) - var(--s6)); }
    .r-card:not([hidden]) { position: fixed; z-index: 20; left: 0; right: 0; bottom: 0; height: 62dvh; }
  }
  @media (min-width: 1200px) {
    :global(body.app) { height: 100dvh; overflow: hidden; }
    :global(body.app main) { min-height: 0; }
    :global(body.app footer.site) { display: none; }
    .app { height: 100%; padding: 0; gap: 0; grid-template-rows: auto auto minmax(0, 1fr); grid-template-columns: minmax(0, 3fr) minmax(0, 2fr) auto; grid-template-areas: 'views views views' 'tb tb tb' 'main map card'; }
    .app[data-view='heat'] { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: 'views views' 'tb tb' 'main card'; }
    .views { padding: var(--s3) var(--s5); border-bottom: 1px solid var(--swell); }
    .r-win, .r-spots, .r-heat { padding: var(--s5); overflow: auto; }
    .r-spots > *:not(.spot-table-box) { max-width: 900px; }
    .r-map { position: relative; top: 0; height: auto; min-height: 0; border-left: 1px solid var(--swell); }
    .r-card:not([hidden]) { position: static; height: auto; width: clamp(420px, 28vw, 480px); border-left: 1px solid var(--swell); } /* Q4: ≥ 420 px, ~480 px where the screen allows; the map narrows */
  }

  .sec { margin: var(--s5) 0 var(--s3); display: flex; gap: var(--s2); align-items: baseline; flex-wrap: wrap; }
  .windows { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--s2); }
  :global(.win) { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--s1) var(--s3); }
  :global(.win .t) { font-weight: 700; font-size: var(--fs-3); line-height: var(--lh-3); }
  :global(.win .n) { grid-column: 1; font-size: var(--fs-2); line-height: var(--lh-2); }
  :global(.win .s) { grid-row: 1 / span 2; grid-column: 2; align-self: center; text-align: right; font-size: var(--fs-5); line-height: var(--lh-5); font-weight: 760; }
  :global(.win .s small) { display: block; font-size: var(--fs-1); font-weight: 500; color: var(--mist); }
  :global(.win .r) { grid-column: 1 / -1; font-size: var(--fs-2); line-height: var(--lh-2); color: var(--mist); }
  :global(.win .actions) { grid-column: 1 / -1; margin-top: var(--s2); }
  .heat-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--s2); margin-bottom: var(--s3); }
  .legend-line { margin: 0 0 var(--s2); display: flex; align-items: center; gap: var(--s1); flex-wrap: wrap; }
  .heat-ctl { display: flex; align-items: center; gap: var(--s3); flex-wrap: wrap; }
  .seg-sm { display: inline-flex; border: 1px solid var(--swell); border-radius: 999px; padding: 2px; }
  .seg-sm button { border: 0; background: none; color: var(--mist); font: inherit; font-size: var(--fs-1); font-weight: 600; padding: 0 var(--s3); min-height: 32px; border-radius: 999px; cursor: pointer; }
  .seg-sm button[aria-checked='true'] { background: var(--swell); color: var(--foam); }
  .toggle.sm { min-height: 32px; font-size: var(--fs-1); color: var(--mist); }
  .toggle.sm input { width: 16px; height: 16px; }
  :global(.divramp) { display: inline-block; width: 64px; height: 10px; border-radius: 2px; background: linear-gradient(90deg, rgb(86 160 204), rgb(27 46 59), rgb(245 168 60)); }
  .heat-sum { margin-top: var(--s4); display: grid; gap: var(--s1); font-size: var(--fs-2); }
  :global(.heat-sum h3) { font-size: var(--fs-3); margin: 0; display: flex; gap: var(--s2); align-items: baseline; flex-wrap: wrap; }
  :global(.heat-sum .big) { font-size: var(--fs-5); font-weight: 760; line-height: 1; }
  :global(.heat-sum p) { margin: 0; color: var(--mist); }
  :global(.heat-sum .tk) { color: var(--foam); }
  :global(.heat-sum .tk b) { color: var(--sodium); font-weight: 650; }
  :global(.heatmap .hm-focus) { fill: none; stroke: var(--foam); stroke-width: 1; opacity: 0.45; }
  :global(.ramp) { display: inline-block; width: 56px; height: 10px; border-radius: 2px; background: linear-gradient(90deg, rgb(57 50 52), rgb(185 126 80), rgb(71 157 109)); }
  :global(.gatesw) { display: inline-block; width: 14px; height: 10px; border-radius: 2px; background: var(--danger-bg); border: 1px solid var(--storm); }
  :global(.hatchsw) { display: inline-block; width: 14px; height: 10px; border-radius: 2px; background: repeating-linear-gradient(45deg, #0e1c27 0 1.5px, #5d9a76 1.5px 4px); }
  .heat { overflow-x: auto; }
  :global(.heatmap) { display: block; font-family: inherit; }
  :global(.heatmap text) { fill: var(--foam); font-size: var(--fs-1); }
  :global(.heatmap .hm-day) { font-weight: 650; font-size: var(--fs-1); }
  :global(.heatmap .hm-tick), :global(.heatmap .hm-nowl) { fill: var(--mist); font-size: var(--fs-1); }
  :global(.heatmap .hm-sep) { stroke: var(--foam); stroke-width: 1.5; opacity: 0.75; }
  :global(.heatmap .hm-now) { stroke: var(--sodium); stroke-width: 1; }
  :global(.heatmap .hm-nowl) { fill: var(--sodium); }
  :global(.heatmap .hm-selcol) { fill: var(--foam); opacity: 0.12; }
  :global(.heatmap .hm-cell) { cursor: pointer; }
  :global(.heatmap .hm-cell:hover) { stroke: var(--foam); stroke-width: 1; }
  :global(.heatmap .hm-name text) { cursor: pointer; }
  :global(.heatmap .hm-name:hover text) { fill: var(--sodium); }
  :global(.heatmap .hm-b) { fill: var(--warn); font-size: var(--fs-1); }
  :global(.heatmap .hm-b.legal) { fill: var(--storm); }
  .when { display: flex; gap: var(--s2); flex-wrap: wrap; align-items: center; margin-bottom: var(--s2); }
  .when select { flex: 1 1 120px; height: 40px; padding-top: 0; padding-bottom: 0; }
  #now.on { background: var(--foam); color: var(--sea); border-color: var(--foam); }
  .toggle { display: flex; gap: var(--s2); align-items: center; grid-auto-flow: column; justify-content: start; min-height: 44px; }
  .toggle input { width: 20px; height: 20px; }
  .spots { list-style: none; margin: var(--s2) 0 0; padding: 0; }
  :global(.grp-btn) { width: 100%; display: grid; grid-template-columns: 52px minmax(0, 1fr); gap: var(--s3); align-items: center; padding: var(--s3) 0; border: 0; border-top: 1px solid var(--swell); background: none; color: var(--foam); font: inherit; font-size: var(--fs-2); text-align: left; cursor: pointer; min-height: 52px; }
  :global(.grp-btn:hover) { color: var(--sodium); }
  :global(.grp), :global(.grp-btn) { min-width: 0; max-width: 100%; }
  :global(.grp-btn > span:last-child) { white-space: normal; overflow-wrap: anywhere; min-width: 0; }
  :global(.grp.beach .grp-btn) { font-weight: 650; }
  :global(.heatmap .hm-grp text) { fill: var(--sodium); font-weight: 650; cursor: pointer; }
  :global(.spot) { display: grid; grid-template-columns: 52px minmax(0, 1fr); gap: var(--s3); align-items: center; padding: var(--s3) 0; border-top: 1px solid var(--swell); text-decoration: none; cursor: pointer; }
  :global(.spot h3) { font-size: var(--fs-3); line-height: var(--lh-3); font-weight: 620; }
  :global(.spot .sub), :global(.spot .why), :global(.spot .reason) { margin: 2px 0 0; font-size: var(--fs-2); line-height: var(--lh-2); color: var(--mist); }
  :global(.spot .rk) { color: var(--foam); font-weight: 700; }
  :global(.spot .badge) { margin-left: var(--s1); }
  .empty { padding: var(--s5) 0; }
  /* O5: table of all spots on wide screens */
  .spot-table-box { overflow-x: auto; }
  .spot-table-box[hidden] { display: none; }
