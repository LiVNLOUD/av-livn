  :global(.fitpill.f0) { background: var(--fit-0); color: var(--fit-t0); } :global(.fitpill.f1) { background: var(--fit-1); color: var(--fit-t1); } :global(.fitpill.f2) { background: var(--fit-2); color: var(--fit-t2); }
