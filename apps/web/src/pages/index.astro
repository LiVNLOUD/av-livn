    :global(body.app:has(.app[data-view='plan'])) { height: auto; overflow: visible; }
    .app[data-view='plan'] { height: auto; grid-template-columns: minmax(0, 1fr) auto; position: relative; min-height: calc(100dvh - var(--header-h)); grid-template-rows: auto auto minmax(300px, 1fr) auto; grid-template-areas: 'views card' 'tb card' 'map card' 'dock card'; }
    .app[data-view='plan'] { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'views' 'tb' 'map' 'dock'; }
