</style>

<script>
  import { esc, fmtAgo, fmtDay, fmtTime, freshness, type WeatherRunInfo, KIND_TR, lampV2, swimRule } from '../scripts/format';
  import { IF_DARK, IF_LIT, kindLabel, leadWithRank, tackle, tackleClass, TACKLE_CLASSES, tackleLevrek, tackleLevrekLine, tackleLine, recommendMethods, type TackleInput } from '@av-livn/scoring';
  import { loadMy, personalLine, toOwned, toProfiles } from '../scripts/mytackle';
  import { catchTrust, compass8, windRel, driverSentence, equalText, lightSentence, modelAgreement, nowVsPlan, planPick, spotKnowledge, trust, trustTail, verdictText, weatherSentence, weatherTrust, type TrustRow } from '../scripts/plan';
  import { timelineRows, timelineSvg, fitStep } from '../scripts/timeline';
  import { frameIndex, loadGrid, nearest, type Grid } from '../scripts/layers';
  import { icon, kindIcon } from '../scripts/icons';
  import { rigSvg, type RigVariant, type Zone } from '../scripts/rig';
  import { methodLine, mountMethodCard } from '../scripts/methodcard';
  import { sinkerFor } from '../scripts/rigscene';
  import { api, currentSpecies, LEGAL_MIN, link, saveSpecies, SPECIES_TR, type Species } from '../scripts/species';
  import { renderHeatmap, type HeatRow, type HoursData, type HourSpot } from '../scripts/heatmap';
  import { columnMax, groupSame, isGroup, rankLabel, splitBeaches, tieCounts } from '../scripts/grouping';
  import type { MapApi } from '../scripts/map';
  import { browserUrl, createHourStore, type HourSource } from '../scripts/hour';

  type Spot = {
    id: string; name: string; lat: number; lon: number; kind: string; status: string; place: string | null; lamp_known: boolean; access: string | null; auto_added?: boolean; province?: string | null; private_marina?: boolean;
    score: { total: number | null; p10: number | null; p90: number | null; rank: number | null; gated: boolean; warnings: string[]; partial: boolean; reason: string | null; top3?: number | null; missing?: string[] | string | null };
  };
  type Win = { spot_id: string; name: string; start: string; end: string; peak: string; total: number; p10: number | null; p90: number | null; rank: number; why: string | null; reason?: string | null; assumed: boolean; tier?: 'guclu' | 'goreli'; missing?: string | null; top3?: number | null; access?: string | null };

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const app = $('app');
  let species: Species = currentSpecies();
  /** Q2: the response started by the inline script for this exact URL (once), else a fresh request. */
  const preFetch = (url: string, init?: RequestInit): Promise<Response> => {
    const pre = (window as { __avPre?: Record<string, Promise<Response>> }).__avPre;
    const p = pre?.[url];
    if (!p) return fetch(url, init);
    delete pre![url];
    return p.catch(() => fetch(url, init));
  };
  const HOUR = 3_600_000;
  const TZ_OFF = 3;
  const ACCESS_BADGE: Record<string, string> = { kisitli_feribot: 'kısıtlı olabilir (feribot)', belirsiz: 'erişim belirsiz' };
  const MARINA_BADGE = 'kısıtlı olabilir (marina — özel işletme)';
  const HIDE = 'av-livn-hide-access';
  // V1.1: one selected hour for the page (map, card, tackle, list, heat map), mirrored in ?t= (same as /harita/)
  const hourStore = createHourStore({ url: browserUrl() });
  const nowHour = hourStore.nowHour;
  let sel = 0; // column index from nowHour; follows hourStore (applyHour)
  let all: Spot[] = [];
  let hours: HoursData | null = null;
  let fetched: string | null = null;
  const atIso = () => (sel === 0 ? null : new Date((nowHour + sel) * HOUR).toISOString());
  const box = $<HTMLInputElement>('hide-access');
  try { box.checked = localStorage.getItem(HIDE) === '1'; } catch {}
  const hidden = (s: { access: string | null }) => box.checked && !!s.access && s.access !== 'acik';
  /** I5: spots outside Bursa stay in the list (badge) but not in the home plan. */
  const outside = (s: { province?: string | null }) => !!s.province && s.province !== 'bursa';
  box.addEventListener('change', () => {
    try { localStorage.setItem(HIDE, box.checked ? '1' : '0'); } catch {}
    render();
    heat();
    summary();
    renderWindows();
    renderPlan();
  });

  // ---------------------------------------------------------------- card drawer
  const wide = matchMedia('(min-width: 768px)');
  function openSpot(id: string, col = sel) {
    const t = new Date((nowHour + col) * HOUR).toISOString();
    const url = link(`/mera/?id=${encodeURIComponent(id)}&t=${encodeURIComponent(t)}`, species);
    if (!wide.matches) { location.href = url; return; }
    $<HTMLIFrameElement>('drawer-frame').src = `${url}&embed=1`;
    $<HTMLAnchorElement>('drawer-open').href = url;
    $('drawer-title').textContent = all.find((s) => s.id === id)?.name ?? hours?.spots.find((s) => s.id === id)?.name ?? 'Mera kartı';
    $('drawer').hidden = false;
    mapApi?.focus(id); // O1: one path for plan, map, list and heat map — zoom in and ring the spot
    requestAnimationFrame(() => mapApi?.resize());
  }
  // V1.4 / D9: phone shortcuts — the timeline and the tackle/why/trust block open in place, the map is a link
  $('m-tl').addEventListener('click', () => { app.classList.toggle('m-tl'); if (app.classList.contains('m-tl')) { if (cardWin) drawStrip(cardWin, sel); $('dock').scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' }); } });
  $('m-more').addEventListener('click', () => { const on = app.classList.toggle('m-more'); $('m-more').setAttribute('aria-expanded', String(on)); });
  $('drawer-close').addEventListener('click', () => { $('drawer').hidden = true; requestAnimationFrame(() => mapApi?.resize()); });
  addEventListener('message', (e) => { if (e.origin === location.origin && e.data === 'close-card') $('drawer-close').click(); });

  // ---------------------------------------------------------------- map (≥768 px, beside the plan and the list)
  // Q2: the plan card comes first. The map (MapLibre, WebGL, tiles) and other secondary work start only after the card
  // is complete ("plan-ready"), or after 1.5 s at the latest, so they never compete with it.
  let planIsReady = false;
  const afterPlan: (() => void)[] = [];
  function planReady() {
    if (planIsReady) return;
    planIsReady = true;
    performance.mark('plan-ready');
    // V1.7: the web font may load now (first visit); later visits do not wait for it
    document.documentElement.removeAttribute('data-font-wait');
    void document.fonts?.load('1em "Bricolage Grotesque Variable"').then((f) => { if (f.length) try { localStorage.setItem('av-livn-font', '1'); } catch {} }).catch(() => {});
    const run = () => afterPlan.splice(0).forEach((f) => f());
    if ('requestIdleCallback' in window) requestIdleCallback(run, { timeout: 300 }); else setTimeout(run, 0);
  }
  /** Runs f once the plan card is drawn (immediately if it already is). */
  const whenPlanReady = (f: () => void) => (planIsReady ? f() : afterPlan.push(f));
  setTimeout(planReady, 1500); // the windows request failed or is slow: secondary work must not wait forever
  let mapApi: MapApi | null = null;
  let pickId: string | null = null; // M3: the plan's pick, highlighted on the map
  async function ensureMap() {
    if (mapApi || !wide.matches || app.dataset.view === 'heat') return;
    const { mountMap } = await import('../scripts/map');
    mapApi = mountMap({ container: $('map'), at: atIso(), onSpot: (id) => openSpot(id), species, highlight: pickId });
    padMap();
  }
  /** V1.4: on wide screens the decision panel floats over the map's left side; the camera keeps spots out from under it. */
  function padMap() {
    if (!mapApi) return;
    const panel = document.querySelector<HTMLElement>('.r-win');
    const floating = matchMedia('(min-width: 1024px)').matches && app.dataset.view === 'plan' && panel;
    mapApi.setPadding({ left: floating ? panel!.getBoundingClientRect().width + 32 : 0 });
  }
  addEventListener('resize', () => padMap());
  // ---------------------------------------------------------------- M1: views (Plan · Saat çizelgesi · Tüm meralar)
  const VIEW = 'av-livn-view';
  type View = 'plan' | 'heat' | 'spots';
  const viewBtns = [...document.querySelectorAll<HTMLButtonElement>('.views [data-v]')];
  function setView(v: View, remember = true) {
    app.dataset.view = v;
    viewBtns.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.v === v)));
    if (remember) try { sessionStorage.setItem(VIEW, v); } catch {}
    if (v === 'heat') requestAnimationFrame(() => { heat(); summary(); });
    else ensureMap().then(() => requestAnimationFrame(() => { mapApi?.resize(); padMap(); }));
  }
  viewBtns.forEach((b) => b.addEventListener('click', () => setView(b.dataset.v as View)));
  // the plan is the first view; a tab chosen in this browser session is kept on reload
  try { const v = sessionStorage.getItem(VIEW); if (v === 'heat' || v === 'spots') setView(v, false); } catch {}
  wide.addEventListener('change', () => ensureMap());

  // ---------------------------------------------------------------- hour picker (Istanbul local time)
  const day = $<HTMLSelectElement>('day');
  const hourSel = $<HTMLSelectElement>('hour');
  const local = (h: number) => new Date((h + TZ_OFF) * HOUR);
  const days = [0, 1, 2, 3].map((k) => {
    const d = local(nowHour + 24 * k);
    return Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate()) / HOUR - TZ_OFF;
  }).filter((m) => m < nowHour + 72);
  day.innerHTML = days.map((m, i) => `<option value="${m}">${i === 0 ? 'Bugün' : i === 1 ? 'Yarın' : fmtDay(new Date((m + 12) * HOUR).toISOString())}</option>`).join('');
  function fillHours() {
    const m = Number(day.value);
    const o: string[] = [];
    for (let h = 0; h < 24; h++) if (m + h >= nowHour && m + h <= nowHour + 71) o.push(`<option value="${m + h}">${String(h).padStart(2, '0')}:00</option>`);
    hourSel.innerHTML = o.join('');
  }
  /** Change the selected hour; every view follows through applyHour. Re-applies even when the hour is unchanged. */
  function setCol(col: number, source: HourSource = 'list') {
    const before = hourStore.get().col;
    hourStore.set(col, source);
    if (hourStore.get().col === before) applyHour();
  }
  hourStore.subscribe(() => applyHour());
  function applyHour() {
    sel = hourStore.get().col;
    const h = nowHour + sel;
    day.value = String([...days].reverse().find((d) => d <= h) ?? days[0]);
    fillHours();
    hourSel.value = String(h);
    $('now').classList.toggle('on', sel === 0);
    // O3: the hour the map and the list show, with a way back to now
    const tb = $('timebar');
    tb.hidden = sel === 0;
    if (sel) {
      const iso = new Date(h * HOUR).toISOString();
      const d = fmtDay(iso);
      $('tb-time').textContent = `${d === fmtDay(new Date().toISOString()) ? 'bugün' : d} ${fmtTime(iso)}`;
    }
    load();
    heat();
    mapApi?.setHour(atIso());
  }
  $('tb-now').addEventListener('click', () => { cardCol = null; setCol(0, 'now'); renderPlan(); });
  $('now').addEventListener('click', () => setCol(0, 'now'));
  day.addEventListener('change', () => { fillHours(); setCol(Number(hourSel.value) - nowHour); });
  hourSel.addEventListener('change', () => setCol(Number(hourSel.value) - nowHour));

  // ---------------------------------------------------------------- list
  // G3: structures first, beaches in one collapsible group; identical score+band as one expandable row.
  const BEACH = 'av-livn-beaches';
  let beachesOpen = false;
  try { beachesOpen = localStorage.getItem(BEACH) === '1'; } catch {}
  const openGroups = new Set<string>();
  const toggleGroup = (key: string) => {
    if (key === 'beaches') {
      beachesOpen = !beachesOpen;
      try { localStorage.setItem(BEACH, beachesOpen ? '1' : '0'); } catch {}
    } else if (!openGroups.delete(key)) openGroups.add(key);
    render();
    heat();
  };
  const sameLabel = (kinds: string[], n: number) => `${n} ${new Set(kinds).size === 1 ? kindLabel(kinds[0]!) : 'mera'} aynı puan`;

  const tableMq = matchMedia('(min-width: 1200px)');
  tableMq.addEventListener('change', () => render());
  /** O5: best non-capped hour of a spot in the next 72 h (from /api/hours). */
  function bestHour(id: string): { col: number; v: number } | null {
    const hs = hours?.spots.find((x) => x.id === id);
    if (!hs) return null;
    const off = hours ? nowHour - Math.floor(Date.parse(hours.from) / HOUR) : 0;
    let bc = -1, bv = -1;
    for (let c = 0; c < 72; c++) { const v = hs.t[off + c]; if (v != null && !hs.g.includes(off + c) && v > bv) { bv = v; bc = c; } }
    return bc < 0 ? null : { col: bc, v: bv };
  }
  /** P0: access as a short badge in the table; the long text is the tooltip. */
  const ACCESS_SHORT = (s: Spot): [string, string] =>
    s.private_marina ? ['Marina', MARINA_BADGE] : s.access === 'kisitli_feribot' ? ['Feribot', ACCESS_BADGE.kisitli_feribot!] : s.access === 'belirsiz' ? ['Belirsiz', ACCESS_BADGE.belirsiz!] : s.access === 'acik' ? ['Açık', 'erişim açık (tahmin; sahada doğrulanmadı)'] : ['Bilinmiyor', 'erişim bilgisi yok'];
  const dayWordShort = (iso: string) => {
    const d = fmtDay(iso);
    return d === fmtDay(new Date().toISOString()) ? 'bugün' : d.split(' ')[0]!; // full weekday, no date
  };
  type SortKey = 'score' | 'best' | 'name';
  let tblSort: { key: SortKey; dir: 1 | -1 } = { key: 'score', dir: -1 };
  function tableTrust(s: Spot) {
    const sc = s.score;
    if (sc.total === null) return null;
    const reason = sc.reason ?? null;
    const why = reason ? reason.replace(/^(Öne çıkaran|Geri bırakan) \([^)]*\): /, '') : null;
    return trust({ why, reason, assumed: /varsayım|kanıt C|\(C\)|ölçüm değil/.test(reason ?? ''), tier: sc.total >= 65 ? 'guclu' : 'goreli', missing: (Array.isArray(sc.missing) ? sc.missing.length : sc.missing) ? 'eksik' : null, top3: sc.top3 ?? null, p10: sc.p10, p90: sc.p90 }, { calibrated: calibrated[species] === true }).level;
  }
  function tableRow(s: Spot, showTrust: boolean): string {
    const sc = s.score;
    const [acc, accLong] = ACCESS_SHORT(s);
    const score = sc.total === null ? '–' : sc.gated ? `${Math.round(sc.total)} <span class="badge storm" title="Puan güvenlik tavanında (rüzgar ya da dalga eşiği aşıldı)">güvenlik</span>` : String(Math.round(sc.total));
    const bh = bestHour(s.id);
    const bIso = bh ? new Date((nowHour + bh.col) * HOUR).toISOString() : null;
    const best = bh && bIso ? `${dayWordShort(bIso)} ${fmtTime(bIso)} · ${Math.round(bh.v)}` : '–';
    const tl = showTrust ? tableTrust(s) : null;
    return `<tr data-id="${esc(s.id)}" tabindex="0"><th scope="row"><span class="nmcell"><span class="lamp" data-total="${sc.total ?? ''}" data-gated="${sc.gated}"></span><a class="nm" href="${link(`/mera/?id=${encodeURIComponent(s.id)}`, species)}" title="${esc(s.name)}">${esc(s.name)}</a>${outside(s) ? ' <span class="badge" title="Bursa ili dışında, yakın çevre">Bursa dışı</span>' : ''}</span></th><td>${esc(KIND_TR[s.kind] ?? s.kind)}</td><td class="num">${score}</td><td class="num">${best}</td><td><span class="badge acc acc-${acc === 'Açık' ? 'ok' : 'warn'}" title="${esc(accLong)}" tabindex="0">${acc}</span></td>${showTrust ? `<td>${tl ? `<b class="trust" data-l="${tl}">${tl}</b>` : '–'}</td>` : ''}</tr>`;
  }
  function sortSpots(list: Spot[]): Spot[] {
    const k = tblSort.key, d = tblSort.dir;
    const val = (s: Spot) => (k === 'score' ? (s.score.total ?? -1) : k === 'best' ? (bestHour(s.id)?.v ?? -1) : 0);
    return [...list].sort((a, b) => (k === 'name' ? d * a.name.localeCompare(b.name, 'tr') : d * (val(a) - val(b))) || (a.score.rank ?? 1e9) - (b.score.rank ?? 1e9));
  }
  function render() {
    const spots = all.filter((s) => !hidden(s));
    const at = atIso();
    $('meta').textContent = `${spots.length}${spots.length !== all.length ? ` / ${all.length}` : ''} mera, ${at ? `${fmtDay(at)} ${fmtTime(at)} için sıra` : 'şu anki sıra'}. ${fmtAgo(fetched)}.`;
    $('empty').hidden = spots.length > 0;
    if (!spots.length) $('empty').textContent = all.length ? 'Filtreye uyan mera yok.' : 'Henüz mera yok.';
    const ties = tieCounts(all.map((s) => s.score.rank));
    const row = (s: Spot) => {
      const sc = s.score;
      const sub = [KIND_TR[s.kind] ?? s.kind, s.place, s.status === 'verified' ? 'sahada doğrulandı' : 'doğrulanmadı'].filter(Boolean).join(', ');
      const band = sc.p10 !== null && sc.p90 !== null ? ` · bant ${Math.round(sc.p10)}–${Math.round(sc.p90)}` : '';
      const why = sc.gated
        ? `<p class="why warn">${esc(sc.warnings[0])}</p>`
        : sc.total === null || sc.rank === null
          ? '<p class="why">Puan henüz hesaplanmadı</p>'
          : `<p class="why"><b class="rk">${rankLabel(sc.rank, ties.get(sc.rank) ?? 1)}</b> / ${all.length}${band}${leadWithRank(sc.p10, sc.p90) ? ' · belirsizlik geniş' : ''}${s.lamp_known ? '' : ' · iskele aydınlatması bilinmiyor'}</p>`;
      const legal = swimRule(s.kind, at ?? new Date().toISOString());
      const badges = (sc.gated ? '<span class="badge storm" title="Puan güvenlik tavanında (rüzgar ya da dalga eşiği aşıldı)">güvenlik</span>' : '') + (s.private_marina ? `<span class="badge warn">${MARINA_BADGE}</span>` : s.access && ACCESS_BADGE[s.access] ? `<span class="badge warn">${ACCESS_BADGE[s.access]}</span>` : '') + (legal ? `<span class="badge legal">${legal}</span>` : '') + (s.auto_added ? '<span class="badge assume" title="otomatik eklendi — sahada doğrulanmadı">otomatik</span>' : '') + (outside(s) ? '<span class="badge" title="Bursa ili dışında, yakın çevre">Bursa dışı</span>' : '');
      return `<li><a class="spot" href="${link(`/mera/?id=${encodeURIComponent(s.id)}`, species)}" data-id="${esc(s.id)}">
          <span class="lamp" data-total="${sc.total ?? ''}" data-gated="${sc.gated}"></span>
          <span><h3>${esc(s.name)}${badges}</h3><p class="sub">${esc(sub)}</p>${why}${sc.reason ? `<p class="reason">${esc(sc.reason)}</p>` : ''}</span></a></li>`;
    };
    const section = (list: Spot[], prefix: string) =>
      groupSame(list, (s) => (s.score.gated || s.score.total === null ? null : `${s.score.total}|${s.score.p10}|${s.score.p90}`))
        .map((x) => {
          if (!isGroup(x)) return row(x);
          const key = `${prefix}:${x.sig}`;
          const open = openGroups.has(key);
          const sc = x.group[0]!.score;
          const band = sc.p10 !== null && sc.p90 !== null ? `, bant ${Math.round(sc.p10)}–${Math.round(sc.p90)}` : '';
          const head = `<li class="grp"><button type="button" class="grp-btn" data-grp="${esc(key)}" aria-expanded="${open}"><span class="lamp" data-total="${sc.total ?? ''}" data-gated="false"></span><span>${sameLabel(x.group.map((g) => g.kind), x.group.length)} (${Math.round(sc.total!)}${band}) — ${open ? 'daralt' : 'genişlet'}</span></button></li>`;
          return head + (open ? x.group.map(row).join('') : '');
        })
        .join('');
    const { main, beaches } = splitBeaches(spots);
    const best = beaches.reduce<number | null>((m, s) => (s.score.total !== null && (m === null || s.score.total > m) ? s.score.total : m), null);
    // O5: wide screens get a table (name, kind, score, best hour, access, trust) instead of one narrow column
    const tbl = $('spot-table');
    tbl.hidden = !tableMq.matches;
    $('spots').hidden = tableMq.matches;
    if (tableMq.matches) {
      // P0: trust column only when it carries information (more than one level among the rows)
      const levels = new Set(spots.map(tableTrust).filter(Boolean));
      const showTrust = levels.size > 1;
      const one = levels.size === 1 ? [...levels][0] : null;
      const cols = showTrust ? 6 : 5;
      const rows = sortSpots(main).map((x) => tableRow(x, showTrust)).join('') +
        (beaches.length ? `<tr class="grp"><td colspan="${cols}"><button type="button" class="grp-btn" data-grp="beaches" aria-expanded="${beachesOpen}"><span class="lamp" data-total="${best ?? ''}" data-gated="false"></span><span>Kumsallar (${beaches.length})${best !== null ? ` — en iyi ${Math.round(best)}` : ''} · ${beachesOpen ? 'daralt' : 'genişlet'}</span></button></td></tr>` + (beachesOpen ? sortSpots(beaches).map((x) => tableRow(x, showTrust)).join('') : '') : '');
      const hIso = new Date((nowHour + sel) * HOUR).toISOString();
      const sortTh = (key: SortKey, label: string, cls = '') => {
        const on = tblSort.key === key;
        return `<th scope="col" class="${cls}" aria-sort="${on ? (tblSort.dir === 1 ? 'ascending' : 'descending') : 'none'}"><button type="button" class="th-sort" data-sort="${key}">${label}${on ? (tblSort.dir === 1 ? ' ▲' : ' ▼') : ''}</button></th>`;
      };
      tbl.innerHTML = `${one ? `<p class="tbl-note">Tüm meralarda güven ${one.toLocaleLowerCase('tr')}: ${one === 'Düşük' ? 'öne çıkaranlar çoğunlukla varsayım ve model sahada henüz doğrulanmadı.' : 'model sahada henüz doğrulanmadı.'}</p>` : ''}<table class="spot-table"><thead><tr>${sortTh('name', 'Mera', 'c-name')}<th scope="col" class="c-kind">Tip</th>${sortTh('score', `Puan (${dayWordShort(hIso)} ${fmtTime(hIso)})`, 'c-score')}${sortTh('best', 'En iyi saat (72 sa)', 'c-best')}<th scope="col" class="c-acc">Erişim</th>${showTrust ? '<th scope="col" class="c-trust">Güven</th>' : ''}</tr></thead><tbody>${rows}</tbody></table>`;
      tbl.querySelectorAll<HTMLElement>('.lamp').forEach((el) => lampV2(el, el.dataset.total === '' ? null : Number(el.dataset.total), el.dataset.gated === 'true'));
      tbl.querySelectorAll<HTMLButtonElement>('[data-grp]').forEach((b) => b.addEventListener('click', () => toggleGroup(b.dataset.grp!)));
      tbl.querySelectorAll<HTMLButtonElement>('.th-sort').forEach((b) => b.addEventListener('click', () => {
        const k = b.dataset.sort as SortKey;
        tblSort = tblSort.key === k ? { key: k, dir: tblSort.dir === 1 ? -1 : 1 } : { key: k, dir: k === 'name' ? 1 : -1 };
        render();
      }));
      tbl.querySelectorAll<HTMLTableRowElement>('tr[data-id]').forEach((tr) => tr.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('.acc')) return; e.preventDefault(); openSpot(tr.dataset.id!); }));
      return;
    }
    $('spots').innerHTML =
      section(main, 'm') +
      (beaches.length
        ? `<li class="grp beach"><button type="button" class="grp-btn" data-grp="beaches" aria-expanded="${beachesOpen}"><span class="lamp" data-total="${best ?? ''}" data-gated="false"></span><span>Kumsallar (${beaches.length})${best !== null ? ` — en iyi ${Math.round(best)}` : ''} · ${beachesOpen ? 'daralt' : 'genişlet'}</span></button></li>` +
          (beachesOpen ? section(beaches, 'b') : '')
        : '');
    $('spots').querySelectorAll<HTMLElement>('.lamp').forEach((el) => lampV2(el, el.dataset.total === '' ? null : Number(el.dataset.total), el.dataset.gated === 'true'));
    $('spots').querySelectorAll<HTMLButtonElement>('[data-grp]').forEach((b) => b.addEventListener('click', () => toggleGroup(b.dataset.grp!)));
    $('spots').querySelectorAll<HTMLAnchorElement>('a.spot').forEach((a) => a.addEventListener('click', (e) => {
      if (!wide.matches) return;
      e.preventDefault();
      openSpot(a.dataset.id!);
    }));
  }
  /** N5: freshness line on the plan card; past 2 h a prominent warning on top of the card (same rule as the banner). */
  function showFresh(scoredAt: string | null, fetchedAt: string | null, run: WeatherRunInfo | null) {
    const f = freshness(scoredAt, fetchedAt, Date.now(), run);
    $('fresh').textContent = f.line;
    $('fresh').dataset.stale = f.stale ? f.short! : '';
    const warn = $('stale-card');
    warn.hidden = !f.stale;
    warn.innerHTML = f.stale ? `<span class="long">${esc(f.banner!)}</span><span class="short">${esc(f.short!)}</span>` : '';
  }
  // N3: trust stays at most "Orta" until the forward calibration has passed (GET /api/trust-gate)
  const calibrated: Partial<Record<Species, boolean>> = {};
  const gates: Partial<Record<Species, { passed: boolean; n: number; min: number }>> = {}; // V1.2: catch verification row
  const loadGate = (sp: Species) => {
    if (sp in calibrated) return Promise.resolve();
    calibrated[sp] = false;
    return preFetch(api('/api/trust-gate', sp)).then((r) => (r.ok ? r.json() : null)).then((b: { passed?: boolean; n?: number; min?: number } | null) => {
      calibrated[sp] = b?.passed === true;
      if (b) gates[sp] = { passed: b.passed === true, n: b.n ?? 0, min: b.min ?? 0 };
      if (cardWin) renderPlan();
    }).catch(() => {});
  };
  loadGate(species);
  let seq = 0;
  function load() {
    const my = ++seq;
    const at = atIso();
    preFetch(api(`/api/spots${at ? `?at=${encodeURIComponent(at)}` : ''}`, species), { cache: 'no-cache' })
      .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
      .then((b: { spots: Spot[]; data_fetched_at: string | null; scored_at?: string | null; weather_run?: WeatherRunInfo | null }) => {
        if (my !== seq) return;
        const first = all.length === 0;
        all = b.spots;
        fetched = b.data_fetched_at;
        if (!at) showFresh(b.scored_at ?? null, b.data_fetched_at, b.weather_run ?? null);
        render();
        heat();
        summary();
        if (first) renderPlan(); // the plan's province filter needs the spot list
      })
      .catch(() => { if (my === seq) $('meta').textContent = 'Puanlar alınamadı. Bağlantınızı kontrol edip sayfayı yenileyin.'; });
  }

  // ---------------------------------------------------------------- heat map (F5: view, uncertainty toggle, summary)
  const HM = 'av-livn-heat';
  let hmMode: 'score' | 'diff' = 'score';
  let focus: string | null = null; // spot of the summary under the map; null = top spot at the selected hour
  const unc = $<HTMLInputElement>('hm-unc');
  try {
    const st = JSON.parse(localStorage.getItem(HM) ?? '{}') as { mode?: 'score' | 'diff'; unc?: boolean };
    if (st.mode === 'diff') hmMode = 'diff';
    unc.checked = !!st.unc;
  } catch {}
  const saveHm = () => { try { localStorage.setItem(HM, JSON.stringify({ mode: hmMode, unc: unc.checked })); } catch {} };
  document.querySelectorAll<HTMLButtonElement>('.seg-sm button').forEach((b) => {
    b.setAttribute('aria-checked', String(b.dataset.mode === hmMode));
    b.addEventListener('click', () => {
      hmMode = b.dataset.mode as 'score' | 'diff';
      document.querySelectorAll<HTMLButtonElement>('.seg-sm button').forEach((x) => x.setAttribute('aria-checked', String(x === b)));
      saveHm();
      heat();
    });
  });
  unc.addEventListener('change', () => { saveHm(); heat(); });

  function heat() {
    if (!hours) return;
    const el = $('heat');
    if (!el.clientWidth) return; // hidden tab; rendered when shown
    const st = renderHeatmap(el, hours, {
      selected: sel,
      mode: hmMode,
      showUncertainty: unc.checked,
      focus: focusId(),
      onGroup: toggleGroup,
      compose: (rows: HourSpot[]): HeatRow[] => {
        const same = (list: HourSpot[], prefix: string): HeatRow[] =>
          groupSame(list, (s) => JSON.stringify([s.t, s.w, s.g])).flatMap((x) => {
            if (!isGroup(x)) return [x];
            const key = `h${prefix}:${x.group.map((g) => g.id).sort().join(',')}`;
            const open = openGroups.has(key);
            const head: HeatRow = { ...x.group[0]!, name: `${sameLabel(x.group.map((g) => g.kind), x.group.length)} — ${open ? 'daralt' : 'genişlet'}`, group: { key, ids: x.group.map((g) => g.id), open } };
            return open ? [head, ...x.group] : [head];
          });
        const { main, beaches } = splitBeaches(rows);
        if (!beaches.length) return same(main, 'm');
        const head: HeatRow = {
          ...beaches[0]!, name: `Kumsallar (${beaches.length}) — ${beachesOpen ? 'daralt' : 'genişlet'}`,
          t: columnMax(beaches.map((b) => b.t), hours!.hours), w: beaches[0]!.t.map(() => null), g: [],
          group: { key: 'beaches', ids: beaches.map((b) => b.id), open: beachesOpen },
        };
        return [...same(main, 'm'), head, ...(beachesOpen ? same(beaches, 'b') : [])];
      },
      hide: (s) => hidden(s),
      badges: (s: HourSpot) => {
        const a = s.access && s.access !== 'acik' ? `<tspan class="hm-b" dx="6">▲</tspan>` : '';
        const l = swimRule(s.kind, new Date((nowHour + sel) * HOUR)) ? `<tspan class="hm-b legal" dx="4">●</tspan>` : '';
        return a + l;
      },
      onCell: (id, col) => {
        focus = id;
        if (col !== sel) setCol(col, 'heat');
        else { heat(); summary(); }
        openSpot(id, col);
      },
    });
    const sky = 'üst şerit: gece / alacakaranlık / gündüz';
    const band = st.meanBand === null ? '' : ` · ortalama bant genişliği ${Math.round(st.meanBand)} puan`;
    const scale = hmMode === 'diff'
      ? `<span class="divramp" aria-hidden="true"></span> saat ortalamasının altında ← → üstünde (±${st.diffMax} puanda doyar)`
      : '<span class="ramp" aria-hidden="true"></span> düşük → yüksek puan · <span class="gatesw" aria-hidden="true"></span> güvenlik saati (rüzgar ya da dalga eşiği; puan tavanda)';
    const hatch = unc.checked && st.wideFrom !== null ? ` · <span class="hatchsw" aria-hidden="true"></span> bandı en geniş üçte bir (> ${Math.round(st.wideFrom)} puan)` : '';
    $('hm-legend').innerHTML = `${scale}${hatch}${band} · ${sky}`;
  }

  /** Focused spot: the clicked one if still visible, else the best at the selected hour. */
  function focusId(): string | null {
    const vis = all.filter((s) => !hidden(s));
    if (focus && vis.some((s) => s.id === focus)) return focus;
    return [...vis].filter((s) => s.score.total !== null).sort((a, b) => (a.score.rank ?? 1e9) - (b.score.rank ?? 1e9))[0]?.id ?? null;
  }

  // M2: generic classes unless this device has its own set (Ayarlar → Takımım); nothing personal comes from the server
  const myTk = toProfiles(loadMy());
  type Detail = { from: number; packed: { tk?: (number | null)[][] } | null; field?: { kinds: { lamba: string | null; derinlik: string | null; yapi: string | null; taban: string | null } } | null };
  const details = new Map<string, Promise<Detail | null>>();
  const detailCache = new Map<string, Detail | null>(); // resolved details, for synchronous redraws (timeline)
  const detail = (id: string) => {
    if (!details.has(id)) details.set(id, preFetch(api(`/api/spots/${encodeURIComponent(id)}?model=v2`, species)).then((r) => (r.ok ? r.json() : null)).catch(() => null).then((d: Detail | null) => { detailCache.set(id, d); return d; }));
    return details.get(id)!;
  };
  let sumSeq = 0;
  /** F5: the empty area under the heat map holds the focused spot's summary and the short tackle line. */
  async function summary() {
    const box = $('heat-sum');
    const id = focusId();
    const s = all.find((x) => x.id === id);
    if (!s) { box.hidden = true; return; }
    const my = ++sumSeq;
    const sc = s.score;
    const at = atIso() ?? new Date().toISOString();
    const legal = swimRule(s.kind, at);
    const badges = [
      s.private_marina ? `<span class="badge warn">${MARINA_BADGE}</span>` : s.access && ACCESS_BADGE[s.access] ? `<span class="badge warn">${ACCESS_BADGE[s.access]}</span>` : '',
      legal ? `<span class="badge legal">${legal}</span>` : '',
      s.auto_added ? '<span class="badge assume">otomatik eklendi — sahada doğrulanmadı</span>' : '',
      sc.gated ? '<span class="badge storm">güvenlik</span>' : '',
    ].join('');
    const band = sc.p10 !== null && sc.p90 !== null ? `bant ${Math.round(sc.p10)}–${Math.round(sc.p90)}` : 'bant yok';
    const head = `<h3><span class="big">${sc.total === null ? '–' : Math.round(sc.total)}</span> ${esc(s.name)}</h3>
      <p>${sc.gated ? esc(sc.warnings[0] ?? 'güvenlik uyarısı') : `${sc.rank === null ? '–' : rankLabel(sc.rank, tieCounts(all.map((x) => x.score.rank)).get(sc.rank) ?? 1)} / ${all.length} · ${band}`} · ${at === atIso() ? `${fmtDay(at)} ${fmtTime(at)}` : 'şimdi'}</p>
      ${sc.reason ? `<p>${esc(sc.reason)}</p>` : ''}${badges ? `<p>${badges}</p>` : ''}`;
    box.innerHTML = `${head}<p class="tk" id="sum-tk">Takım: hesaplanıyor…</p><p><a class="link" href="${link(`/mera/?id=${encodeURIComponent(s.id)}`, species)}">Mera kartı ve takım kutusu →</a></p>`;
    box.hidden = false;
    const d = await detail(s.id);
    if (my !== sumSeq) return;
    const v = d?.packed?.tk?.[d.from + sel];
    const tkEl = document.getElementById('sum-tk');
    if (!tkEl) return;
    if (!v || sc.gated) { tkEl.textContent = sc.gated ? 'Takım: güvenlik uyarısı varken öneri yok.' : 'Takım: veri yok.'; return; }
    const input = { depthM: v[0] ?? 3, currentMs: v[1] ?? null, windKmh: v[2] ?? null, gustKmh: v[3] ?? null, crossKmh: v[4] ?? null, sunAlt: v[5] ?? 0, lampP: v[6] ?? null, turbidity: v[7] ?? null, sstDev: v[8] ?? null, waveM: v[9] ?? null, kind: s.kind };
    const short = species === 'levrek' ? tackleLevrekLine(tackleLevrek(input, myTk.profiles)) : tackleLine(tackle(input, myTk.profiles));
    tkEl.innerHTML = `Takım (${SPECIES_TR[species]}): <b>${esc(short)}</b> · yasal asgari boy ${LEGAL_MIN[species]} cm`;
  }
  const loadHours = () =>
    fetch(api('/api/hours', species), { cache: 'no-cache' })
      .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
      .then((b: HoursData) => { hours = b; heat(); if (cardWin) renderPlan(); render(); })
      .catch(() => { $('heat').innerHTML = '<p class="muted fs-2">Isı haritası alınamadı.</p>'; });
  loadHours();
  let rz = 0;
  addEventListener('resize', () => { cancelAnimationFrame(rz); rz = requestAnimationFrame(heat); });

  // ---------------------------------------------------------------- best windows (E3)
  type WinList = { windows: Win[]; threshold: number; strong?: number };
  type PlanSet = { all: WinList; open: WinList; today: { all: WinList; open: WinList } };
  let winBody: (WinList & { open?: WinList; today?: { all: WinList; open: WinList; hours: number }; plan?: { bursa: PlanSet; wide: PlanSet } }) | null = null;
  /** I2: the access filter applies to windows too (server computes the open-access list separately). */
  function renderWindows() {
    const ol = $('windows');
    if (!winBody) return;
    const b = box.checked && winBody.open ? winBody.open : winBody;
    // bodies stored before I2 (until the next hourly run) have no tiers: derive them the old way
    for (const w of b.windows) w.tier ??= w.total >= 65 ? 'guclu' : 'goreli';
    b.strong ??= b.windows.filter((w) => w.tier === 'guclu').length;
    if (!b.windows.length) { ol.innerHTML = '<li class="muted">72 saat içinde öne çıkan pencere yok.</li>'; $('win-note').textContent = ''; return; }
    const head = b.strong ? '' : '<li class="muted win-none"><b>Bu aralıkta güçlü öneri yok.</b> Aşağıdakiler mevcut seçenekler içinde görece en iyiler; gitmek için güçlü bir gerekçe değil.</li>';
    ol.innerHTML = head + b.windows
      .map((w) => {
        const end = new Date(Date.parse(w.end)).toISOString();
        const band = w.p10 !== null && w.p90 !== null ? ` · bant ${Math.round(w.p10)}–${Math.round(w.p90)}` : '';
        const col = Math.floor(Date.parse(w.peak) / HOUR) - nowHour;
        const tier = w.tier === 'guclu' ? '<span class="badge good">güçlü</span>' : '<span class="badge assume">görece</span>';
        return `<li class="card win">
          <span class="t">${esc(fmtDay(w.start))} ${fmtTime(w.start)}–${fmtTime(end)}</span>
          <span class="s">${Math.round(w.total)}<small>${w.rank}. sıra</small></span>
          <span class="n">${esc(w.name)} ${tier}</span>
          <span class="r">En iyi saat ${fmtTime(w.peak)}${band}.${w.why ? ` ${esc(w.why)}.` : ''} ${w.assumed ? '<span class="badge assume">varsayıma dayanıyor</span>' : ''}${w.missing ? ` <span class="badge warn">${esc(w.missing)}</span>` : ''}</span>
          <span class="actions"><button type="button" class="btn small" data-open="${esc(w.spot_id)}" data-c="${col}">Merayı aç</button><button type="button" class="btn small secondary" data-c="${col}">Bu saate göre sırala</button></span>
        </li>`;
      })
      .join('');
    ol.querySelectorAll<HTMLButtonElement>('button').forEach((btn) => btn.addEventListener('click', () => {
      const c = Number(btn.dataset.c);
      if (btn.dataset.open) openSpot(btn.dataset.open, c);
      else setCol(c);
    }));
    $('win-note').textContent = b.threshold < 65
      ? `72 saatte 65'i geçen saat az; en yüksek %15'lik dilim (≥ ${Math.round(b.threshold)}) gösteriliyor.`
      : 'Güçlü: zirve ≥ 65 ve veri tam. Pencere: zirve saatin çevresinde puanın 65 ve zirve − 8\'in üstünde kaldığı en çok 4 saat; mera başına bir pencere.';
  }

  // ---------------------------------------------------------------- M1: the plan card (five questions, plain words)
  const ACCESS_TR: Record<string, string> = { kisitli_feribot: 'erişim kısıtlı olabilir (feribot)', belirsiz: 'erişim belirsiz' };
  let planSeq = 0;
  let eqSel = 0;
  let eqKey = '';
  const qa = (cls: string, on: boolean) => { pick.querySelector<HTMLElement>(cls)!.hidden = !on; };
  const pick = $('pick');
  async function renderPlan() {
    const myN = ++planSeq;
    if (!winBody || !all.length) return; // drawn again when both the windows and the spot list are in
    // J3: Ayarlar → "Ana öneriye Bursa dışını da dahil et" (this device; default off)
    let withOutside = false;
    try { withOutside = localStorage.getItem('av-livn-outside-bursa') === '1'; } catch {}
    // K1: private yacht marinas are never the plan's pick (listed with their badge)
    const isMarina = (w: Win) => !!all.find((x) => x.id === w.spot_id)?.private_marina;
    const inBursa = (w: Win) => !isMarina(w) && (withOutside || !outside(all.find((x) => x.id === w.spot_id) ?? {}));
    // L: server-side plan candidates (marinas and outside spots removed before the top 5 is cut)
    const P = winBody.plan?.[withOutside ? 'wide' : 'bursa'];
    const b = P ? (box.checked ? P.open : P.all) : box.checked && winBody.open ? winBody.open : winBody;
    const ws = b.windows.filter(inBursa);
    const alts = $('alts');
    const eqNote = $('eq-note');
    const eqPick = $('eq-pick');
    if (!ws.length) {
      $('verdict').textContent = 'Öneri yok';
      $('verdict-sub').textContent = '72 saatte öneri yok: koşullar uygun değil ya da rüzgar/dalga verisi eksik (güvenlik denetlenemiyor). Güvenlik uyarıları "Tüm meralar" sekmesinde.';
      for (const c of ['.q2', '.q3', '.q4', '.q5', '.why-more', '.go']) qa(c, false);
      planReady();
      $('alts-box').hidden = true; $('strip-card').hidden = true; $('rig-card').hidden = true; eqNote.hidden = true; eqPick.hidden = true;
      return;
    }
    // I9 + K3: one shared rule (planPick) for the card and the early detail request
    const td = (P ? (box.checked ? P.today.open : P.today.all).windows : winBody.today ? (box.checked ? winBody.today.open : winBody.today.all).windows : []).filter(inBursa);
    const { m, todayStrong, nextStrong, eqList, rest } = planPick(td, ws)!;
    const key = eqList.map((w) => w.spot_id).join('|');
    if (key !== eqKey) { eqKey = key; eqSel = 0; }
    const cur = eqList[Math.min(eqSel, eqList.length - 1)]!;

    // 1) worth going today? V1.2: the wording follows the trust of the shown option, never an unconditional "Evet"
    const curTr = trust(cur, { calibrated: calibrated[species] === true, weather: agreementAt(all.find((x) => x.id === cur.spot_id), colOf(cur))?.split ?? null });
    $('verdict').textContent = verdictText({ todayStrong: !!todayStrong, nextStrong: !!nextStrong, trust: curTr.level });
    $('verdict-sub').textContent = todayStrong
      ? `${eqList.length > 1 ? 'Bugün birkaç yer benzer görünüyor' : `${span(m)} arası`}; ${trustTail(curTr.level)}.`
      : nextStrong
      ? `Bugün güçlü bir zaman yok. En yakın iyi zaman: ${span(m)}.`
      : '72 saatte güçlü bir zaman yok. Aşağıdaki, mevcut seçeneklerin görece en iyisi; gitmek için güçlü bir gerekçe değil.';
    // equivalent options: no "best" is declared; the visitor picks one, the card answers for it
    eqNote.hidden = eqPick.hidden = eqList.length < 2;
    if (eqList.length >= 2) {
      eqNote.textContent = equalText(eqList.length);
      eqPick.innerHTML = eqList.map((w, i) => `<button type="button" role="radio" aria-checked="${i === eqSel}" data-i="${i}">${esc(w.name)}</button>`).join('');
      eqPick.querySelectorAll<HTMLButtonElement>('button').forEach((x) => x.addEventListener('click', () => {
        eqSel = Number(x.dataset.i);
        cardCol = null;
        renderPlan();
        mapApi?.focus(eqList[eqSel]!.spot_id); // O1: choosing an option goes to it on the map
      }));
    }
    // V1.4: equivalent options as a table — no ranking; access (unknown is not "open"), coast type, wind vs this
    // shore at the selected hour, and what the spot's data rests on
    const seen = new Set<string>();
    const rows = [cur, ...eqList, ...rest].filter((w) => !seen.has(w.spot_id) && seen.add(w.spot_id)).slice(0, 5);
    alts.innerHTML = rows.map((w) => {
      const sp = all.find((x) => x.id === w.spot_id);
      const acc = sp?.private_marina ? ['erisim-kisitli', 'kısıtlı · marina', true] as const
        : w.access === 'acik' || sp?.access === 'acik' ? ['erisim-acik', 'açık', false] as const
        : (w.access ?? sp?.access) === 'kisitli_feribot' ? ['erisim-kisitli', 'kısıtlı · feribot', true] as const
        : ['erisim-bilinmiyor', 'bilinmiyor', true] as const; // unknown access is never shown as open
      const rel = windRel((sp as { shore_normal_deg?: number | null } | undefined)?.shore_normal_deg, gridAt(wxGrid, 'wd', sp, nowHour + sel));
      const ls = (sp as { lamp_state?: string } | undefined)?.lamp_state;
      const data = ls === 'dogrulandi' || ls === 'yok' ? 'saha bilgisi var' : ls === 'goruldu' ? 'fotoğraftan' : 'çoğu tahmin';
      const k = fitStep(w.total);
      return `<li><button type="button" class="alt-b${w.spot_id === cur.spot_id ? ' sel' : ''}" data-open="${esc(w.spot_id)}" data-c="${colOf(w)}" title="${esc(w.name)} · ${span(w)}${acc[0] === 'erisim-bilinmiyor' ? ' · erişim bilinmiyor: açık sayılmaz' : ''}">`
        + `<span>${icon(kindIcon(sp?.kind), { size: 16 })}<span class="a-n">${esc(w.name)}</span></span>`
        + `<span><b class="fitpill f${k}">${Math.round(w.total)}</b></span>`
        + `<span class="${acc[2] ? 'w' : ''}">${icon(acc[0], { size: 16 })}${acc[1]}</span>`
        + `<span>${icon('ruzgar', { size: 16 })}${rel ?? '–'}</span>`
        + `<span>${data}</span></button></li>`;
    }).join('');
    $('alts-box').hidden = rows.length < 2;
    alts.querySelectorAll<HTMLButtonElement>('button').forEach((x) => x.addEventListener('click', () => openSpot(x.dataset.open!, Number(x.dataset.c))));
    await fillCard(cur, myN, eqList.length, withOutside);
  }
  const span = (w: Win) => {
    const d = fmtDay(w.start);
    return `${d === fmtDay(new Date().toISOString()) ? 'Bugün' : d} ${fmtTime(w.start)}–${fmtTime(new Date(Date.parse(w.end)).toISOString())}`;
  };
  const colOf = (w: Win) => Math.floor(Date.parse(w.peak) / HOUR) - nowHour;
  const PROV_TR: Record<string, string> = { yalova: 'Yalova', balikesir: 'Balıkesir' };

  /** Questions 2–5 for one window; the tackle line and the weather sentence need the spot's hourly inputs. */
  /** O4: hour of the card (null = the window's best hour); set by the 24 h strip. */
  let cardCol: number | null = null;
  let cardWin: Win | null = null;
  async function fillCard(w: Win, myN: number, nEq: number, withOutside: boolean) {
    const s = all.find((x) => x.id === w.spot_id);
    if (cardWin?.spot_id !== w.spot_id || cardWin?.start !== w.start) cardCol = null;
    const first = cardWin === null;
    cardWin = w;
    const col = cardCol ?? colOf(w);
    // O3: the map and the list follow the plan's hour (the time bar says so and offers "şimdiye dön")
    // the first card opens on the plan's best hour, unless the page was opened on a given hour (?t=)
    if (first && hourStore.get().source !== 'url' && sel !== col) setCol(col, 'plan');
    const prov = s?.province && s.province !== 'bursa' ? PROV_TR[s.province] ?? s.province : null;
    // 2) where, when
    $('a-where').textContent = w.name;
    // P3: the map page opens its 72 h slider at the plan's suggested hour, centred on the spot
    $<HTMLAnchorElement>('a-maplink').href = `/harita/?id=${encodeURIComponent(w.spot_id)}&t=${encodeURIComponent(new Date(w.peak).toISOString())}`;
    $<HTMLAnchorElement>('m-map').href = `/harita/?id=${encodeURIComponent(w.spot_id)}&t=${encodeURIComponent(new Date((nowHour + col) * HOUR).toISOString())}`;
    $('a-when').textContent = [span(w), `en iyi saat ${fmtTime(w.peak)}`, prov, w.access && w.access !== 'acik' ? ACCESS_TR[w.access] ?? 'erişim belirsiz' : null].filter(Boolean).join(' · ');
    // 4) why (plain); 5) trust (L1 rule)
    const why = $('a-why');
    const lead = driverSentence(w.why);
    why.innerHTML = lead ? `<li>${esc(lead)}</li>` : '';
    // P2: weather-model agreement at the card's hour (Actions builds the spread hourly; nearest spot cell)
    const ag = agreementAt(s, col);
    const tr = trust(w, { calibrated: calibrated[species] === true, weather: ag?.split ?? null });
    $('a-models').hidden = !ag;
    $('a-models').textContent = ag ? `${ag.text}.` : '';
    $('a-trust').textContent = tr.level;
    $('a-trust').dataset.l = tr.level;
    $('a-trust-sub').textContent = tr.text;
    renderTrust3(weatherTrust(ag), spotKnowledge(null, (s as { lamp_state?: string } | undefined)?.lamp_state), catchTrust(gates[species] ?? null));
    for (const c of ['.q2', '.q3', '.q4', '.q5', '.why-more', '.go']) qa(c, true);
    $('pick-open').onclick = () => openSpot(w.spot_id, colOf(w));
    $<HTMLAnchorElement>('pick-field').href = link(`/sahadayim/?id=${encodeURIComponent(w.spot_id)}`, species);
    pickId = w.spot_id;
    mapApi?.highlight(w.spot_id);
    drawStrip(w, col);
    // technical detail under "Neden?"
    const band = w.p10 !== null && w.p90 !== null ? `${Math.round(w.p10)}–${Math.round(w.p90)}` : 'yok';
    const tech = [
      w.reason ? `Modelin gerekçesi: ${esc(w.reason)}` : null,
      `Puan ${Math.round(w.total)} (bant ${band}) · ${w.tier === 'guclu' ? 'güçlü' : 'görece'} pencere${w.top3 != null ? ` · ilk 3'te kalma payı %${Math.round(w.top3 * 100)}` : ''}${w.missing ? ` · ${esc(w.missing)}` : ''}`,
      modelsDetail(s, col),
      nEq > 1 ? `Eşdeğer gösterim: ilk 3'te kalma payı %60'ın altında ve bantlar örtüşüyor; seçenekler ada göre sıralı, en iyi ilan edilmez (MODEL.md §16).` : null,
      `Kapsam: ${SPECIES_TR[species]}, ${withOutside ? 'Bursa ve yakın çevre' : 'Bursa kıyısı'}, ${box.checked ? 'erişimi açık meralar' : 'tüm meralar'}.`,
    ].filter(Boolean).map((x) => `<li>${x}</li>`).join('');
    $('why-detail').innerHTML = `<ul>${tech}</ul><ul id="tk-why"></ul>`;
    // 3) tackle, weather and light at the best hour
    const d = await detail(w.spot_id);
    if (myN !== planSeq) return;
    condLine(s, d, col);
    drawStrip(w, col); // now with wind, gust, wave and light from the spot's hourly inputs
    // V1.2: spot knowledge from the detail's evidence kinds (field / remote / none)
    renderTrust3(weatherTrust(ag), spotKnowledge(d?.field?.kinds, (s as { lamp_state?: string } | undefined)?.lamp_state), catchTrust(gates[species] ?? null));
    const v = d?.packed?.tk?.[d.from + col];
    nowLine(w, d);
    if (!v) {
      planReady();
      $('a-tackle').textContent = 'Bu saatin girdileri yok; takım için mera kartına bakın.';
      $('a-tackle-sub').textContent = '';
      $('rig-card').hidden = true;
      return;
    }
    const input = { depthM: v[0] ?? 3, currentMs: v[1] ?? null, windKmh: v[2] ?? null, gustKmh: v[3] ?? null, crossKmh: v[4] ?? null, sunAlt: v[5] ?? 0, lampP: v[6] ?? null, turbidity: v[7] ?? null, sstDev: v[8] ?? null, waveM: v[9] ?? null, kind: s?.kind };
    const t = species === 'levrek' ? tackleLevrek(input, myTk.profiles) : tackle(input, myTk.profiles);
    const line = species === 'levrek' ? tackleLevrekLine(t as ReturnType<typeof tackleLevrek>) : tackleLine(t as ReturnType<typeof tackle>);
    const g = species === 'levrek' ? (t as ReturnType<typeof tackleLevrek>).weightG : (t as ReturnType<typeof tackle>).jigG;
    $('a-tackle').textContent = personalLine(line, t.profile, myTk.personal);
    const own = myTk.personal[t.profile];
    // short under the line; the class's line sizes and the legal size are under "Neden?"
    $('a-tackle-sub').innerHTML = `<span class="tag ev-assumed">başlangıç önerisi</span> ${own ? 'Senin takımına göre' : 'Genel takım sınıfı'} · <a href="/ayarlar/#takimim">${own ? 'Takımım' : 'Kendi takımını gir'}</a>`;
    const cls = t.profile === 'lrf' ? TACKLE_CLASSES.lrf : tackleClass('spin', g);
    const tkHead = `<li><b>Takım sınıfı:</b> ${own ? `senin takımın (${esc(myTk.profiles.find((p) => p.id === t.profile)!.name)})` : `${esc(tackleClass(t.profile, g).label)}; ip ${esc(cls.line)}`}. Yasal asgari boy ${LEGAL_MIN[species]} cm (6/2 Tebliğ).</li>`;
    const colIso = new Date((nowHour + col) * HOUR).toISOString();
    why.innerHTML = [lead, weatherSentence(v[2] ?? null, v[3] ?? null, v[9] ?? null), lightSentence(v[5] ?? null, fmtTime(colIso))].filter(Boolean).slice(0, 3).map((x) => `<li>${esc(x!)}</li>`).join('');
    // the chosen hour differs from the window's best hour: say which hour the card describes
    if (col !== colOf(w)) {
      const hs = hourSpot(w.spot_id);
      const sc = hs ? hs.t[col + hoursOffset()] : null;
      $('a-when').textContent += ` · kart şu saate göre: ${fmtTime(colIso)}${sc != null ? ` (puan ${Math.round(sc)})` : ''}`;
    }
    drawRig(t, colIso, input);
    planReady();
    const tkWhy = document.getElementById('tk-why');
    if (tkWhy) tkWhy.innerHTML = tkHead + t.rows.map((r) => `<li><b>${esc(r.label)}: ${esc(r.value)}</b> — ${esc(r.why)} <span class="tag ev-${r.evidence}" title="Kanıt düzeyi">kanıt ${r.evidence}</span>${r.source ? `<br><span class="muted">Kaynak: ${esc(r.source)}</span>` : ''}</li>`).join('') + t.notes.map((n) => `<li class="muted">${esc(n)}</li>`).join('');
  }
  /** V1.2: weather forecast, spot knowledge and catch verification as three separate trusts. */
  function renderTrust3(...rows: TrustRow[]) {
    $('a-trust3').innerHTML = rows.map((r) => `<li data-l="${r.level ?? ''}"><span class="t3-k">${esc(r.label)}</span> <b class="trust" data-l="${r.level ?? ''}">${esc(r.value)}</b><span class="t3-d">${esc(r.text)}</span></li>`).join('');
  }
  // ---------------------------------------------------------------- P2: weather-model spread (MODEL.md §19)
  type SpreadCell = { id: string; lat: number; lon: number; w: ([number, number, number] | null)[]; g: ([number, number, number] | null)[]; d: (number | null)[]; m: Record<string, (number | null)[]> };
  let spreadDoc: { from_hour: number; models: string[]; cells: SpreadCell[] } | null = null;
  fetch('/api/grid/spread').then((r) => (r.ok ? r.json() : null)).then((b) => { if (b?.cells) { spreadDoc = b; if (cardWin) renderPlan(); } }).catch(() => {});
  const MODEL_TR: Record<string, string> = { icon_seamless: 'ICON (DWD)', ecmwf_ifs025: 'ECMWF IFS', gfs_seamless: 'GFS (NOAA)', meteofrance_seamless: 'ARPEGE (Météo-France)' };
  function spreadAt(s: Spot | undefined, col: number): { cell: SpreadCell; k: number } | null {
    if (!s || !spreadDoc) return null;
    const cell = spreadDoc.cells.reduce((b, c) => ((c.lat - s.lat) ** 2 + (c.lon - s.lon) ** 2 < (b.lat - s.lat) ** 2 + (b.lon - s.lon) ** 2 ? c : b));
    const k = nowHour + col - spreadDoc.from_hour;
    return k >= 0 && k < cell.w.length ? { cell, k } : null;
  }
  const agreementAt = (s: Spot | undefined, col: number) => { const a = spreadAt(s, col); return a ? modelAgreement(a.cell.w[a.k] ?? null, a.cell.g[a.k] ?? null) : null; };
  function modelsDetail(s: Spot | undefined, col: number): string | null {
    const a = spreadAt(s, col);
    if (!a) return 'Hava modelleri karşılaştırması: henüz yok.';
    const per = Object.entries(a.cell.m).map(([m, v]) => `${MODEL_TR[m] ?? m} ${v[a.k] == null ? '–' : Math.round(v[a.k]!)}`).join(', ');
    const g = a.cell.g[a.k], d = a.cell.d[a.k];
    return `Hava modelleri (rüzgar km/sa): ${per}${g ? `; hamle ${Math.round(g[0])}–${Math.round(g[1])}` : ''}${d != null ? `; yön farkı en çok ${d}°` : ''}. Bu yayılım puan bandına katılmaz (bant yalnız model parametrelerinin belirsizliği); güven düzeyini etkiler (MODEL.md §19).`;
  }

  // ---------------------------------------------------------------- O3/O4: strip, rig, now line
  const hoursOffset = () => (hours ? nowHour - Math.floor(Date.parse(hours.from) / HOUR) : 0);
  const hourSpot = (id: string) => hours?.spots.find((x) => x.id === id) ?? null;
  // ---------------------------------------------------------------- V1.3: av zaman çizelgesi (timeline.ts)
  let wxGrid: Grid | null = null; // /api/grid/wx (wind direction, rain), loaded after the plan card
  // when the grid arrives the card, the conditions line and the options table are redrawn (wind direction, rain)
  const wxReady = new Promise<Grid | null>((res) => whenPlanReady(() => loadGrid('wx').then((g) => { wxGrid = g; res(g); if (cardWin) renderPlan(); })));
  void wxReady;
  /** Grid value at a spot for an absolute hour (nearest sea cell; null outside the grid or the 72 h). */
  const gridAt = (g: Grid | null, v: string, s: { lat: number; lon: number } | undefined, hour: number): number | null => {
    if (!g || !s || !g.vars[v]) return null;
    const k = frameIndex(g, hour);
    return k === null ? null : nearest(g, g.vars[v]![k]!, s.lon, s.lat);
  };
  const tlLabels = () => timelineRows().map((r) => `<div class="tl-lab${r.h >= 30 ? ' main' : ''}" style="top:${r.top}px;height:${r.h}px">${r.icon ? icon(r.icon as Parameters<typeof icon>[0], { size: 14 }) : ''}<span>${r.label}</span></div>`).join('');
  function drawStrip(w: Win, col: number) {
    const hs = hourSpot(w.spot_id);
    const card = $('strip-card');
    if (!hs) { card.hidden = true; return; }
    const off = hoursOffset();
    const a = Math.floor(Date.parse(w.start) / HOUR) - nowHour;
    const b = Math.floor(Date.parse(w.end) / HOUR) - nowHour + 1;
    const s = all.find((x) => x.id === w.spot_id);
    const el = $('strip');
    const cols = [...Array(24).keys()];
    const d = detailCache.get(w.spot_id) ?? null;
    const tk = (c: number, i: number) => (d?.packed?.tk?.[d.from + c]?.[i] ?? null) as number | null;
    const grid = wxGrid;
    const width = Math.max(320, el.clientWidth || 640);
    el.innerHTML = timelineSvg({
      fromHour: nowHour, fit: hs.t.slice(off, off + 24), gated: hs.g.map((g) => g - off).filter((g) => g >= 0 && g < 24), window: [a, b], selected: col,
      lat: s?.lat, lon: s?.lon,
      ...(d ? { wind: cols.map((c) => tk(c, 2)), gust: cols.map((c) => tk(c, 3)), wave: cols.map((c) => tk(c, 9)), sun: cols.map((c) => tk(c, 5)) } : {}),
      ...(grid ? { dir: cols.map((c) => gridAt(grid, 'wd', s, nowHour + c)), rain: cols.map((c) => { const v = gridAt(grid, 'pr', s, nowHour + c); return v === null ? null : v / 10; }) } : {}),
    }, width);
    // label column: same rows, scaled with the SVG (it is drawn at width px and shown at the box width)
    const scale = (el.clientWidth || width) / width;
    $('tl-labs').innerHTML = tlLabels();
    $('tl-labs').style.transform = `scaleY(${scale})`;
    $('tl-labs').style.transformOrigin = 'top';
    $('strip-name').textContent = w.name;
    card.hidden = false;
    el.querySelectorAll<SVGRectElement>('.tl-hit').forEach((r) => r.addEventListener('click', () => {
      cardCol = Number(r.dataset.c);
      setCol(cardCol, 'timeline');
      fillCard(w, ++planSeq, eqKey.split('|').length, (() => { try { return localStorage.getItem('av-livn-outside-bursa') === '1'; } catch { return false; } })());
    }));
  }
  /** V1.4: one line of conditions at the card's hour, with the wind relative to this shore. */
  function condLine(s: Spot | undefined, d: Detail | null, col: number) {
    const v = d?.packed?.tk?.[d.from + col];
    const el = $('a-cond');
    if (!v) { el.hidden = true; return; }
    const hour = nowHour + col;
    const dir = gridAt(wxGrid, 'wd', s, hour);
    const pr = gridAt(wxGrid, 'pr', s, hour);
    const rel = windRel((s as { shore_normal_deg?: number | null } | undefined)?.shore_normal_deg, dir);
    const n = (x: number | null | undefined, k = 0) => (x == null ? '–' : x.toFixed(k).replace('.', ','));
    const parts = [
      `${icon('ruzgar', { size: 16 })}rüzgar ${n(v[2])} km/sa${dir !== null ? ` ${compass8(dir)}` : ''}${rel ? ` · ${rel}` : ''}`,
      `${icon('hamle', { size: 16 })}hamle ${n(v[3])}`,
      `${icon('yagis', { size: 16 })}${pr === null ? 'yağış –' : pr / 10 < 0.1 ? 'yağış yok' : `yağış ${n(pr / 10, 1)} mm/sa`}`,
      `${icon('dalga', { size: 16 })}dalga ${v[9] == null ? 'veri yok' : `${n(v[9], 1)} m`}`,
      `${icon('ay', { size: 16 })}${(v[5] ?? 0) > 0 ? 'gündüz' : (v[5] ?? 0) > -6 ? 'alacakaranlık' : 'gece'}`,
    ];
    el.innerHTML = parts.map((x) => `<span>${x}</span>`).join('');
    el.hidden = false;
  }
  function drawRig(t: ReturnType<typeof tackle> | ReturnType<typeof tackleLevrek>, colIso: string, input: TackleInput) {
    const row = (k: string) => t.rows.find((r) => r.key === k);
    // V2.4: istavrit — primary and secondary method (artificial and natural bait) with the rig scene
    if ('jigG' in t) {
      const inv = toOwned(loadMy());
      const month = new Date(Date.parse(colIso) + TZ_OFF * HOUR).getUTCMonth() + 1;
      const advice = recommendMethods({ month, light: t.light, depthM: input.depthM, currentMs: input.currentMs, gustKmh: input.gustKmh, waveM: input.waveM ?? null, kind: input.kind ?? 'diger', mode: inv.mode, owned: inv.owned, baits: inv.baits });
      mountMethodCard($('rig'), { advice, lure: { jigG: t.jigG, lureCm: t.lureCm, color: row('renk')?.value, hookNo: t.hook }, depthM: input.depthM, currentMs: input.currentMs });
      // the plan's "Ne ile başla?" names the primary method; the LRF detail line stays when LRF leads
      const pm = advice.primary;
      if (pm.id !== 'lrf') $('a-tackle').textContent = `${methodLine(pm)}${pm.bait ? ` · kurşun ${sinkerFor(input.depthM, input.currentMs)} g · #${t.hook} iğne` : ''}`;
      const sub = $('a-tackle-sub');
      sub.querySelector('.second')?.remove();
      sub.insertAdjacentHTML('beforeend', `<span class="second"> · İkincil: ${esc(methodLine(advice.secondary))}</span>`);
      $('rig-hour').textContent = `${fmtTime(colIso)} için`;
      $('rig-card').hidden = false;
      return;
    }
    // levrek keeps the lure sketch (its method pool is V2+)
    const color = row('renk')!;
    const cm = Number(/\d+/.exec(t.lureCm)?.[0] ?? 8);
    const base = { weightG: t.weightG, lureCm: cm, zone: (t.lure === 'metal jig' ? 'dibe yakın' : 'orta su') as Zone, sink: null };
    const vs: RigVariant[] = color.lit !== undefined ? [{ ...base, label: IF_LIT, color: color.lit }, { ...base, label: IF_DARK, color: color.dark! }] : [{ ...base, color: color.value }];
    const el = $('rig');
    el.innerHTML = rigSvg(vs, Math.max(300, Math.min(640, el.clientWidth || 420)));
    $('rig-hour').textContent = `${fmtTime(colIso)} için`;
    $('rig-card').hidden = false;
  }
  /** O3: when the plan's hour is not now, one line on why "now" differs (safety cap) and when it calms. */
  function nowLine(w: Win, d: Detail | null) {
    const el = $('a-now');
    const hs = hourSpot(w.spot_id);
    const off = hoursOffset();
    const planIsNow = Math.floor(Date.parse(w.start) / HOUR) <= nowHour && Math.floor(Date.parse(w.end) / HOUR) >= nowHour;
    const v0 = d?.packed?.tk?.[d.from];
    const nowGated = !!hs && hs.g.includes(off);
    let calm: string | null = null;
    if (hs && nowGated) for (let c = 1; c < 72; c++) if (!hs.g.includes(off + c) && hs.t[off + c] != null) { calm = fmtTime(new Date((nowHour + c) * HOUR).toISOString()); break; }
    const txt = nowVsPlan({ nowGated, gustKmh: v0?.[3] ?? null, waveM: v0?.[9] ?? null, calmFrom: calm, planIsNow, nowTotal: hs ? hs.t[off] ?? null : null, planTime: fmtTime(w.peak) });
    el.hidden = !txt;
    el.textContent = txt ?? '';
  }
  /** Q2: the server's plan candidates are already filtered (marinas, outside Bursa), so the likely pick is known
   *  from the windows alone: ask for its hourly detail now instead of after the spot list arrives (one round trip
   *  less on the plan card's critical path). A wrong guess only costs one cached request. */
  function prefetchPick(b: NonNullable<typeof winBody>) {
    let outsideOk = false;
    try { outsideOk = localStorage.getItem('av-livn-outside-bursa') === '1'; } catch {}
    const P = b.plan?.[outsideOk ? 'wide' : 'bursa'];
    if (!P) return;
    const pick = planPick([...(box.checked ? P.today.open : P.today.all).windows], (box.checked ? P.open : P.all).windows);
    if (pick) void detail(pick.eqList[0]!.spot_id); // the card shows the first equal option until another is chosen
  }
  const loadWindows = () => preFetch(api('/api/windows', species), { cache: 'no-cache' })
    .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
    .then((b: NonNullable<typeof winBody>) => { winBody = b; prefetchPick(b); renderWindows(); renderPlan(); })
    .catch(() => { $('windows').innerHTML = '<li class="muted">Pencereler alınamadı.</li>'; $('verdict').textContent = 'Bilinmiyor'; $('verdict-sub').textContent = 'Öneriler alınamadı (bağlantı ya da sunucu). "Tüm meralar" sekmesine bakın.'; planReady(); });
  loadWindows();

  // ---------------------------------------------------------------- species (H3)
  const spSel = $<HTMLSelectElement>('species');
  const showSpecies = () => {
    spSel.value = species;
    document.title = `av.livn — ${SPECIES_TR[species]}: av planı`;
  };
  showSpecies();
  spSel.addEventListener('change', () => {
    if (spSel.value === species) return;
    species = spSel.value as Species;
    saveSpecies(species);
    const u = new URL(location.href);
    if (species === 'istavrit') u.searchParams.delete('tur'); else u.searchParams.set('tur', species);
    history.replaceState(null, '', u);
    showSpecies();
    details.clear();
    detailCache.clear();
    focus = null;
    load();
    loadHours();
    loadGate(species);
    loadWindows();
    mapApi?.setSpecies(species);
  });

  applyHour(); // first draw at the store's hour (now, or ?t= from a link)
  // the map is needed at once only when the page opens on a view other than the plan
  if (app.dataset.view === 'plan') whenPlanReady(() => void ensureMap()); else void ensureMap();
</script>
