---
import Base from '../layouts/Base.astro';
---
<Base title="av.livn — Nereye, ne zaman?" app>
  <div class="app" id="app" data-tab="map">
    <section class="r-win" aria-labelledby="t-main">
      <h1 id="t-main">Nereye, ne zaman?</h1>
      <div class="species" role="radiogroup" aria-label="Tür">
        <button type="button" role="radio" aria-checked="true" class="sp on" data-sp="istavrit">İstavrit</button>
        <button type="button" role="radio" aria-checked="false" class="sp" data-sp="levrek" title="Deneysel: kanıtın çoğu C (docs/species/levrek)">Levrek</button>
        <button type="button" role="radio" aria-checked="false" class="sp" disabled title="Araştırma aşamasında">Lüfer / çinekop</button>
        <button type="button" role="radio" aria-checked="false" class="sp" disabled title="Araştırma aşamasında">Mırmır / karagöz</button>
        <button type="button" role="radio" aria-checked="false" class="sp" disabled title="Araştırma aşamasında">Kolyoz</button>
      </div>
      <p class="fs-1 muted sp-note" id="sp-note">Levrek deneysel (kanıtın çoğu varsayım); diğer türler araştırma aşamasında.</p>

      <!-- I9: first view = one plan, at most two alternatives; everything else is one tap away -->
      <div class="plan" id="plan" aria-live="polite">
        <p class="verdict" id="verdict">Yükleniyor…</p>
        <article class="card main-pick" id="pick" hidden></article>
        <ol class="alts" id="alts" hidden></ol>
        <details class="why-box">
          <summary>Puan ne demek? Öneri ne kadar sağlam?</summary>
          <p>Puan, o saatteki koşulların bu tür için tanımlı <b>ideal senaryoya göre yeri</b> (0–100). Sahada doğrulanmış yakalama olasılığı değildir; av günlüğünde henüz yeterli ileriye dönük seans yok.</p>
          <p><b>Bant</b> ve <b>“ilk 3'te”</b> oranı yalnız model parametrelerinin belirsizliğini gösterir. Hava tahmininin hatası ve modelin yapısı bu aralığa dahil değildir.</p>
          <p><b>Güçlü:</b> zirve ≥ 65 ve veri tam. <b>Görece:</b> mevcut seçeneklerin en iyisi. Rüzgar ya da dalga verisi yoksa öneri verilmez.</p>
          <p>Kanıt düzeyleri ve formüller: <a href="/model/">Model nasıl çalışıyor?</a> · Veri kaynakları ve geçerlilik kuralları: <a href="https://github.com/LiVNLOUD/av-livn/blob/main/docs/DATA-SOURCES.md">DATA-SOURCES</a></p>
        </details>
      </div>

      <details class="more-win" id="more-win">
        <summary>Tüm pencereler <span class="muted fs-2">önümüzdeki 72 saat</span></summary>
        <ol class="windows" id="windows" aria-live="polite"><li class="muted">Yükleniyor…</li></ol>
        <p class="muted fs-1" id="win-note"></p>
      </details>
      <p class="fs-2 to-all"><a href="#t-spots">Tüm meralar, saat çizelgesi ve harita ↓</a></p>
    </section>

    <section class="r-heat" aria-labelledby="t-heat">
      <div class="heat-head">
        <h2 id="t-heat">Mera × saat</h2>
        <div class="heat-ctl">
          <button type="button" class="btn small secondary map-toggle" id="map-toggle" hidden>Haritayı göster</button>
          <div class="seg-sm" role="radiogroup" aria-label="Isı haritası görünümü">
            <button type="button" role="radio" aria-checked="true" data-mode="score">Puan</button>
            <button type="button" role="radio" aria-checked="false" data-mode="diff">Meraya özgü fark</button>
          </div>
          <label class="toggle sm"><input type="checkbox" id="hm-unc" /> Belirsizliği göster</label>
        </div>
      </div>
      <p class="fs-1 muted legend-line" id="hm-legend"></p>
      <div class="heat" id="heat"><p class="muted fs-2">Yükleniyor…</p></div>
      <div class="card heat-sum" id="heat-sum" hidden aria-live="polite"></div>
    </section>

    <section class="r-spots" aria-labelledby="t-spots">
      <h2 class="sec" id="t-spots">Meralar</h2>
      <div class="when" role="group" aria-label="Saat seçimi">
        <button type="button" id="now" class="btn secondary on">Şimdi</button>
        <select id="day" aria-label="Gün"></select>
        <select id="hour" aria-label="Saat"></select>
      </div>
      <p class="muted fs-2" id="meta">Meralar yükleniyor…</p>
      <label class="toggle"><input type="checkbox" id="hide-access" /> Erişimi belirsiz/kısıtlı olanları gizle</label>
      <ol class="spots" id="spots" aria-live="polite"></ol>
      <p class="empty muted" id="empty" hidden></p>
    </section>

    <section class="r-map" aria-label="Harita">
      <div class="tabs" role="tablist" aria-label="Görünüm">
        <button type="button" role="tab" id="tab-map" aria-selected="true">Harita</button>
        <button type="button" role="tab" id="tab-heat" aria-selected="false">Isı haritası</button>
      </div>
      <div class="mapbox" id="map"></div>
    </section>

    <aside class="r-card" id="drawer" hidden aria-label="Mera kartı">
      <div class="drawer-head">
        <span class="fs-2 muted" id="drawer-title">Mera kartı</span>
        <div class="actions">
          <a class="btn small secondary" id="drawer-open" href="/mera/">Tam sayfa</a>
          <button type="button" class="btn small secondary" id="drawer-close" aria-label="Kartı kapat">Kapat</button>
        </div>
      </div>
      <iframe id="drawer-frame" title="Mera kartı" loading="lazy"></iframe>
    </aside>
  </div>
</Base>

<style>
  /* One grid; areas change per breakpoint (docs/DESIGN.md). */
  .app { display: grid; gap: var(--s5); padding: var(--s4); grid-template-columns: minmax(0, 1fr); grid-template-areas: 'win' 'heat' 'spots'; }
  .r-win { grid-area: win; } .r-heat { grid-area: heat; min-width: 0; } .r-spots { grid-area: spots; } .r-map { grid-area: map; display: none; } .r-card { grid-area: card; }
  @media (min-width: 768px) {
    .app { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-areas: 'win map' 'heat map' 'spots map'; }
    .r-map { display: block; position: sticky; top: var(--s4); height: calc(100dvh - var(--header-h) - var(--s6)); }
    .r-card:not([hidden]) { position: fixed; z-index: 20; left: 0; right: 0; bottom: 0; height: 62dvh; }
  }
  @media (min-width: 1200px) {
    :global(body.app) { height: 100dvh; overflow: hidden; }
    :global(body.app main) { min-height: 0; }
    :global(body.app footer.site) { display: none; }
    .app { height: 100%; padding: 0; gap: 0; grid-template-columns: 400px minmax(0, 1fr) auto; grid-template-rows: auto minmax(0, 1fr); grid-template-areas: 'win center card' 'spots center card'; }
    .r-win, .r-spots { padding: var(--s5); border-right: 1px solid var(--swell); overflow: auto; }
    .r-win { padding-bottom: 0; }
    .r-spots { padding-top: var(--s4); }
    .r-heat, .r-map { grid-area: center; position: relative; top: 0; height: auto; min-height: 0; }
    .r-heat { overflow: auto; padding: var(--s5); padding-top: 64px; }
    .app[data-tab='map'] .r-heat, .app[data-tab='heat'] .mapbox { display: none; }
    .r-map { display: block; pointer-events: none; }
    .r-map > * { pointer-events: auto; }
    .app[data-tab='heat'] .r-map { z-index: 2; height: 56px; }
    .tabs { display: flex !important; }
    .r-card:not([hidden]) { position: static; height: auto; width: 420px; border-left: 1px solid var(--swell); }
  }
  @media (min-width: 1920px) {
    /* H5: the heat map gets ≥ 16 px per hour (72 h ≈ 1150 px + 260 px names); the map narrows and can be folded */
    .app { grid-template-columns: 340px minmax(1460px, 1fr) minmax(360px, 0.8fr) auto; grid-template-areas: 'win heat map card' 'spots heat map card'; }
    .app.map-off { grid-template-columns: 340px minmax(0, 1fr) 0 auto; }
    .app.map-off .r-map { display: none !important; }
    .r-heat { grid-area: heat; padding-top: var(--s5); border-right: 1px solid var(--swell); }
    .r-map { grid-area: map; }
    .map-toggle { display: inline-flex !important; }
    .app[data-tab] .r-heat, .app[data-tab] .mapbox { display: block; }
    .app[data-tab] .r-map { height: auto; }
    .tabs { display: none !important; }
  }

  .r-win h1 { margin-top: var(--s1); }

  .sec { margin: var(--s5) 0 var(--s3); display: flex; gap: var(--s2); align-items: baseline; flex-wrap: wrap; }
  .species { display: flex; gap: var(--s2); overflow-x: auto; margin-top: var(--s4); padding-bottom: 2px; }
  .sp { flex: none; height: 32px; padding: 0 var(--s3); border-radius: 999px; border: 1px solid var(--swell); background: transparent; color: var(--mist); font-size: var(--fs-2); font-weight: 600; }
  @media (pointer: coarse), (max-width: 600px) { .sp { height: 44px; } }
  .sp.on { background: var(--sodium); border-color: var(--sodium); color: #1a1205; }
  .sp:disabled { opacity: 0.5; cursor: not-allowed; }
  .sp-note { margin: var(--s2) 0 0; }
  .windows { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--s2); }
  :global(.win) { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--s1) var(--s3); }
  :global(.win .t) { font-weight: 700; font-size: var(--fs-3); line-height: var(--lh-3); }
  :global(.win .n) { grid-column: 1; font-size: var(--fs-2); line-height: var(--lh-2); }
  :global(.win .s) { grid-row: 1 / span 2; grid-column: 2; align-self: center; text-align: right; font-size: var(--fs-5); line-height: var(--lh-5); font-weight: 760; }
  :global(.win .s small) { display: block; font-size: var(--fs-1); font-weight: 500; color: var(--mist); }
  :global(.win .r) { grid-column: 1 / -1; font-size: var(--fs-2); line-height: var(--lh-2); color: var(--mist); }
  :global(.win .actions) { grid-column: 1 / -1; margin-top: var(--s2); }
  .heat-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--s2); margin-bottom: var(--s3); }
  .legend-line { margin: 0 0 var(--s2); display: flex; align-items: center; gap: var(--s1); flex-wrap: wrap; }
  .map-toggle { display: none; }
  .heat-ctl { display: flex; align-items: center; gap: var(--s3); flex-wrap: wrap; }
  .seg-sm { display: inline-flex; border: 1px solid var(--swell); border-radius: 999px; padding: 2px; }
  .seg-sm button { border: 0; background: none; color: var(--mist); font: inherit; font-size: var(--fs-1); font-weight: 600; padding: 0 var(--s3); min-height: 32px; border-radius: 999px; cursor: pointer; }
  .seg-sm button[aria-checked='true'] { background: var(--swell); color: var(--foam); }
  .toggle.sm { min-height: 32px; font-size: var(--fs-1); color: var(--mist); }
  .toggle.sm input { width: 16px; height: 16px; }
  :global(.divramp) { display: inline-block; width: 64px; height: 10px; border-radius: 2px; background: linear-gradient(90deg, rgb(86 160 204), rgb(27 46 59), rgb(245 168 60)); }
  .heat-sum { margin-top: var(--s4); display: grid; gap: var(--s1); font-size: var(--fs-2); }
  :global(.heat-sum h3) { font-size: var(--fs-3); margin: 0; display: flex; gap: var(--s2); align-items: baseline; flex-wrap: wrap; }
  :global(.heat-sum .big) { font-size: var(--fs-5); font-weight: 760; line-height: 1; }
  :global(.heat-sum p) { margin: 0; color: var(--mist); }
  :global(.heat-sum .tk) { color: var(--foam); }
  :global(.heat-sum .tk b) { color: var(--sodium); font-weight: 650; }
  :global(.heatmap .hm-focus) { fill: none; stroke: var(--foam); stroke-width: 1; opacity: 0.45; }
  :global(.ramp) { display: inline-block; width: 56px; height: 10px; border-radius: 2px; background: linear-gradient(90deg, rgb(57 50 52), rgb(185 126 80), rgb(71 157 109)); }
  :global(.hatchsw) { display: inline-block; width: 14px; height: 10px; border-radius: 2px; background: repeating-linear-gradient(45deg, #0e1c27 0 1.5px, #5d9a76 1.5px 4px); }
  .heat { overflow-x: auto; }
  :global(.heatmap) { display: block; font-family: inherit; }
  :global(.heatmap text) { fill: var(--foam); font-size: var(--fs-1); }
  :global(.heatmap .hm-day) { font-weight: 650; font-size: var(--fs-1); }
  :global(.heatmap .hm-tick), :global(.heatmap .hm-nowl) { fill: var(--mist); font-size: var(--fs-1); }
  :global(.heatmap .hm-sep) { stroke: var(--foam); stroke-width: 1.5; opacity: 0.75; }
  :global(.heatmap .hm-now) { stroke: var(--sodium); stroke-width: 1; }
  :global(.heatmap .hm-nowl) { fill: var(--sodium); }
  :global(.heatmap .hm-selcol) { fill: var(--foam); opacity: 0.12; }
  :global(.heatmap .hm-nowl) { font-size: 10px; }
  :global(.heatmap .hm-cell) { cursor: pointer; }
  :global(.heatmap .hm-cell:hover) { stroke: var(--foam); stroke-width: 1; }
  :global(.heatmap .hm-name text) { cursor: pointer; }
  :global(.heatmap .hm-name:hover text) { fill: var(--sodium); }
  :global(.heatmap .hm-b) { fill: var(--warn); font-size: var(--fs-1); }
  :global(.heatmap .hm-b.legal) { fill: var(--storm); }
  .when { display: flex; gap: var(--s2); flex-wrap: wrap; align-items: center; margin-bottom: var(--s2); }
  .when select { flex: 1 1 120px; height: 40px; padding-top: 0; padding-bottom: 0; }
  #now.on { background: var(--foam); color: var(--sea); border-color: var(--foam); }
  .toggle { display: flex; gap: var(--s2); align-items: center; grid-auto-flow: column; justify-content: start; min-height: 44px; }
  .toggle input { width: 20px; height: 20px; }
  .spots { list-style: none; margin: var(--s2) 0 0; padding: 0; }
  :global(.grp-btn) { width: 100%; display: grid; grid-template-columns: 52px minmax(0, 1fr); gap: var(--s3); align-items: center; padding: var(--s3) 0; border: 0; border-top: 1px solid var(--swell); background: none; color: var(--foam); font: inherit; font-size: var(--fs-2); text-align: left; cursor: pointer; min-height: 52px; }
  :global(.grp-btn:hover) { color: var(--sodium); }
  :global(.grp), :global(.grp-btn) { min-width: 0; max-width: 100%; }
  :global(.grp-btn > span:last-child) { white-space: normal; overflow-wrap: anywhere; min-width: 0; }
  :global(.grp.beach .grp-btn) { font-weight: 650; }
  :global(.heatmap .hm-grp text) { fill: var(--sodium); font-weight: 650; cursor: pointer; }
  :global(.spot) { display: grid; grid-template-columns: 52px minmax(0, 1fr); gap: var(--s3); align-items: center; padding: var(--s3) 0; border-top: 1px solid var(--swell); text-decoration: none; cursor: pointer; }
  :global(.spot h3) { font-size: var(--fs-3); line-height: var(--lh-3); font-weight: 620; }
  :global(.spot .sub), :global(.spot .why), :global(.spot .reason) { margin: 2px 0 0; font-size: var(--fs-2); line-height: var(--lh-2); color: var(--mist); }
  :global(.spot .rk) { color: var(--foam); font-weight: 700; }
  :global(.spot .badge) { margin-left: var(--s1); }
  .empty { padding: var(--s5) 0; }
  .mapbox { position: absolute; inset: 0; border-radius: 12px; overflow: hidden; }
  @media (min-width: 1200px) { .mapbox { border-radius: 0; } }
  .tabs { display: none; position: absolute; z-index: 3; top: var(--s3); left: var(--s3); gap: 2px; padding: 2px; border-radius: 999px; background: var(--deep); border: 1px solid var(--swell); }
  .tabs button { height: 32px; padding: 0 var(--s3); border-radius: 999px; background: transparent; color: var(--mist); font-size: var(--fs-2); }
  .tabs button[aria-selected='true'] { background: var(--swell); color: var(--foam); }
  .r-card { background: var(--deep); display: flex; flex-direction: column; min-height: 0; border-top: 1px solid var(--swell); }
  .drawer-head { display: flex; align-items: center; justify-content: space-between; gap: var(--s2); padding: var(--s2) var(--s3); border-bottom: 1px solid var(--swell); }
  .r-card iframe { flex: 1; width: 100%; border: 0; background: var(--sea); }
</style>

<script>
  import { esc, fmtAgo, fmtDay, fmtTime, KIND_TR, lampV2, swimRule } from '../scripts/format';
  import { DEFAULT_PROFILES, kindLabel, leadWithRank, tackle, tackleLevrek, tackleLevrekShort, tackleShort, type TackleProfile } from '@av-livn/scoring';
  import { api, currentSpecies, LEGAL_MIN, link, saveSpecies, SPECIES_TR, type Species } from '../scripts/species';
  import { renderHeatmap, type HeatRow, type HoursData, type HourSpot } from '../scripts/heatmap';
  import { columnMax, groupSame, isGroup, rankLabel, splitBeaches, tieCounts } from '../scripts/grouping';
  import type { MapApi } from '../scripts/map';

  type Spot = {
    id: string; name: string; kind: string; status: string; place: string | null; lamp_known: boolean; access: string | null; auto_added?: boolean; province?: string | null;
    score: { total: number | null; p10: number | null; p90: number | null; rank: number | null; gated: boolean; warnings: string[]; partial: boolean; reason: string | null };
  };
  type Win = { spot_id: string; name: string; start: string; end: string; peak: string; total: number; p10: number | null; p90: number | null; rank: number; why: string | null; assumed: boolean; tier?: 'guclu' | 'goreli'; missing?: string | null; top3?: number | null; access?: string | null };

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const app = $('app');
  let species: Species = currentSpecies();
  const HOUR = 3_600_000;
  const TZ_OFF = 3;
  const ACCESS_BADGE: Record<string, string> = { kisitli_feribot: 'kısıtlı olabilir (feribot)', belirsiz: 'erişim belirsiz' };
  const HIDE = 'av-livn-hide-access';
  const nowHour = Math.floor(Date.now() / HOUR);
  let sel = 0; // column index from nowHour
  let all: Spot[] = [];
  let hours: HoursData | null = null;
  let fetched: string | null = null;
  const atIso = () => (sel === 0 ? null : new Date((nowHour + sel) * HOUR).toISOString());
  const box = $<HTMLInputElement>('hide-access');
  try { box.checked = localStorage.getItem(HIDE) === '1'; } catch {}
  const hidden = (s: { access: string | null }) => box.checked && !!s.access && s.access !== 'acik';
  /** I5: spots outside Bursa stay in the list (badge) but not in the home plan. */
  const outside = (s: { province?: string | null }) => !!s.province && s.province !== 'bursa';
  box.addEventListener('change', () => {
    try { localStorage.setItem(HIDE, box.checked ? '1' : '0'); } catch {}
    render();
    heat();
    summary();
    renderWindows();
    renderPlan();
  });

  // ---------------------------------------------------------------- card drawer
  const wide = matchMedia('(min-width: 768px)');
  function openSpot(id: string, col = sel) {
    const t = new Date((nowHour + col) * HOUR).toISOString();
    const url = link(`/mera/?id=${encodeURIComponent(id)}&t=${encodeURIComponent(t)}`, species);
    if (!wide.matches) { location.href = url; return; }
    $<HTMLIFrameElement>('drawer-frame').src = `${url}&embed=1`;
    $<HTMLAnchorElement>('drawer-open').href = url;
    $('drawer-title').textContent = all.find((s) => s.id === id)?.name ?? hours?.spots.find((s) => s.id === id)?.name ?? 'Mera kartı';
    $('drawer').hidden = false;
    mapApi?.flyTo(id);
    requestAnimationFrame(() => mapApi?.resize());
  }
  $('drawer-close').addEventListener('click', () => { $('drawer').hidden = true; requestAnimationFrame(() => mapApi?.resize()); });
  addEventListener('message', (e) => { if (e.origin === location.origin && e.data === 'close-card') $('drawer-close').click(); });

  // ---------------------------------------------------------------- map (only where it is visible: ≥768 px)
  let mapApi: MapApi | null = null;
  async function ensureMap() {
    if (mapApi || !wide.matches || app.classList.contains('map-off') || app.dataset.tab === 'heat' && innerWidth < 1920 && innerWidth >= 1200) return;
    const { mountMap } = await import('../scripts/map');
    mapApi = mountMap({ container: $('map'), at: atIso(), onSpot: (id) => openSpot(id), species });
  }
  const tab = (t: 'map' | 'heat') => {
    app.dataset.tab = t;
    $('tab-map').setAttribute('aria-selected', String(t === 'map'));
    $('tab-heat').setAttribute('aria-selected', String(t === 'heat'));
    if (t === 'map') ensureMap().then(() => mapApi?.resize());
    else heat();
  };
  // H5: from 1920 px the map column can be folded so the heat map keeps ≥ 16 px per hour; folded by default < 2400 px
  const MAPK = 'av-livn-map-off';
  const xl = matchMedia('(min-width: 1920px)');
  const mt = $<HTMLButtonElement>('map-toggle');
  let mapOff = innerWidth < 2400;
  try { const v = localStorage.getItem(MAPK); if (v !== null) mapOff = v === '1'; } catch {}
  const applyMap = () => {
    app.classList.toggle('map-off', xl.matches && mapOff);
    mt.hidden = !xl.matches;
    mt.textContent = mapOff ? 'Haritayı göster' : 'Haritayı gizle';
    requestAnimationFrame(() => { mapApi?.resize(); heat(); });
  };
  mt.addEventListener('click', () => {
    mapOff = !mapOff;
    try { localStorage.setItem(MAPK, mapOff ? '1' : '0'); } catch {}
    applyMap();
    if (!mapOff) ensureMap();
  });
  xl.addEventListener('change', applyMap);
  applyMap();
  $('tab-map').addEventListener('click', () => tab('map'));
  $('tab-heat').addEventListener('click', () => tab('heat'));
  wide.addEventListener('change', () => ensureMap());

  // ---------------------------------------------------------------- hour picker (Istanbul local time)
  const day = $<HTMLSelectElement>('day');
  const hourSel = $<HTMLSelectElement>('hour');
  const local = (h: number) => new Date((h + TZ_OFF) * HOUR);
  const days = [0, 1, 2, 3].map((k) => {
    const d = local(nowHour + 24 * k);
    return Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate()) / HOUR - TZ_OFF;
  }).filter((m) => m < nowHour + 72);
  day.innerHTML = days.map((m, i) => `<option value="${m}">${i === 0 ? 'Bugün' : i === 1 ? 'Yarın' : fmtDay(new Date((m + 12) * HOUR).toISOString())}</option>`).join('');
  function fillHours() {
    const m = Number(day.value);
    const o: string[] = [];
    for (let h = 0; h < 24; h++) if (m + h >= nowHour && m + h <= nowHour + 71) o.push(`<option value="${m + h}">${String(h).padStart(2, '0')}:00</option>`);
    hourSel.innerHTML = o.join('');
  }
  function setCol(col: number) {
    sel = Math.max(0, Math.min(71, col));
    const h = nowHour + sel;
    day.value = String([...days].reverse().find((d) => d <= h) ?? days[0]);
    fillHours();
    hourSel.value = String(h);
    $('now').classList.toggle('on', sel === 0);
    load();
    heat();
    mapApi?.setHour(atIso());
  }
  $('now').addEventListener('click', () => setCol(0));
  day.addEventListener('change', () => { fillHours(); setCol(Number(hourSel.value) - nowHour); });
  hourSel.addEventListener('change', () => setCol(Number(hourSel.value) - nowHour));

  // ---------------------------------------------------------------- list
  // G3: structures first, beaches in one collapsible group; identical score+band as one expandable row.
  const BEACH = 'av-livn-beaches';
  let beachesOpen = false;
  try { beachesOpen = localStorage.getItem(BEACH) === '1'; } catch {}
  const openGroups = new Set<string>();
  const toggleGroup = (key: string) => {
    if (key === 'beaches') {
      beachesOpen = !beachesOpen;
      try { localStorage.setItem(BEACH, beachesOpen ? '1' : '0'); } catch {}
    } else if (!openGroups.delete(key)) openGroups.add(key);
    render();
    heat();
  };
  const sameLabel = (kinds: string[], n: number) => `${n} ${new Set(kinds).size === 1 ? kindLabel(kinds[0]!) : 'mera'} aynı puan`;

  function render() {
    const spots = all.filter((s) => !hidden(s));
    const at = atIso();
    $('meta').textContent = `${spots.length}${spots.length !== all.length ? ` / ${all.length}` : ''} mera, ${at ? `${fmtDay(at)} ${fmtTime(at)} için sıra` : 'şu anki sıra'}. ${fmtAgo(fetched)}.`;
    $('empty').hidden = spots.length > 0;
    if (!spots.length) $('empty').textContent = all.length ? 'Filtreye uyan mera yok.' : 'Henüz mera yok.';
    const ties = tieCounts(all.map((s) => s.score.rank));
    const row = (s: Spot) => {
      const sc = s.score;
      const sub = [KIND_TR[s.kind] ?? s.kind, s.place, s.status === 'verified' ? 'sahada doğrulandı' : 'doğrulanmadı'].filter(Boolean).join(', ');
      const band = sc.p10 !== null && sc.p90 !== null ? ` · bant ${Math.round(sc.p10)}–${Math.round(sc.p90)}` : '';
      const why = sc.gated
        ? `<p class="why warn">${esc(sc.warnings[0])}</p>`
        : sc.total === null || sc.rank === null
          ? '<p class="why">Puan henüz hesaplanmadı</p>'
          : `<p class="why"><b class="rk">${rankLabel(sc.rank, ties.get(sc.rank) ?? 1)}</b> / ${all.length}${band}${leadWithRank(sc.p10, sc.p90) ? ' · belirsizlik geniş' : ''}${s.lamp_known ? '' : ' · iskele aydınlatması bilinmiyor'}</p>`;
      const legal = swimRule(s.kind, at ?? new Date().toISOString());
      const badges = (s.access && ACCESS_BADGE[s.access] ? `<span class="badge warn">${ACCESS_BADGE[s.access]}</span>` : '') + (legal ? `<span class="badge legal">${legal}</span>` : '') + (s.auto_added ? '<span class="badge assume" title="otomatik eklendi — sahada doğrulanmadı">otomatik</span>' : '') + (outside(s) ? '<span class="badge" title="Bursa ili dışında, yakın çevre">Bursa dışı</span>' : '');
      return `<li><a class="spot" href="${link(`/mera/?id=${encodeURIComponent(s.id)}`, species)}" data-id="${esc(s.id)}">
          <span class="lamp" data-total="${sc.total ?? ''}" data-gated="${sc.gated}"></span>
          <span><h3>${esc(s.name)}${badges}</h3><p class="sub">${esc(sub)}</p>${why}${sc.reason ? `<p class="reason">${esc(sc.reason)}</p>` : ''}</span></a></li>`;
    };
    const section = (list: Spot[], prefix: string) =>
      groupSame(list, (s) => (s.score.gated || s.score.total === null ? null : `${s.score.total}|${s.score.p10}|${s.score.p90}`))
        .map((x) => {
          if (!isGroup(x)) return row(x);
          const key = `${prefix}:${x.sig}`;
          const open = openGroups.has(key);
          const sc = x.group[0]!.score;
          const band = sc.p10 !== null && sc.p90 !== null ? `, bant ${Math.round(sc.p10)}–${Math.round(sc.p90)}` : '';
          const head = `<li class="grp"><button type="button" class="grp-btn" data-grp="${esc(key)}" aria-expanded="${open}"><span class="lamp" data-total="${sc.total ?? ''}" data-gated="false"></span><span>${sameLabel(x.group.map((g) => g.kind), x.group.length)} (${Math.round(sc.total!)}${band}) — ${open ? 'daralt' : 'genişlet'}</span></button></li>`;
          return head + (open ? x.group.map(row).join('') : '');
        })
        .join('');
    const { main, beaches } = splitBeaches(spots);
    const best = beaches.reduce<number | null>((m, s) => (s.score.total !== null && (m === null || s.score.total > m) ? s.score.total : m), null);
    $('spots').innerHTML =
      section(main, 'm') +
      (beaches.length
        ? `<li class="grp beach"><button type="button" class="grp-btn" data-grp="beaches" aria-expanded="${beachesOpen}"><span class="lamp" data-total="${best ?? ''}" data-gated="false"></span><span>Kumsallar (${beaches.length})${best !== null ? ` — en iyi ${Math.round(best)}` : ''} · ${beachesOpen ? 'daralt' : 'genişlet'}</span></button></li>` +
          (beachesOpen ? section(beaches, 'b') : '')
        : '');
    $('spots').querySelectorAll<HTMLElement>('.lamp').forEach((el) => lampV2(el, el.dataset.total === '' ? null : Number(el.dataset.total), el.dataset.gated === 'true'));
    $('spots').querySelectorAll<HTMLButtonElement>('[data-grp]').forEach((b) => b.addEventListener('click', () => toggleGroup(b.dataset.grp!)));
    $('spots').querySelectorAll<HTMLAnchorElement>('a.spot').forEach((a) => a.addEventListener('click', (e) => {
      if (!wide.matches) return;
      e.preventDefault();
      openSpot(a.dataset.id!);
    }));
  }
  let seq = 0;
  function load() {
    const my = ++seq;
    const at = atIso();
    fetch(api(`/api/spots${at ? `?at=${encodeURIComponent(at)}` : ''}`, species), { cache: 'no-cache' })
      .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
      .then((b: { spots: Spot[]; data_fetched_at: string | null }) => {
        if (my !== seq) return;
        const first = all.length === 0;
        all = b.spots;
        fetched = b.data_fetched_at;
        render();
        heat();
        summary();
        if (first) renderPlan(); // the plan's province filter needs the spot list
      })
      .catch(() => { if (my === seq) $('meta').textContent = 'Puanlar alınamadı. Bağlantınızı kontrol edip sayfayı yenileyin.'; });
  }

  // ---------------------------------------------------------------- heat map (F5: view, uncertainty toggle, summary)
  const HM = 'av-livn-heat';
  let hmMode: 'score' | 'diff' = 'score';
  let focus: string | null = null; // spot of the summary under the map; null = top spot at the selected hour
  const unc = $<HTMLInputElement>('hm-unc');
  try {
    const st = JSON.parse(localStorage.getItem(HM) ?? '{}') as { mode?: 'score' | 'diff'; unc?: boolean };
    if (st.mode === 'diff') hmMode = 'diff';
    unc.checked = !!st.unc;
  } catch {}
  const saveHm = () => { try { localStorage.setItem(HM, JSON.stringify({ mode: hmMode, unc: unc.checked })); } catch {} };
  document.querySelectorAll<HTMLButtonElement>('.seg-sm button').forEach((b) => {
    b.setAttribute('aria-checked', String(b.dataset.mode === hmMode));
    b.addEventListener('click', () => {
      hmMode = b.dataset.mode as 'score' | 'diff';
      document.querySelectorAll<HTMLButtonElement>('.seg-sm button').forEach((x) => x.setAttribute('aria-checked', String(x === b)));
      saveHm();
      heat();
    });
  });
  unc.addEventListener('change', () => { saveHm(); heat(); });

  function heat() {
    if (!hours) return;
    const el = $('heat');
    if (!el.clientWidth) return; // hidden tab; rendered when shown
    const st = renderHeatmap(el, hours, {
      selected: sel,
      mode: hmMode,
      showUncertainty: unc.checked,
      focus: focusId(),
      onGroup: toggleGroup,
      compose: (rows: HourSpot[]): HeatRow[] => {
        const same = (list: HourSpot[], prefix: string): HeatRow[] =>
          groupSame(list, (s) => JSON.stringify([s.t, s.w, s.g])).flatMap((x) => {
            if (!isGroup(x)) return [x];
            const key = `h${prefix}:${x.group.map((g) => g.id).sort().join(',')}`;
            const open = openGroups.has(key);
            const head: HeatRow = { ...x.group[0]!, name: `${sameLabel(x.group.map((g) => g.kind), x.group.length)} — ${open ? 'daralt' : 'genişlet'}`, group: { key, ids: x.group.map((g) => g.id), open } };
            return open ? [head, ...x.group] : [head];
          });
        const { main, beaches } = splitBeaches(rows);
        if (!beaches.length) return same(main, 'm');
        const head: HeatRow = {
          ...beaches[0]!, name: `Kumsallar (${beaches.length}) — ${beachesOpen ? 'daralt' : 'genişlet'}`,
          t: columnMax(beaches.map((b) => b.t), hours!.hours), w: beaches[0]!.t.map(() => null), g: [],
          group: { key: 'beaches', ids: beaches.map((b) => b.id), open: beachesOpen },
        };
        return [...same(main, 'm'), head, ...(beachesOpen ? same(beaches, 'b') : [])];
      },
      hide: (s) => hidden(s),
      badges: (s: HourSpot) => {
        const a = s.access && s.access !== 'acik' ? `<tspan class="hm-b" dx="6">▲</tspan>` : '';
        const l = swimRule(s.kind, new Date((nowHour + sel) * HOUR)) ? `<tspan class="hm-b legal" dx="4">●</tspan>` : '';
        return a + l;
      },
      onCell: (id, col) => {
        focus = id;
        if (col !== sel) setCol(col);
        else { heat(); summary(); }
        openSpot(id, col);
      },
    });
    const sky = 'üst şerit: gece / alacakaranlık / gündüz';
    const band = st.meanBand === null ? '' : ` · ortalama bant genişliği ${Math.round(st.meanBand)} puan`;
    const scale = hmMode === 'diff'
      ? `<span class="divramp" aria-hidden="true"></span> saat ortalamasının altında ← → üstünde (±${st.diffMax} puanda doyar)`
      : '<span class="ramp" aria-hidden="true"></span> düşük → yüksek puan';
    const hatch = unc.checked && st.wideFrom !== null ? ` · <span class="hatchsw" aria-hidden="true"></span> bandı en geniş üçte bir (> ${Math.round(st.wideFrom)} puan)` : '';
    $('hm-legend').innerHTML = `${scale}${hatch}${band} · ${sky}`;
  }

  /** Focused spot: the clicked one if still visible, else the best at the selected hour. */
  function focusId(): string | null {
    const vis = all.filter((s) => !hidden(s));
    if (focus && vis.some((s) => s.id === focus)) return focus;
    return [...vis].filter((s) => s.score.total !== null).sort((a, b) => (a.score.rank ?? 1e9) - (b.score.rank ?? 1e9))[0]?.id ?? null;
  }

  let profiles: TackleProfile[] = DEFAULT_PROFILES;
  fetch('/api/tackle').then((r) => (r.ok ? r.json() : null)).then((b) => { if (b?.profiles?.length) profiles = b.profiles; }).catch(() => {});
  type Detail = { from: number; packed: { tk?: (number | null)[][] } | null };
  const details = new Map<string, Promise<Detail | null>>();
  const detail = (id: string) => {
    if (!details.has(id)) details.set(id, fetch(api(`/api/spots/${encodeURIComponent(id)}?model=v2`, species)).then((r) => (r.ok ? r.json() : null)).catch(() => null));
    return details.get(id)!;
  };
  let sumSeq = 0;
  /** F5: the empty area under the heat map holds the focused spot's summary and the short tackle line. */
  async function summary() {
    const box = $('heat-sum');
    const id = focusId();
    const s = all.find((x) => x.id === id);
    if (!s) { box.hidden = true; return; }
    const my = ++sumSeq;
    const sc = s.score;
    const at = atIso() ?? new Date().toISOString();
    const legal = swimRule(s.kind, at);
    const badges = [
      s.access && ACCESS_BADGE[s.access] ? `<span class="badge warn">${ACCESS_BADGE[s.access]}</span>` : '',
      legal ? `<span class="badge legal">${legal}</span>` : '',
      s.auto_added ? '<span class="badge assume">otomatik eklendi — sahada doğrulanmadı</span>' : '',
    ].join('');
    const band = sc.p10 !== null && sc.p90 !== null ? `bant ${Math.round(sc.p10)}–${Math.round(sc.p90)}` : 'bant yok';
    const head = `<h3><span class="big">${sc.total === null ? '–' : Math.round(sc.total)}</span> ${esc(s.name)}</h3>
      <p>${sc.gated ? esc(sc.warnings[0] ?? 'güvenlik uyarısı') : `${sc.rank === null ? '–' : rankLabel(sc.rank, tieCounts(all.map((x) => x.score.rank)).get(sc.rank) ?? 1)} / ${all.length} · ${band}`} · ${at === atIso() ? `${fmtDay(at)} ${fmtTime(at)}` : 'şimdi'}</p>
      ${sc.reason ? `<p>${esc(sc.reason)}</p>` : ''}${badges ? `<p>${badges}</p>` : ''}`;
    box.innerHTML = `${head}<p class="tk" id="sum-tk">Takım: hesaplanıyor…</p><p><a class="link" href="${link(`/mera/?id=${encodeURIComponent(s.id)}`, species)}">Mera kartı ve takım kutusu →</a></p>`;
    box.hidden = false;
    const d = await detail(s.id);
    if (my !== sumSeq) return;
    const v = d?.packed?.tk?.[d.from + sel];
    const tkEl = document.getElementById('sum-tk');
    if (!tkEl) return;
    if (!v || sc.gated) { tkEl.textContent = sc.gated ? 'Takım: güvenlik uyarısı varken öneri yok.' : 'Takım: veri yok.'; return; }
    const input = { depthM: v[0] ?? 3, currentMs: v[1] ?? null, windKmh: v[2] ?? null, gustKmh: v[3] ?? null, crossKmh: v[4] ?? null, sunAlt: v[5] ?? 0, lampP: v[6] ?? null, turbidity: v[7] ?? null, sstDev: v[8] ?? null, waveM: v[9] ?? null, kind: s.kind };
    const short = species === 'levrek' ? tackleLevrekShort(tackleLevrek(input, profiles)) : tackleShort(tackle(input, profiles));
    tkEl.innerHTML = `Takım (${SPECIES_TR[species]}): <b>${esc(short)}</b> · yasal asgari boy ${LEGAL_MIN[species]} cm`;
  }
  const loadHours = () =>
    fetch(api('/api/hours', species), { cache: 'no-cache' })
      .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
      .then((b: HoursData) => { hours = b; heat(); })
      .catch(() => { $('heat').innerHTML = '<p class="muted fs-2">Isı haritası alınamadı.</p>'; });
  loadHours();
  let rz = 0;
  addEventListener('resize', () => { cancelAnimationFrame(rz); rz = requestAnimationFrame(heat); });

  // ---------------------------------------------------------------- best windows (E3)
  type WinList = { windows: Win[]; threshold: number; strong?: number };
  let winBody: (WinList & { open?: WinList; today?: { all: WinList; open: WinList; hours: number } }) | null = null;
  /** I2: the access filter applies to windows too (server computes the open-access list separately). */
  function renderWindows() {
    const ol = $('windows');
    if (!winBody) return;
    const b = box.checked && winBody.open ? winBody.open : winBody;
    // bodies stored before I2 (until the next hourly run) have no tiers: derive them the old way
    for (const w of b.windows) w.tier ??= w.total >= 65 ? 'guclu' : 'goreli';
    b.strong ??= b.windows.filter((w) => w.tier === 'guclu').length;
    if (!b.windows.length) { ol.innerHTML = '<li class="muted">72 saat içinde öne çıkan pencere yok.</li>'; $('win-note').textContent = ''; return; }
    const head = b.strong ? '' : '<li class="muted win-none"><b>Bu aralıkta güçlü öneri yok.</b> Aşağıdakiler mevcut seçenekler içinde görece en iyiler; gitmek için güçlü bir gerekçe değil.</li>';
    ol.innerHTML = head + b.windows
      .map((w) => {
        const end = new Date(Date.parse(w.end)).toISOString();
        const band = w.p10 !== null && w.p90 !== null ? ` · bant ${Math.round(w.p10)}–${Math.round(w.p90)}` : '';
        const col = Math.floor(Date.parse(w.peak) / HOUR) - nowHour;
        const tier = w.tier === 'guclu' ? '<span class="badge good">güçlü</span>' : '<span class="badge assume">görece</span>';
        return `<li class="card win">
          <span class="t">${esc(fmtDay(w.start))} ${fmtTime(w.start)}–${fmtTime(end)}</span>
          <span class="s">${Math.round(w.total)}<small>${w.rank}. sıra</small></span>
          <span class="n">${esc(w.name)} ${tier}</span>
          <span class="r">En iyi saat ${fmtTime(w.peak)}${band}.${w.why ? ` ${esc(w.why)}.` : ''} ${w.assumed ? '<span class="badge assume">varsayıma dayanıyor</span>' : ''}${w.missing ? ` <span class="badge warn">${esc(w.missing)}</span>` : ''}</span>
          <span class="actions"><button type="button" class="btn small" data-open="${esc(w.spot_id)}" data-c="${col}">Merayı aç</button><button type="button" class="btn small secondary" data-c="${col}">Bu saate göre sırala</button></span>
        </li>`;
      })
      .join('');
    ol.querySelectorAll<HTMLButtonElement>('button').forEach((btn) => btn.addEventListener('click', () => {
      const c = Number(btn.dataset.c);
      if (btn.dataset.open) openSpot(btn.dataset.open, c);
      else setCol(c);
    }));
    $('win-note').textContent = b.threshold < 65
      ? `72 saatte 65'i geçen saat az; en yüksek %15'lik dilim (≥ ${Math.round(b.threshold)}) gösteriliyor.`
      : 'Güçlü: zirve ≥ 65 ve veri tam. Pencere: zirve saatin çevresinde puanın 65 ve zirve − 8\'in üstünde kaldığı en çok 4 saat; mera başına bir pencere.';
  }

  // ---------------------------------------------------------------- I9: the plan (first view)
  const COLOR_FILL: [RegExp, string][] = [[/şeffaf|beyaz|gümüş/, '#dfe9ef'], [/koyu|siyah|mor/, '#3a3550'], [/parlak|chartreuse/, '#e8e23a'], [/doğal/, '#c9b28a']];
  const fillOf = (c: string) => COLOR_FILL.find(([re]) => re.test(c))?.[1] ?? '#c9b28a';
  const ZONE_Y: Record<string, number> = { 'yüzeye yakın': 24, 'orta su': 52, 'dibe yakın': 80 };
  /** Small rig picture: water column, target layer, jighead sized by grams, lure in its colour. */
  function rigSvg(g: number, zone: string, color: string) {
    const y = ZONE_Y[zone] ?? 52;
    const r = Math.max(3, Math.min(9, 2.5 + Math.sqrt(g) * 1.6));
    return `<svg viewBox="0 0 76 96" aria-hidden="true">
      <rect x="0" y="10" width="76" height="86" rx="6" fill="#10283a"/>
      <path d="M0 10 Q19 6 38 10 T76 10" stroke="#6fa3bf" fill="none" stroke-width="1.5"/>
      <rect x="0" y="88" width="76" height="8" fill="#3b3326"/>
      <line x1="38" y1="0" x2="38" y2="${y - r}" stroke="#dbe6ea" stroke-width="1" stroke-dasharray="2 2"/>
      <circle cx="38" cy="${y}" r="${r.toFixed(1)}" fill="#b9c4cc"/>
      <path d="M${38 + r} ${y} q12 -5 22 3 q-10 5 -22 -3z" fill="${fillOf(color)}" stroke="#0e1c27" stroke-width=".6"/>
      <rect x="2" y="${y - 7}" width="6" height="14" rx="2" fill="var(--sodium, #f2a93b)"/>
    </svg>`;
  }
  let planSeq = 0;
  async function renderPlan() {
    const my = ++planSeq;
    if (!winBody || !all.length) return; // drawn again when both the windows and the spot list are in
    const b = box.checked && winBody.open ? winBody.open : winBody;
    const inBursa = (w: Win) => !outside(all.find((x) => x.id === w.spot_id) ?? {});
    const ws = b.windows.filter(inBursa);
    const pick = $('pick');
    const alts = $('alts');
    const verdict = $('verdict');
    if (!ws.length) {
      verdict.innerHTML = '72 saatte öneri yok.<small>Ya koşullar uygun değil ya da rüzgar/dalga verisi eksik (güvenlik denetlenemiyor). Güvenlik uyarılarını listede görebilirsiniz.</small>';
      pick.hidden = true; alts.hidden = true; return;
    }
    // I9: answer "today?" first (until 06:00 tomorrow), then the nearest strong option in 72 h, else the relative best
    const td = (winBody.today ? (box.checked ? winBody.today.open : winBody.today.all).windows : []).filter(inBursa);
    for (const w of td) w.tier ??= w.total >= 65 ? 'guclu' : 'goreli';
    const todayStrong = td.find((w) => w.tier === 'guclu');
    const nextStrong = ws.find((w) => w.tier === 'guclu');
    const m = todayStrong ?? nextStrong ?? ws[0]!;
    const startD = fmtDay(m.start);
    const today = fmtDay(new Date().toISOString());
    const when = startD === today ? 'Bugün' : todayStrong ? `Bu gece (${startD})` : startD;
    const scope = `${SPECIES_TR[species]} için, Bursa kıyısındaki ${box.checked ? 'erişimi açık meralar' : 'tüm meralar'} arasından.`;
    verdict.innerHTML = todayStrong
      ? `${startD === today ? 'Bugün' : `Bu gece (${esc(startD)})`} ${fmtTime(m.start)}–${fmtTime(new Date(Date.parse(m.end)).toISOString())}: anlamlı bir seçenek var.<small>${scope}</small>`
      : nextStrong
      ? `Bugün güçlü seçenek yok. En yakın güçlü pencere: ${esc(when)} ${fmtTime(m.start)}.<small>${scope}${td[0] ? ` Bugünün görece en iyisi: ${esc(td[0].name)}, ${Math.round(td[0].total)}.` : ''}</small>`
      : `72 saatte güçlü öneri yok.<small>Aşağıdaki, mevcut seçeneklerin görece en iyisi; gitmek için güçlü bir gerekçe değil. ${scope}</small>`;
    const col = Math.floor(Date.parse(m.peak) / HOUR) - nowHour;
    const robust = [
      m.tier === 'guclu' ? '<span class="badge good">güçlü</span>' : '<span class="badge assume">görece</span>',
      m.missing ? `<span class="badge warn">${esc(m.missing)}</span>` : '<span class="badge">veri tam</span>',
      m.top3 != null ? `<span class="badge${m.top3 < 0.5 ? ' assume' : ''}" title="Model parametreleri oynatıldığında bu meranın ilk 3'te kaldığı çekimlerin payı (tahmin hatası dahil değil)">ilk 3'te: çekimlerin %${Math.round(m.top3 * 100)}'i</span>` : '',
      m.access && m.access !== 'acik' ? `<span class="badge warn">${esc(ACCESS_BADGE[m.access] ?? 'erişim belirsiz')}</span>` : '',
      m.assumed ? '<span class="badge assume">ana gerekçe varsayıma dayanıyor</span>' : '',
    ].join('');
    const reasons = [
      m.why ? `${esc(m.why)}${m.assumed ? ' (varsayım)' : ''}` : null,
      `en iyi saat ${fmtTime(m.peak)}${m.p10 !== null && m.p90 !== null ? `, bant ${Math.round(m.p10)}–${Math.round(m.p90)}` : ''}`,
      m.top3 != null && m.top3 < 0.5 ? 'sıralama kararsız: alternatiflerle arası açık değil' : null,
    ].filter(Boolean).map((x) => `<li>${x}</li>`).join('');
    pick.innerHTML = `<div class="top"><div><p class="nm">${esc(m.name)}</p><span class="tm">${esc(when)} ${fmtTime(m.start)}–${fmtTime(new Date(Date.parse(m.end)).toISOString())}</span></div><span class="sc" title="Puan: ideal senaryoya göre yer, yakalama olasılığı değil">${Math.round(m.total)}</span></div>
      <div class="rig" id="pick-rig"><svg viewBox="0 0 76 96"></svg><dl><dt>Takım</dt><dd>hesaplanıyor…</dd></dl></div>
      <ul>${reasons}</ul>
      <div class="badges">${robust}</div>
      <div class="go"><button type="button" class="btn small" id="pick-open">Merayı ve saatleri aç</button><a class="btn small secondary" href="${link(`/sahadayim/?id=${encodeURIComponent(m.spot_id)}`, species)}">Sahadayım'da başlat</a></div>`;
    pick.hidden = false;
    $('pick-open').addEventListener('click', () => openSpot(m.spot_id, col));
    const pool = todayStrong ? [...td, ...ws] : ws;
    const others = pool.filter((w, i, arr) => w.spot_id !== m.spot_id && arr.findIndex((x) => x.spot_id === w.spot_id) === i).slice(0, 2);
    alts.innerHTML = others.map((w) => {
      const c = Math.floor(Date.parse(w.peak) / HOUR) - nowHour;
      return `<li><button type="button" data-open="${esc(w.spot_id)}" data-c="${c}"><span class="a-n">${esc(w.name)}</span><span class="a-s">${Math.round(w.total)}</span><span class="a-r">${esc(fmtDay(w.start))} ${fmtTime(w.start)}–${fmtTime(new Date(Date.parse(w.end)).toISOString())}${w.tier === 'guclu' ? '' : ' · görece'}${w.missing ? ' · eksik veri' : ''}${w.top3 != null ? ` · ilk 3'te %${Math.round(w.top3 * 100)}` : ''}</span></button></li>`;
    }).join('');
    alts.hidden = !others.length;
    alts.querySelectorAll<HTMLButtonElement>('button').forEach((x) => x.addEventListener('click', () => openSpot(x.dataset.open!, Number(x.dataset.c))));
    // tackle for the peak hour (public inputs; owner refinements stay on the card)
    const d = await detail(m.spot_id);
    if (my !== planSeq) return;
    const rig = document.getElementById('pick-rig');
    const v = d?.packed?.tk?.[d.from + col];
    if (!rig) return;
    if (!v) { rig.innerHTML = '<p class="muted fs-2">Takım önerisi için bu saatin girdileri yok.</p>'; return; }
    const kind = all.find((x) => x.id === m.spot_id)?.kind;
    const input = { depthM: v[0] ?? 3, currentMs: v[1] ?? null, windKmh: v[2] ?? null, gustKmh: v[3] ?? null, crossKmh: v[4] ?? null, sunAlt: v[5] ?? 0, lampP: v[6] ?? null, turbidity: v[7] ?? null, sstDev: v[8] ?? null, waveM: v[9] ?? null, kind };
    if (species === 'levrek') {
      const t = tackleLevrek(input, profiles);
      const row = (k: string) => t.rows.find((r) => r.key === k)?.value ?? '–';
      rig.innerHTML = `${rigSvg(t.weightG, 'orta su', t.color)}<dl><dt>Takım</dt><dd>${t.profile === 'lrf' ? 'LRF' : 'Spin'} · ${String(t.weightG).replace('.', ',')} g</dd><dt>Yem</dt><dd>${esc(row('yem'))}</dd><dt>Renk</dt><dd>${esc(t.color)}</dd><dt>Teknik</dt><dd>${esc(row('teknik'))}</dd><dt>Yasal</dt><dd>${LEGAL_MIN[species]} cm</dd></dl>`;
    } else {
      const t = tackle(input, profiles);
      const row = (k: string) => t.rows.find((r) => r.key === k)?.value ?? '–';
      rig.innerHTML = `${rigSvg(t.jigG, t.zone, t.color)}<dl><dt>Takım</dt><dd>${t.profile === 'lrf' ? 'LRF' : 'Spin'} · ${esc(row('jighead'))}</dd><dt>Silikon</dt><dd>${esc(row('silikon'))}</dd><dt>Renk</dt><dd>${esc(row('renk'))}</dd><dt>Katman</dt><dd>${esc(t.zone)} · say ${esc(row('saydirma'))}</dd><dt>Yasal</dt><dd>${LEGAL_MIN[species]} cm</dd></dl>${t.light === 'bilinmeyen gece' ? '<p class="fs-1 muted" style="grid-column:1/-1;margin:0">Lamba durumu bilinmiyor: "/" öncesi lamba suya düşüyorsa, sonrası karanlıksa.</p>' : ''}`;
    }
  }
  const loadWindows = () => fetch(api('/api/windows', species), { cache: 'no-cache' })
    .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
    .then((b: NonNullable<typeof winBody>) => { winBody = b; renderWindows(); renderPlan(); })
    .catch(() => { $('windows').innerHTML = '<li class="muted">Pencereler alınamadı.</li>'; $('verdict').textContent = 'Öneriler alınamadı (bağlantı ya da sunucu). Liste aşağıda.'; });
  loadWindows();

  // ---------------------------------------------------------------- species (H3)
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.species .sp[data-sp]')];
  const showSpecies = () => {
    chips.forEach((c) => {
      const on = c.dataset.sp === species;
      c.classList.toggle('on', on);
      c.setAttribute('aria-checked', String(on));
    });
    document.title = `av.livn — ${SPECIES_TR[species]}: nereye, ne zaman?`;
  };
  showSpecies();
  chips.forEach((c) => c.addEventListener('click', () => {
    if (c.dataset.sp === species) return;
    species = c.dataset.sp as Species;
    saveSpecies(species);
    const u = new URL(location.href);
    if (species === 'istavrit') u.searchParams.delete('tur'); else u.searchParams.set('tur', species);
    history.replaceState(null, '', u);
    showSpecies();
    details.clear();
    focus = null;
    load();
    loadHours();
    loadWindows();
    mapApi?.setSpecies(species);
  }));

  setCol(0);
  ensureMap();
</script>
