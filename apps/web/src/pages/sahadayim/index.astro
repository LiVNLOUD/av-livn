---
import Base from '../../layouts/Base.astro';
import AdminLogin from '../../components/AdminLogin.astro';
---
<Base title="Sahadayım — av.livn" description="Sahada tek dokunuşla av kaydı.">
  <div class="wrap sd">
    <h1>Sahadayım</h1>

    <!-- J5: three-step hint, first use only (dismissed per device) -->
    <aside class="hint-card" id="first-hint" hidden aria-label="Nasıl kullanılır">
      <ol>
        <li><b>Merayı seç, seansı başlat.</b> Başlarken o anki tahmin bu telefonda saklanır (ileriye dönük kayıt).</li>
        <li><b>Her balığı ya da hiç vuruş yoksa “sıfır av”ı kaydet.</b> Sıfır av da veridir; modeli en çok o sınar.</li>
        <li><b>Bitir ve kaydet.</b> Bağlantı yoksa kayıt sıraya alınır, sonra gönderilir.</li>
      </ol>
      <button type="button" class="ghost" id="hint-ok">Anladım</button>
    </aside>

    <AdminLogin />

    <section id="setup" hidden>
      <h2>Nerede?</h2>
      <p class="hint">Konum yalnız bu telefonda kullanılır; sunucuya yalnız seçtiğiniz meranın kimliği gider.</p>
      <button type="button" id="locate" class="ghost big">📍 Yakındaki meraları bul</button>
      <ol class="near" id="near"></ol>
      <label class="lbl">ya da listeden<select id="spot"></select></label>

      <h2>Yöntem <span class="muted">(seans boyunca; değiştirilebilir)</span></h2>
      <div class="two">
        <label class="lbl">Hedef tür<select id="target"><option value="istavrit">istavrit</option><option value="levrek">levrek</option><option value="lüfer">lüfer / çinekop</option><option value="kolyoz">kolyoz</option><option value="karagöz">karagöz / mırmır</option><option value="sargos">sargos</option><option value="çipura">çipura</option><option value="mezgit">mezgit</option><option value="diger">diğer</option></select></label>
        <label class="lbl">Yöntem<select id="method"><option value="lrf">LRF jighead + silikon</option><option value="mikro_jig">mikro jig</option><option value="capari_tuylu">çapari (tüylü)</option><option value="capari_yemli">çapari (yemli)</option><option value="dropshot_yem">dropshot + yem</option><option value="dip">dip takımı + yem</option><option value="samandira">şamandıralı + yem</option><option value="spin">spin</option><option value="diger">diğer</option></select></label>
        <label class="lbl">Jighead (g)<input id="jig" inputmode="decimal" placeholder="1,5" /></label>
        <label class="lbl">İğne no<input id="hook" placeholder="#8" /></label>
      </div>
      <div class="two">
        <label class="lbl">Silikon boyu (cm)<input id="lurelen" inputmode="decimal" placeholder="5" /></label>
        <label class="lbl">Silikon rengi<input id="lurecol" placeholder="şeffaf-simli" /></label>
      </div>
      <div class="two">
        <label class="lbl">Kamış<input id="rods" inputmode="numeric" value="1" /></label>
        <label class="lbl">Kişi<input id="people" inputmode="numeric" value="1" /></label>
        <label class="lbl">Yem<select id="bait"><option value="">yok (suni)</option><option value="hamsi">hamsi parçası</option><option value="karides">karides</option><option value="midye">midye</option></select></label>
        <label class="lbl">İskele ışığı altında<select id="lamp"><option value="">bilinmiyor</option><option value="1">evet</option><option value="0">hayır</option></select></label>
      </div>
      <button type="button" id="start" class="primary big">Seansı başlat</button>
      <p class="msg" id="msg" role="status"></p>
      <p class="hint" id="pending"></p>
      <p class="hint"><a href="/gunluk/">Geçmiş seans girmek için av günlüğü</a></p>
    </section>
  </div>

  <section id="live" class="live" hidden aria-label="Seans">
    <!-- V2.6: separate from the plan screen — big clock, spot, wind/gust/rain at a glance, the rig in use, the time
         fished and the last tackle change; four large controls fixed at the bottom (wet hands, no sideways scroll) -->
    <header class="lv-top">
      <div class="lv-clock" id="l-clock">--:--</div>
      <div class="lv-id"><b id="l-spot"></b><span id="l-time">0:00</span></div>
      <button type="button" id="red" aria-pressed="false" title="Kırmızı gece modu">●</button>
    </header>
    <p class="lv-wx" id="l-wx" aria-label="Hava"></p>
    <p class="lv-sec" id="l-sec"></p>
    <div class="lv-rig" id="l-rig"></div>
    <details class="lv-info" id="l-info" hidden><summary>Kısa uygulama bilgisi</summary><ol id="l-steps"></ol><p class="lv-note" id="l-tk"></p></details>
    <p class="lv-warn" id="l-warn" role="status"></p>
    <ol class="log" id="log"></ol>
    <div class="lv-minor">
      <button type="button" id="undo">Geri al</button>
      <button type="button" id="len">Boy</button>
      <button type="button" id="kg">Kg</button>
      <button type="button" id="chg-method">Yöntem</button>
      <button type="button" id="pause" aria-pressed="false">Mola</button>
      <button type="button" id="finish" class="fin">Bitir</button>
    </div>
    <div class="lv-main">
      <button type="button" id="bite" class="act"><span class="n" id="bites">0</span><span>Vuruş aldım</span></button>
      <button type="button" id="plus" class="act fish" aria-describedby="plus-hint"><span class="n" id="count">0</span><span id="plus-label">Balık aldım</span><span class="ph" id="plus-hint">uzun bas: tür</span></button>
      <button type="button" id="nothing" class="act" aria-pressed="false"><span class="n">0</span><span>Sonuç yok</span></button>
      <button type="button" id="depth" class="act"><span class="n" id="depth-v">—</span><span>Dip: __ m</span></button>
    </div>
    <div class="sheet" id="species" hidden role="dialog" aria-label="Tür seç">
      <button type="button" data-sp="istavrit">istavrit</button>
      <button type="button" data-sp="izmarit">izmarit</button>
      <button type="button" data-sp="levrek">levrek</button>
      <button type="button" data-sp="lüfer">lüfer</button>
      <button type="button" data-sp="mırmır">mırmır</button>
      <button type="button" data-sp="kolyoz">kolyoz</button>
      <button type="button" data-sp="diğer">diğer</button>
      <button type="button" data-sp="" class="cancel">Vazgeç</button>
    </div>
    <div class="sheet" id="end" hidden role="dialog" aria-label="Seansı bitir">
      <p id="e-sum"></p>
      <label class="lbl">Aktif avlanma (dk)<input id="e-active" inputmode="numeric" /></label>
      <label class="lbl">Not<input id="e-note" maxlength="200" /></label>
      <button type="button" id="e-save" class="primary">Kaydet</button>
      <button type="button" id="e-zero" class="ghost">Sıfır av olarak kaydet</button>
      <button type="button" id="e-back" class="cancel">Devam et</button>
    </div>
  </section>
</Base>

<style>
  .hint-card { border: 1px solid var(--sodium, #f2a93b); border-radius: 12px; padding: 12px 16px; margin: 12px 0; background: var(--deep); }
  .hint-card ol { margin: 0 0 8px; padding-left: 1.2em; display: grid; gap: 6px; font-size: var(--fs-2); }
  .hint-card button { min-height: 44px; }
  .sd h1 { font-size: var(--fs-5); font-weight: 750; font-stretch: 80%; margin: 14px 0 6px; }
  .sd h2 { font-size: var(--fs-3); margin: 20px 0 8px; }
  .sd h2 .muted { font-weight: 400; font-size: var(--fs-2); }
  .hint { font-size: var(--fs-2); color: var(--mist); margin: 4px 0 10px; }
  .stack { display: grid; gap: 12px; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 10px; }
  .lbl { display: grid; gap: 4px; font-size: var(--fs-2); color: var(--mist); }
  input, select { min-height: 52px; font-size: var(--fs-3); }
  button { font: inherit; }
  .big { width: 100%; min-height: 60px; font-size: var(--fs-3); margin: 8px 0; }
  .primary { background: var(--sodium); color: #1a1205; border: 0; border-radius: 12px; font-weight: 750; min-height: 56px; }
  .ghost { background: transparent; color: var(--foam); border: 1px solid var(--swell); border-radius: 12px; min-height: 56px; font-weight: 650; }
  .near { list-style: none; padding: 0; margin: 0 0 10px; display: grid; gap: 8px; }
  .near :global(button) { width: 100%; text-align: left; min-height: 64px; padding: 8px 14px; border-radius: 12px; border: 1px solid var(--swell); background: transparent; color: var(--foam); }
  .near :global(button.on) { border-color: var(--sodium); box-shadow: inset 0 0 0 1px var(--sodium); }
  .near :global(small) { display: block; color: var(--mist); font-size: var(--fs-1); }
  .msg { min-height: 1.4em; font-size: var(--fs-2); }
  .msg.err { color: var(--storm); }

  /* V2.6 live session: full screen, separate from the plan; glove targets ≥ 64 px, four main controls fixed at the bottom */
  .live { position: fixed; inset: 0; z-index: 40; background: var(--ink-0); color: var(--fg-1); overflow-y: auto; overflow-x: hidden;
    padding: calc(10px + env(safe-area-inset-top)) 12px calc(12px + 2 * 72px + 76px + env(safe-area-inset-bottom)); display: grid; gap: 8px; align-content: start; }
  .lv-top { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 10px; align-items: center; }
  .lv-clock { font-size: 2.6rem; font-weight: 800; font-variant-numeric: tabular-nums; line-height: 1; }
  .lv-id { min-width: 0; }
  .lv-id b { display: block; font-size: var(--fs-3); line-height: 1.2; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .lv-id span { color: var(--fg-2); font-size: var(--fs-2); font-variant-numeric: tabular-nums; }
  #red { min-width: 56px; min-height: 56px; border-radius: 14px; border: 1px solid var(--line); background: var(--ink-2); color: var(--fg-1); font-size: 1.4rem; }
  .lv-wx { margin: 0; display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: var(--fs-3); font-weight: 650; }
  .lv-wx :global(.arr) { display: inline-block; font-size: 1.2em; line-height: 1; }
  .lv-sec { margin: 0; font-size: var(--fs-2); color: var(--fg-2); }
  .lv-rig { display: grid; justify-items: center; }
  .lv-rig :global(svg) { width: min(100%, 300px); max-height: 34vh; }
  .lv-info summary { min-height: 44px; display: flex; align-items: center; font-weight: 650; cursor: pointer; }
  .lv-info ol { margin: 0; padding-left: 1.2em; font-size: var(--fs-2); display: grid; gap: 2px; }
  .lv-note { font-size: var(--fs-2); color: var(--fg-2); margin: 6px 0 0; }
  .lv-warn { margin: 0; color: var(--warn); font-weight: 650; font-size: var(--fs-2); min-height: 0; }
  .lv-warn:empty { display: none; }
  .lv-minor { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; position: fixed; left: 12px; right: 12px; bottom: calc(12px + 2 * 72px + 16px + env(safe-area-inset-bottom)); }
  .lv-minor button { min-height: 52px; border-radius: 12px; border: 1px solid var(--line); background: var(--ink-2); color: var(--fg-1); font-weight: 700; font-size: var(--fs-2); }
  .lv-minor button[aria-pressed='true'] { background: var(--line-2); }
  .lv-minor .fin { border-color: var(--fg-1); }
  .lv-main { position: fixed; left: 12px; right: 12px; bottom: calc(12px + env(safe-area-inset-bottom)); display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .act { min-height: 72px; border-radius: 16px; border: 1px solid var(--line-2); background: var(--ink-2); color: var(--fg-1); display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 0 10px; padding: 6px 14px; text-align: left; font-weight: 750; font-size: var(--fs-3); touch-action: manipulation; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; }
  .act .n { grid-row: span 2; font-size: 1.9rem; font-weight: 800; font-variant-numeric: tabular-nums; min-width: 1.6ch; text-align: center; }
  .act .ph { font-size: var(--fs-1); font-weight: 500; opacity: .8; }
  .act.fish { background: var(--act); color: var(--act-ink); border-color: var(--act); }
  .act[aria-pressed='true'] { border-color: var(--warn); box-shadow: inset 0 0 0 2px var(--warn); }
  .act:active { transform: scale(0.985); }
  .log { list-style: none; margin: 0; padding: 0; font-size: var(--fs-2); color: var(--fg-2); }
  .log :global(li) { display: flex; justify-content: space-between; gap: 10px; padding: 6px 2px; border-bottom: 1px solid var(--line); }
  .sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; background: var(--ink-1); border-top: 2px solid var(--act); padding: 16px 12px calc(16px + env(safe-area-inset-bottom)); display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .sheet[hidden] { display: none; }
  .sheet > button { min-height: 64px; border-radius: 14px; border: 1px solid var(--line); background: var(--ink-2); color: var(--fg-1); font-size: var(--fs-3); font-weight: 700; }
  #end { grid-template-columns: 1fr; }
  #end p { margin: 0; }
  .cancel { background: transparent !important; }

  /* red night mode: keeps dark adaptation; deep red on black, no bright panel. Reds lightened to pass AA on black
     (V0b: #ff3b2f 5,9:1, #f0362a 5,3:1; the old #c0261c 3,5:1 and #9c1f17 2,6:1 did not) */
  :global(body.red), :global(body.red) .live, :global(body.red) .sheet { background: #000 !important; color: #ff3b2f !important; }
  :global(body.red) .live button, :global(body.red) .sheet button, :global(body.red) .sheet input { background: #160302 !important; color: #ff3b2f !important; border-color: #5a0d08 !important; }
  :global(body.red) .act.fish { background: #3a0805 !important; color: #ff3b2f !important; }
  :global(body.red) .lv-id span, :global(body.red) .log, :global(body.red) .lv-sec, :global(body.red) .lv-note { color: #f0362a !important; }
  :global(body.red) .log :global(li) { border-color: #2a0604; }
  :global(body.red) .lv-rig :global(svg *) { stroke: #f0362a !important; fill: none !important; }
  :global(body.red) .lv-rig :global(svg text) { fill: #f0362a !important; stroke: none !important; }
</style>

<script>
  import { getToken, mountLogin } from '../../scripts/admin';
  {
    const HINT = 'av-livn-saha-hint';
    const card = document.getElementById('first-hint')!;
    let seen = false;
    try { seen = localStorage.getItem(HINT) === '1'; } catch {}
    card.hidden = seen;
    document.getElementById('hint-ok')!.addEventListener('click', () => { card.hidden = true; try { localStorage.setItem(HINT, '1'); } catch {} });
  }
  import { LEGAL_MIN_CM } from '../../scripts/format';
  import { bagCheck, sizeWarning, tackle, tackleLevrek, tackleLevrekLine, tackleLine, type MethodId } from '@av-livn/scoring';
  import { rigScene, sinkerFor } from '../../scripts/rigscene';
  import { frameIndex, loadGrid, nearest } from '../../scripts/layers';
  import { compass8 } from '../../scripts/plan';
  import { loadMy, toProfiles } from '../../scripts/mytackle';
  const myProfiles = toProfiles(loadMy()).profiles;
  import { api as speciesUrl, currentSpecies } from '../../scripts/species';

  type Spot = { id: string; name: string; lat: number; lon: number; place: string | null };
  type Fish = { t: number; species: string; length_cm: number | null };
  type Method = { jig_g?: number; hook_no?: string; lure_len_cm?: number; lure_color?: string; under_lamp?: boolean; rods: number; target_species?: string; method?: string; bait?: string; people?: number };
  /** I6: the forecast shown before the start, kept on the device and sent with the session (prospective). */
  type StartForecast = { captured_at: string; model_version: string; species: string; hours: { hour: number; total: number | null; p10: number | null; p90: number | null; rank: number | null }[] };
  // V2.5: a segment is a method section of the outing: its own effort, bites (vuruş) and catch; "Sonuç yok" is explicit
  type Seg = { start: number; end?: number; method: Method; fish: Fish[]; pausedMs: number; bites?: number; zero?: boolean };
  type Live = { spot: Spot; segs: Seg[]; pauseAt: number | null; forecast?: StartForecast | null; people?: number; kg?: { total: number; largest: number } | null; depth?: number | null; depthMsg?: string };
  const METHOD_TR: Record<string, string> = { lrf: 'LRF', mikro_jig: 'mikro jig', capari_tuylu: 'çapari (tüylü)', capari_yemli: 'çapari (yemli)', dropshot_yem: 'dropshot + yem', dip: 'dip takımı', samandira: 'şamandıra', spin: 'spin', diger: 'diğer', capari: 'çapari (tüylü)' };
  const BAIT_TR: Record<string, string> = { hamsi: 'hamsi', karides: 'karides', midye: 'midye' };
  /** Old saved choices (I6 methods) → V2 pool. */
  const v2method = (m: string | undefined) => (m === 'capari' ? 'capari_tuylu' : m ?? 'lrf');

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const LIVE = 'av-livn-live-session';
  const QUEUE = 'av-livn-catch-queue'; // shared with /gunluk/
  const METHOD = 'av-livn-last-method';
  const RED = 'av-livn-red';
  const store = {
    get: <T,>(k: string, d: T): T => { try { const v = localStorage.getItem(k); return v ? (JSON.parse(v) as T) : d; } catch { return d; } },
    set: (k: string, v: unknown) => { try { if (v === null) localStorage.removeItem(k); else localStorage.setItem(k, JSON.stringify(v)); } catch {} },
  };
  let token = getToken();
  let spots: Spot[] = [];
  let chosen: Spot | null = null;
  let live: Live | null = store.get<Live | null>(LIVE, null);

  function say(t: string, err = false) { const m = $('msg'); m.textContent = t; m.classList.toggle('err', err); }
  const num = (id: string) => { const v = $<HTMLInputElement>(id).value.trim().replace(',', '.'); return v === '' ? undefined : Number(v); };
  const txt = (id: string) => $<HTMLInputElement>(id).value.trim() || undefined;
  const km = (a: { lat: number; lon: number }, b: { lat: number; lon: number }) => {
    const r = Math.PI / 180;
    const h = Math.sin(((b.lat - a.lat) * r) / 2) ** 2 + Math.cos(a.lat * r) * Math.cos(b.lat * r) * Math.sin(((b.lon - a.lon) * r) / 2) ** 2;
    return 2 * 6371 * Math.asin(Math.sqrt(h));
  };

  async function api(path: string, method: string, body?: unknown) {
    const r = await fetch(path, { method, headers: { authorization: `Bearer ${token}`, 'content-type': 'application/json' }, body: body ? JSON.stringify(body) : undefined });
    const j = await r.json().catch(() => ({}));
    if (!r.ok) { const e = new Error(j.error ?? String(r.status)) as Error & { fatal?: boolean }; e.fatal = r.status >= 400 && r.status < 500; throw e; }
    return j;
  }

  // ---------------------------------------------------------------- setup
  function methodFromForm(): Method {
    const lamp = $<HTMLSelectElement>('lamp').value;
    return { jig_g: num('jig'), hook_no: txt('hook'), lure_len_cm: num('lurelen'), lure_color: txt('lurecol'), under_lamp: lamp === '' ? undefined : lamp === '1', rods: Math.max(1, Math.round(num('rods') ?? 1)),
      target_species: $<HTMLSelectElement>('target').value, method: $<HTMLSelectElement>('method').value,
      bait: $<HTMLSelectElement>('bait').value || undefined, people: Math.min(20, Math.max(1, Math.round(num('people') ?? 1))) };
  }
  function methodToForm(m: Partial<Method>) {
    const set = (id: string, v: unknown) => ($<HTMLInputElement>(id).value = v === undefined || v === null ? '' : String(v).replace('.', ','));
    set('jig', m.jig_g); set('hook', m.hook_no); set('lurelen', m.lure_len_cm); set('lurecol', m.lure_color); set('rods', m.rods ?? 1);
    $<HTMLSelectElement>('lamp').value = m.under_lamp === undefined ? '' : m.under_lamp ? '1' : '0';
    if (m.target_species) $<HTMLSelectElement>('target').value = m.target_species;
    $<HTMLSelectElement>('method').value = v2method(m.method);
    $<HTMLSelectElement>('bait').value = m.bait ?? '';
    set('people', m.people ?? 1);
  }
  /** I6: capture the public forecast for the next 6 hours at the start (best effort; offline → none). */
  async function captureForecast(spotId: string, sp: 'istavrit' | 'levrek'): Promise<StartForecast | null> {
    try {
      const r = await fetch(speciesUrl(`/api/spots/${encodeURIComponent(spotId)}`, sp), { cache: 'no-cache' });
      if (!r.ok) return null;
      const b = await r.json() as { from: number; ranks?: number[]; packed: { meta: { model_version: string }; h: (string | number | null)[][] } | null };
      if (!b.packed) return null;
      const hours = b.packed.h.slice(b.from, b.from + 6).map((h, k) => ({ hour: Math.floor(Date.parse(String(h[0])) / 3_600_000), total: h[1] as number | null, p10: h[3] as number | null, p90: h[4] as number | null, rank: b.ranks?.[k] ?? null }));
      return { captured_at: new Date().toISOString(), model_version: b.packed.meta.model_version, species: sp, hours };
    } catch {
      return null;
    }
  }
  function choose(s: Spot) {
    chosen = s;
    $<HTMLSelectElement>('spot').value = s.id;
    $('near').querySelectorAll('button').forEach((b) => b.classList.toggle('on', b.dataset.id === s.id));
  }
  async function setup() {
    $('login').hidden = true;
    $('setup').hidden = false;
    methodToForm(store.get<Partial<Method>>(METHOD, { rods: 1 }));
    const pend = store.get<unknown[]>(QUEUE, []).length;
    $('pending').textContent = pend ? `${pend} seans gönderilmeyi bekliyor (bağlantı gelince otomatik).` : '';
    const b = await fetch('/api/spots', { cache: 'no-cache' }).then((r) => r.json()).catch(() => ({ spots: [] }));
    spots = (b.spots as Spot[]).sort((a, c) => a.name.localeCompare(c.name, 'tr'));
    $('spot').innerHTML = '<option value="">Mera seçin</option>' + spots.map((s) => `<option value="${s.id}">${s.name.replace(/</g, '&lt;')}</option>`).join('');
  }
  $('spot').addEventListener('change', () => { const s = spots.find((x) => x.id === $<HTMLSelectElement>('spot').value); if (s) choose(s); });
  $('locate').addEventListener('click', () => {
    if (!navigator.geolocation) return say('Bu cihazda konum yok; listeden seçin.', true);
    say('Konum alınıyor…');
    navigator.geolocation.getCurrentPosition(
      (p) => {
        const me = { lat: p.coords.latitude, lon: p.coords.longitude };
        const near = spots.map((s) => ({ s, d: km(me, s) })).sort((a, b) => a.d - b.d).slice(0, 3);
        $('near').innerHTML = near.map(({ s, d }) => `<li><button type="button" data-id="${s.id}">${s.name.replace(/</g, '&lt;')}<small>${d < 1 ? `${Math.round(d * 1000)} m` : `${d.toFixed(1).replace('.', ',')} km`}${s.place ? ` · ${s.place}` : ''}</small></button></li>`).join('');
        $('near').querySelectorAll<HTMLButtonElement>('button').forEach((btn) => btn.addEventListener('click', () => choose(spots.find((x) => x.id === btn.dataset.id)!)));
        if (near[0]) choose(near[0].s);
        say('');
      },
      () => say('Konum alınamadı; listeden seçin.', true),
      { enableHighAccuracy: true, timeout: 15000, maximumAge: 60000 },
    );
  });
  let changingMethod = false;
  $('start').addEventListener('click', () => {
    const m = methodFromForm();
    store.set(METHOD, m);
    if (changingMethod && live) {
      // A method change closes the current segment: each segment is saved as its own session (one method each).
      resume();
      seg().end = Date.now();
      live.segs.push({ start: Date.now(), method: m, fish: [], pausedMs: 0, bites: 0 });
      changingMethod = false;
      $('start').textContent = 'Seansı başlat';
      drawRig();
    } else {
      if (!chosen) return say('Önce mera seçin.', true);
      live = { spot: chosen, segs: [{ start: Date.now(), method: m, fish: [], pausedMs: 0, bites: 0 }], pauseAt: null, forecast: null, people: m.people ?? 1, kg: null, depth: null };
      const target: 'istavrit' | 'levrek' = m.target_species === 'levrek' ? 'levrek' : 'istavrit';
      captureForecast(chosen.id, target).then((f) => { if (live && f) { live.forecast = f; save(); } });
    }
    save();
    enter();
  });

  // ---------------------------------------------------------------- live session
  const seg = () => live!.segs[live!.segs.length - 1]!;
  const allFish = () => live!.segs.flatMap((s) => s.fish);
  function save() { store.set(LIVE, live); }
  let wake: { release: () => Promise<void> } | null = null;
  async function lock() {
    try { wake = await (navigator as Navigator & { wakeLock?: { request: (t: 'screen') => Promise<{ release: () => Promise<void> }> } }).wakeLock?.request('screen') ?? null; } catch { wake = null; }
  }
  document.addEventListener('visibilitychange', () => { if (live && document.visibilityState === 'visible') lock(); });

  function enter() {
    $('live').hidden = false;
    document.body.style.overflow = 'hidden';
    $('l-spot').textContent = live!.spot.name;
    // F0 short tackle line for this hour (open data; the full box is on the spot card)
    // H3: the tackle line follows the selected species (home page choice / ?tur=)
    const sp = currentSpecies();
    fetch(speciesUrl(`/api/spots/${encodeURIComponent(live!.spot.id)}`, sp)).then((r) => (r.ok ? r.json() : null)).then((b) => {
      const v = b?.packed?.tk?.[b.from];
      if (!v) return;
      const input = { depthM: v[0] ?? 3, currentMs: v[1], windKmh: v[2], gustKmh: v[3], crossKmh: v[4], sunAlt: v[5] ?? 0, lampP: v[6], turbidity: v[7], sstDev: v[8], waveM: v[9] ?? null, kind: b?.spot?.kind };
      $('l-tk').textContent = sp === 'levrek' ? `Levrek: ${tackleLevrekLine(tackleLevrek(input, myProfiles))}` : tackleLine(tackle(input, myProfiles));
      here = { depthM: input.depthM, currentMs: input.currentMs ?? null, wind: input.windKmh ?? null, gust: input.gustKmh ?? null };
      drawRig();
      drawWx();
    }).catch(() => {});
    loadGrid('wx').then((g) => { grid = g; drawWx(); }).catch(() => {});
    lock();
    drawRig();
    draw();
  }
  // V2.6: glance line — wind direction and speed, gust, rain at this hour (no moving graphics)
  let here: { depthM: number; currentMs: number | null; wind: number | null; gust: number | null } | null = null;
  let grid: Awaited<ReturnType<typeof loadGrid>> | null = null;
  function drawWx() {
    if (!live) return;
    const hour = Math.floor(Date.now() / 3_600_000);
    const k = grid ? frameIndex(grid, hour) : null;
    const wd = grid && k !== null ? nearest(grid, grid.vars.wd?.[k] ?? [], live.spot.lon, live.spot.lat) : null;
    const pr = grid && k !== null ? nearest(grid, grid.vars.pr?.[k] ?? [], live.spot.lon, live.spot.lat) : null;
    const f0 = (x: number | null | undefined) => (x == null ? '–' : String(Math.round(x)));
    $('l-wx').innerHTML = [
      `<span><span class="arr" style="transform:rotate(${wd ?? 0}deg)" aria-hidden="true">↓</span> rüzgar ${f0(here?.wind)} km/sa${wd !== null ? ` ${compass8(wd)}` : ''}</span>`,
      `<span>hamle ${f0(here?.gust)}</span>`,
      `<span>${pr === null ? 'yağış –' : pr / 10 < 0.1 ? 'yağış yok' : `yağış ${(pr / 10).toFixed(1).replace('.', ',')} mm/sa`}</span>`,
    ].join('');
  }
  // V2.9: the folded how-to is shown only when it has something in it (steps or the tackle line)
  const syncInfo = () => { $('l-info').hidden = !$('l-steps').textContent!.trim() && !$('l-tk').textContent!.trim(); };
  // the rig in use, drawn large; the short how-to is folded away
  function drawRig() {
    if (!live) return;
    const m = seg().method;
    const id = v2method(m.method) as MethodId;
    if (!(['lrf', 'mikro_jig', 'capari_tuylu', 'capari_yemli', 'dropshot_yem', 'dip', 'samandira'] as string[]).includes(id)) { $('l-rig').innerHTML = ''; $('l-steps').innerHTML = ''; syncInfo(); return; }
    const sc = rigScene(id, 'bagla', { jigG: m.jig_g, lureCm: m.lure_len_cm, color: m.lure_color, bait: (m.bait as never) ?? null, sinkerG: here ? sinkerFor(here.depthM, here.currentMs) : undefined });
    $('l-rig').innerHTML = sc.svg;
    $('l-steps').innerHTML = rigScene(id, 'kullan').steps.map((x) => `<li>${x}</li>`).join('');
    syncInfo();
  }
  setInterval(() => { if (live && !$('live').hidden) $('l-clock').textContent = new Date().toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }, 5000);
  function activeMs(s: Seg, end = Date.now()) {
    const paused = s.pausedMs + (live!.pauseAt && s === seg() && !s.end ? end - live!.pauseAt : 0);
    return Math.max(0, end - s.start - paused);
  }
  function draw() {
    const fish = allFish();
    $('count').textContent = String(fish.length);
    const ms = live!.segs.reduce((a, s) => a + activeMs(s, s.end), 0);
    const min = Math.floor(ms / 60000);
    $('l-time').textContent = `${Math.floor(min / 60)}:${String(min % 60).padStart(2, '0')}${live!.pauseAt ? ' · mola' : ''}${min >= 10 && fish.length ? ` · ${(fish.length / (ms / 3_600_000)).toFixed(1).replace('.', ',')}/sa` : ''}`;
    $('pause').setAttribute('aria-pressed', String(!!live!.pauseAt));
    $('l-clock').textContent = new Date().toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    const sg = seg();
    const n = live!.segs.length;
    const secMin = Math.round(activeMs(sg) / 60000);
    $('l-sec').textContent = `Bölüm ${n} · ${METHOD_TR[v2method(sg.method.method)] ?? sg.method.method}${sg.method.bait ? ` + ${BAIT_TR[sg.method.bait]}` : ''} · ${secMin} dk · ${n > 1 ? `son takım değişimi ${new Date(sg.start).toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' })}` : `başlangıç ${new Date(sg.start).toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' })}`}`;
    $('bites').textContent = String(sg.bites ?? 0);
    $('count').textContent = String(sg.fish.length);
    $('nothing').setAttribute('aria-pressed', String(!!sg.zero));
    $('depth-v').textContent = live!.depth != null ? String(live!.depth).replace('.', ',') : '—';
    // per-section size warnings (regulation.ts) and the bag check on the entered weight, per person (md. 15(4))
    const warn: string[] = [];
    const small = sg.fish.filter((f) => sizeWarning(f.species, f.length_cm));
    if (small.length) warn.push(`Bu bölümde ${small.length} balık yasal boyun altında — denize geri bırakın.`);
    if (live!.kg) { const b = bagCheck(live!.kg.total / (live!.people ?? 1), live!.kg.largest); if (b.level !== 'ok') warn.push(b.text); }
    if (live!.depthMsg) warn.push(live!.depthMsg);
    $('l-warn').textContent = warn.join(' ');
    $('log').innerHTML = [...fish].reverse().slice(0, 30).map((f) => `<li><span>${new Date(f.t).toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' })} ${f.species}</span><span>${f.length_cm ? `${String(f.length_cm).replace('.', ',')} cm${sizeWarning(f.species, f.length_cm) ? ` ⚠ ${LEGAL_MIN_CM[f.species]} cm altı` : ''}` : ''}</span></li>`).join('');
  }
  setInterval(() => live && !$('live').hidden && draw(), 15000);

  function add(species: string) {
    if (live!.pauseAt) resume();
    seg().fish.push({ t: Date.now(), species, length_cm: null });
    seg().zero = false;
    navigator.vibrate?.(30);
    save();
    draw();
  }
  // tap = +1 istavrit; long press (≥ 550 ms) = species sheet
  let timer: number | undefined;
  let longFired = false;
  const plus = $('plus');
  plus.addEventListener('pointerdown', () => { longFired = false; timer = window.setTimeout(() => { longFired = true; navigator.vibrate?.(60); $('species').hidden = false; }, 550); });
  ['pointerup', 'pointerleave', 'pointercancel'].forEach((ev) => plus.addEventListener(ev, () => clearTimeout(timer)));
  plus.addEventListener('click', () => { if (!longFired) add('istavrit'); });
  plus.addEventListener('contextmenu', (e) => e.preventDefault());
  $('species').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button');
    if (!b) return;
    $('species').hidden = true;
    if (b.dataset.sp) add(b.dataset.sp);
  });
  $('undo').addEventListener('click', () => {
    for (let i = live!.segs.length - 1; i >= 0; i--) if (live!.segs[i]!.fish.pop()) break;
    save();
    draw();
  });
  $('len').addEventListener('click', () => {
    const f = [...allFish()].reverse().find((x) => x.length_cm === null) ?? allFish().at(-1);
    if (!f) return;
    const v = prompt(`Son ${f.species} boyu (cm) — tam boy: ağız kapalı, baş ucundan kuyruk yüzgecinin en uzun ışınının ucuna (md. 3)`, f.length_cm ? String(f.length_cm) : '');
    if (v === null) return;
    const n = Number(v.replace(',', '.'));
    f.length_cm = v.trim() === '' || !(n > 0 && n < 150) ? null : n;
    save();
    draw();
  });
  function resume() {
    if (!live!.pauseAt) return;
    seg().pausedMs += Date.now() - live!.pauseAt;
    live!.pauseAt = null;
  }
  $('pause').addEventListener('click', () => { if (live!.pauseAt) resume(); else live!.pauseAt = Date.now(); save(); draw(); });
  // V2.5: the four main controls — bite, fish (above), nothing, depth — and the bag weight
  $('bite').addEventListener('click', () => { if (live!.pauseAt) resume(); seg().bites = (seg().bites ?? 0) + 1; navigator.vibrate?.(20); save(); draw(); });
  $('nothing').addEventListener('click', () => { const sg = seg(); if (sg.fish.length) return; sg.zero = !sg.zero; save(); draw(); });
  $('depth').addEventListener('click', async () => {
    const v = prompt('Dip (m): kurşun dibe değdiğinde okunan derinlik', live!.depth ? String(live!.depth).replace('.', ',') : '');
    if (v === null || v.trim() === '') return;
    const d = Number(v.replace(',', '.'));
    if (!(d > 0 && d < 200)) return;
    live!.depth = d;
    save();
    draw();
    const body = { depth_m: d, at: new Date().toISOString() };
    try {
      const j = await api(`/api/admin/spots/${encodeURIComponent(live!.spot.id)}/depth`, 'POST', body);
      if (live) { live.depthMsg = j.status === 'onayli' ? `Dip ${v} m kaydedildi; puan güncelleniyor.` : 'Dip kaydedildi; tutarlılık denetiminden geçmedi, yönetici onayını bekliyor.'; save(); draw(); }
    } catch (e) {
      if (!(e as { fatal?: boolean }).fatal) { store.set(QUEUE, [...store.get<unknown[]>(QUEUE, []), { kind: 'depth', spot: live!.spot.id, body }]); if (live) { live.depthMsg = `Dip ${v} m telefona kaydedildi; bağlantı gelince gönderilecek.`; save(); draw(); } }
    }
  });
  $('kg').addEventListener('click', () => {
    const t = prompt(`Toplam ağırlık (kg, ${live!.people ?? 1} kişinin toplamı)`, live!.kg ? String(live!.kg.total).replace('.', ',') : '');
    if (t === null) return;
    const total = Number(t.replace(',', '.'));
    if (!(total > 0 && total < 100)) { live!.kg = null; save(); draw(); return; }
    const l = prompt('En büyük balık (kg, bilmiyorsanız boş)', '');
    const largest = l ? Number(l.replace(',', '.')) : 0;
    live!.kg = { total, largest: largest > 0 && largest < total ? largest : 0 };
    save();
    draw();
  });
  $('chg-method').addEventListener('click', () => {
    $('live').hidden = true;
    document.body.style.overflow = '';
    methodToForm(seg().method);
    changingMethod = true;
    $('start').textContent = 'Yeni yöntemle devam et';
    window.scrollTo(0, document.body.scrollHeight);
  });

  const red = $('red');
  const setRed = (on: boolean) => { document.body.classList.toggle('red', on); red.setAttribute('aria-pressed', String(on)); store.set(RED, on); };
  red.addEventListener('click', () => setRed(!document.body.classList.contains('red')));
  setRed(store.get(RED, false));

  // ---------------------------------------------------------------- finish
  function payloads(zero: boolean, activeTotal: number | undefined, note: string | undefined) {
    const now = Date.now();
    const segs = live!.segs;
    const totalActive = segs.reduce((a, s) => a + activeMs(s, s.end ?? now), 0);
    return segs
      .map((s, i) => {
        const end = s.end ?? (i < segs.length - 1 ? segs[i + 1]!.start : now);
        let act = Math.max(1, Math.round(activeMs(s, end) / 60000));
        if (activeTotal !== undefined && totalActive > 0) act = Math.max(1, Math.round((activeTotal * activeMs(s, end)) / totalActive));
        const span = Math.max(1, Math.round((end - s.start) / 60000));
        const bySp = new Map<string, number>();
        const items: { species: string; count: number; length_cm?: number }[] = [];
        for (const f of s.fish) {
          if (f.length_cm) items.push({ species: f.species, count: 1, length_cm: f.length_cm });
          else bySp.set(f.species, (bySp.get(f.species) ?? 0) + 1);
        }
        for (const [species, count] of bySp) items.push({ species, count });
        const tm = v2method(s.method.method);
        return {
          spot_id: live!.spot.id, start_at: new Date(s.start).toISOString(), end_at: new Date(Math.max(end, s.start + 60000)).toISOString(),
          active_min: Math.min(act, span), rods: s.method.rods, jig_g: s.method.jig_g, hook_no: s.method.hook_no, lure_len_cm: s.method.lure_len_cm,
          lure_color: s.method.lure_color, under_lamp: s.method.under_lamp, zero_catch: zero || items.length === 0, items, note,
          target_species: s.method.target_species ?? 'istavrit', tackle_method: tm, bait: s.method.bait, bites: s.bites ?? 0,
          // the start forecast belongs to the first segment only (later segments started after it was captured)
          start_forecast: i === 0 ? live!.forecast ?? undefined : undefined,
        };
      })
      // A method tried without a catch is a zero-catch session for that method; only sub-minute empty segments are dropped.
      .filter((p, i, arr) => p.items.length > 0 || arr.length === 1 || !!segs[i]!.zero || Date.parse(p.end_at) - Date.parse(p.start_at) >= 120_000);
  }
  $('finish').addEventListener('click', () => {
    resume();
    const n = allFish().length;
    const ms = live!.segs.reduce((a, s) => a + activeMs(s, s.end), 0);
    $<HTMLInputElement>('e-active').value = String(Math.max(1, Math.round(ms / 60000)));
    $('e-sum').textContent = n ? `${n} balık, ${live!.segs.length > 1 ? `${live!.segs.length} yöntemle ` : ''}kaydedilecek.` : 'Hiç balık girilmedi. Sıfır av ise açıkça seçin.';
    $('e-save').hidden = n === 0;
    $('end').hidden = false;
  });
  $('e-back').addEventListener('click', () => ($('end').hidden = true));
  async function finish(zero: boolean) {
    const act = Number($<HTMLInputElement>('e-active').value) || undefined;
    const note = $<HTMLInputElement>('e-note').value.trim() || undefined;
    const sections = payloads(zero, act, undefined);
    // V2.5: one outing with its method sections (the independent unit, D5); sections keep their own effort, bites, catch
    const outing = { spot_id: live!.spot.id, start_at: sections[0]!.start_at, end_at: sections[sections.length - 1]!.end_at, people: live!.people ?? 1, note, sections };
    const left: unknown[] = [];
    let warn: string[] = [];
    try { const j = await api('/api/admin/catch/outing', 'POST', outing); warn = warn.concat(j.warnings ?? []); }
    catch (e) { if ((e as { fatal?: boolean }).fatal) { say(`Kaydedilmedi: ${(e as Error).message}`, true); return; } left.push({ kind: 'outing', body: outing }); }
    if (left.length) store.set(QUEUE, [...store.get<unknown[]>(QUEUE, []), ...left]);
    live = null;
    store.set(LIVE, null);
    await wake?.release().catch(() => {});
    $('end').hidden = true;
    $('live').hidden = true;
    document.body.style.overflow = '';
    say(left.length ? 'Bağlantı yok: seans telefona kaydedildi, bağlantı gelince gönderilecek.' : `Seans kaydedildi.${warn.length ? ' ' + warn.join(' ') : ''}`, !!left.length);
    setup();
  }
  $('e-save').addEventListener('click', () => finish(false));
  $('e-zero').addEventListener('click', () => finish(true));

  async function flush() {
    const q = store.get<unknown[]>(QUEUE, []);
    if (!q.length || !token) return;
    const left = [];
    for (const b of q as { kind?: string; body?: unknown; spot?: string }[]) {
      // queued items: an outing (V2.5), a depth entry, or an older single session
      const [path, body] = b.kind === 'outing' ? ['/api/admin/catch/outing', b.body] : b.kind === 'depth' ? [`/api/admin/spots/${encodeURIComponent(b.spot!)}/depth`, b.body] : ['/api/admin/catch', b];
      try { await api(path, 'POST', body); } catch (e) { if (!(e as { fatal?: boolean }).fatal) left.push(b); }
    }
    store.set(QUEUE, left);
    $('pending').textContent = left.length ? `${left.length} seans gönderilmeyi bekliyor.` : '';
  }
  window.addEventListener('online', flush);

  mountLogin(document.getElementById('login') as HTMLFormElement, async () => {
    token = getToken();
    await setup().then(flush);
    if (live) enter();
  });
</script>
