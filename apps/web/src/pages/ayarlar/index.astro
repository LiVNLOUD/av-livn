---
import Base from '../../layouts/Base.astro';
import AdminLogin from '../../components/AdminLogin.astro';
---
<Base title="Bildirim ayarları — av.livn" description="Bildirimler: günlük özet, fırsat, güvenlik.">
  <div class="wrap st">
    <h1>Bildirimler</h1>
    <AdminLogin />
    <p class="msg" id="msg" role="status"></p>

    <section id="panel" hidden>
      <h2>Bu cihaz</h2>
      <p class="hint" id="ios" hidden>iPhone/iPad: bildirim yalnız <b>Ana Ekrana Ekle</b> ile kurulan uygulamada çalışır (Safari → Paylaş → Ana Ekrana Ekle, sonra uygulamadan bu sayfayı açın).</p>
      <p id="dev-state" class="state"></p>
      <div class="btns">
        <button type="button" id="enable" class="primary">Bu cihazda bildirimleri aç</button>
        <button type="button" id="disable" class="ghost" hidden>Bu cihazda kapat</button>
      </div>

      <h2>Kanal</h2>
      <div class="seg" role="radiogroup" id="channels">
        <label><input type="radio" name="ch" value="push" /> PWA bildirimi</label>
        <label><input type="radio" name="ch" value="ntfy" /> ntfy</label>
        <label><input type="radio" name="ch" value="both" /> İkisi</label>
      </div>
      <p class="hint">ntfy yedek kanaldır: ntfy uygulamasında gizli konuya abone olunur (konu adı yalnız repo secret'ında; NOTIFICATIONS.md).</p>

      <h2>Balık türleri</h2>
      <p class="hint">Günlük özet ve fırsat bildirimleri seçili türler için ayrı ayrı gelir.</p>
      <label class="chk"><input type="checkbox" class="sp" value="istavrit" /> İstavrit</label>
      <label class="chk"><input type="checkbox" class="sp" value="levrek" /> Levrek <span class="muted">(deneysel)</span></label>

      <h2>Bildirim türleri</h2>
      <label class="chk"><input type="checkbox" id="daily" /> Günlük özet, 17:00 — önümüzdeki 24 saatin en iyi 3 penceresi</label>
      <label class="chk"><input type="checkbox" id="opportunity" /> Fırsat — 12 saat içinde eşiği geçen, bandı dar pencere (aynı pencere bir kez)</label>
      <label class="lbl inl">Fırsat eşiği<input type="number" id="threshold" min="50" max="95" step="1" inputmode="numeric" /></label>
      <label class="chk"><input type="checkbox" id="safety" /> Güvenlik — favori merada rüzgar/dalga eşiği aşılacaksa (günde bir)</label>

      <h2>Sessiz saatler</h2>
      <div class="two">
        <label class="lbl">Başlangıç<select id="q-from"></select></label>
        <label class="lbl">Bitiş<select id="q-to"></select></label>
      </div>
      <p class="hint">Sessiz saatlerde yalnız test bildirimi gelir; bekleyen fırsat/güvenlik uyarısı hâlâ geçerliyse sonra gönderilir.</p>

      <h2>Favori meralar <span class="muted">(güvenlik uyarısı için)</span></h2>
      <ol class="favs" id="favs"></ol>

      <div class="btns">
        <button type="button" id="save" class="primary">Kaydet</button>
        <button type="button" id="test" class="ghost">Test bildirimi gönder</button>
      </div>
      <p class="hint" id="test-state"></p>
      <h2>Son gönderilenler</h2>
      <ol class="sent" id="sent"></ol>
    </section>
  </div>
</Base>

<style>
  .st h1 { font-size: var(--fs-5); font-weight: 740; font-stretch: 80%; margin: 16px 0 6px; }
  .st h2 { font-size: var(--fs-3); margin: 24px 0 8px; }
  .st h2 .muted { font-weight: 400; font-size: var(--fs-2); }
  .hint { font-size: var(--fs-2); color: var(--mist); }
  .stack { display: grid; gap: 12px; }
  .lbl { display: grid; gap: 4px; font-size: var(--fs-2); color: var(--mist); }
  .lbl.inl { grid-template-columns: 1fr 110px; align-items: center; margin: 4px 0 8px 30px; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  input, select { min-height: 48px; }
  .chk { display: flex; gap: 10px; align-items: flex-start; padding: 8px 0; min-height: 44px; }
  .chk input { width: 20px; height: 20px; margin-top: 2px; flex: none; }
  .btns { display: grid; gap: 10px; margin-top: 14px; }
  .primary { background: var(--sodium); color: #1a1205; border: 0; border-radius: 12px; font-weight: 750; min-height: 52px; font: inherit; }
  .ghost { background: transparent; color: var(--foam); border: 1px solid var(--swell); border-radius: 12px; min-height: 52px; font: inherit; font-weight: 650; }
  .seg { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .seg label { display: flex; gap: 6px; align-items: center; justify-content: center; min-height: 48px; border: 1px solid var(--swell); border-radius: 10px; font-size: var(--fs-2); }
  .seg label:has(input:checked) { border-color: var(--sodium); color: var(--sodium); }
  .favs, .sent { list-style: none; padding: 0; margin: 0; }
  .favs :global(label) { display: flex; gap: 10px; align-items: center; min-height: 44px; border-bottom: 1px solid var(--swell); }
  .favs :global(input) { width: 20px; height: 20px; }
  .sent :global(li) { font-size: var(--fs-2); color: var(--mist); padding: 4px 0; border-bottom: 1px solid var(--swell); }
  .state { font-weight: 650; }
  .msg { min-height: 1.4em; font-size: var(--fs-2); }
  .msg.err { color: var(--storm); }
</style>

<script>
  import { getToken, mountLogin, showLogin } from '../../scripts/admin';

  type Settings = { daily: boolean; opportunity: boolean; safety: boolean; threshold: number; quiet: [number, number]; favourites: string[]; channels: 'push' | 'ntfy' | 'both'; species?: string[] };
  type Status = {
    vapid_public_key: string; settings: Settings; subscriptions: { id: string }[]; sent: { kind: string; sent_at: string; key: string }[];
    test: { requested_at: string | null; done: string | null; result: Record<string, unknown> | null }; secrets: { push: boolean; ntfy: boolean } | null;
  };
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  let token = getToken();
  let st: Status;
  const KIND: Record<string, string> = { daily: 'Günlük özet', opp: 'Fırsat', safe: 'Güvenlik', test: 'Test' };
  const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  function say(t: string, err = false) { const m = $('msg'); m.textContent = t; m.classList.toggle('err', err); }

  async function api(path: string, method = 'GET', body?: unknown) {
    const r = await fetch(`/api/admin/notify${path}`, { method, headers: { authorization: `Bearer ${token}`, 'content-type': 'application/json' }, body: body === undefined ? undefined : JSON.stringify(body), cache: 'no-cache' });
    const j = await r.json().catch(() => ({}));
    if (r.status === 401) { $('panel').hidden = true; showLogin('Anahtar artık geçerli değil; yeniden girin.'); throw new Error('Anahtar hatalı.'); }
    if (!r.ok) throw new Error(j.error ?? String(r.status));
    return j;
  }

  const b64 = (s: string) => {
    const p = '='.repeat((4 - (s.length % 4)) % 4);
    const raw = atob((s + p).replace(/-/g, '+').replace(/_/g, '/'));
    return Uint8Array.from(raw, (c) => c.charCodeAt(0));
  };
  const isIos = /iphone|ipad|ipod/i.test(navigator.userAgent);
  const standalone = matchMedia('(display-mode: standalone)').matches || (navigator as Navigator & { standalone?: boolean }).standalone === true;

  async function device() {
    $('ios').hidden = !(isIos && !standalone);
    if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
      $('dev-state').textContent = isIos && !standalone ? 'Bu tarayıcıda push yok: önce Ana Ekrana Ekleyin.' : 'Bu tarayıcı push bildirimini desteklemiyor. ntfy kanalını kullanın.';
      $('enable').hidden = true;
      return null;
    }
    const reg = await navigator.serviceWorker.getRegistration();
    if (!reg) {
      $('dev-state').textContent = 'Uygulama henüz yüklenmedi; sayfayı yenileyin.';
      return null;
    }
    const sub = await reg.pushManager.getSubscription();
    $('dev-state').textContent = sub ? 'Bu cihaz kayıtlı: bildirim alır.' : Notification.permission === 'denied' ? 'Bildirim izni reddedilmiş: tarayıcı ayarlarından açın.' : 'Bu cihaz kayıtlı değil.';
    $('enable').hidden = !!sub;
    $('disable').hidden = !sub;
    return sub;
  }

  async function load() {
    st = await api('');
    $('login').hidden = true;
    $('panel').hidden = false;
    const s = st.settings;
    (['daily', 'opportunity', 'safety'] as const).forEach((k) => ($<HTMLInputElement>(k).checked = s[k]));
    $<HTMLInputElement>('threshold').value = String(s.threshold);
    document.querySelectorAll<HTMLInputElement>('input.sp').forEach((i) => (i.checked = (s.species ?? ['istavrit']).includes(i.value)));
    const hours = Array.from({ length: 24 }, (_, h) => `<option value="${h}">${String(h).padStart(2, '0')}:00</option>`).join('');
    $('q-from').innerHTML = hours;
    $('q-to').innerHTML = hours;
    $<HTMLSelectElement>('q-from').value = String(s.quiet[0]);
    $<HTMLSelectElement>('q-to').value = String(s.quiet[1]);
    document.querySelectorAll<HTMLInputElement>('input[name="ch"]').forEach((r) => (r.checked = r.value === s.channels));
    const spots = ((await (await fetch('/api/spots', { cache: 'no-cache' })).json()).spots as { id: string; name: string }[]).sort((a, b) => a.name.localeCompare(b.name, 'tr'));
    $('favs').innerHTML = spots.map((x) => `<li><label><input type="checkbox" value="${esc(x.id)}" ${s.favourites.includes(x.id) ? 'checked' : ''}/> ${esc(x.name)}</label></li>`).join('');
    $('sent').innerHTML = st.sent.length
      ? st.sent.map((x) => `<li>${new Date(x.sent_at).toLocaleString('tr-TR', { timeZone: 'Europe/Istanbul', dateStyle: 'short', timeStyle: 'short' })} · ${KIND[x.kind] ?? x.kind}</li>`).join('')
      : '<li>Henüz bildirim gönderilmedi.</li>';
    const t = st.test;
    const sec = st.secrets;
    const missing = sec ? [!sec.push && 'VAPID_PRIVATE_KEY', !sec.ntfy && 'NTFY_TOPIC'].filter(Boolean) : [];
    $('test-state').textContent = [
      t.requested_at && t.requested_at !== t.done ? `Test istendi (${new Date(t.requested_at).toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' })}); en geç 15 dakika içinde gönderilir.` : '',
      t.result ? `Son test: ${Object.entries(t.result).filter(([k]) => k !== 'at').map(([k, v]) => `${k} ${typeof v === 'object' ? `${(v as { ok: number }).ok} cihaz` : v === true ? 'iletildi' : v}`).join(', ')}.` : '',
      missing.length ? `Eksik repo secret: ${missing.join(', ')}.` : '',
    ].filter(Boolean).join(' ');
    await device();
  }

  $('enable').addEventListener('click', async () => {
    try {
      const perm = await Notification.requestPermission();
      if (perm !== 'granted') return say('Bildirim izni verilmedi.', true);
      const reg = await navigator.serviceWorker.ready;
      const sub = await reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: b64(st.vapid_public_key) });
      await api('/subscribe', 'POST', sub.toJSON());
      say('Bu cihaz kaydedildi.');
      await device();
    } catch (e) {
      say(`Açılamadı: ${(e as Error).message}`, true);
    }
  });
  $('disable').addEventListener('click', async () => {
    const reg = await navigator.serviceWorker.ready;
    const sub = await reg.pushManager.getSubscription();
    if (sub) {
      await api('/subscribe', 'DELETE', { endpoint: sub.endpoint }).catch(() => {});
      await sub.unsubscribe();
    }
    say('Bu cihazda bildirimler kapatıldı.');
    await device();
  });
  $('save').addEventListener('click', async () => {
    const body: Settings = {
      daily: $<HTMLInputElement>('daily').checked, opportunity: $<HTMLInputElement>('opportunity').checked, safety: $<HTMLInputElement>('safety').checked,
      threshold: Number($<HTMLInputElement>('threshold').value), quiet: [Number($<HTMLSelectElement>('q-from').value), Number($<HTMLSelectElement>('q-to').value)],
      favourites: [...document.querySelectorAll<HTMLInputElement>('#favs input:checked')].map((i) => i.value),
      channels: (document.querySelector<HTMLInputElement>('input[name="ch"]:checked')?.value ?? 'push') as Settings['channels'],
      species: [...document.querySelectorAll<HTMLInputElement>('input.sp:checked')].map((i) => i.value),
    };
    try {
      await api('/settings', 'PUT', body);
      say('Ayarlar kaydedildi.');
    } catch (e) {
      say(`Kaydedilmedi: ${(e as Error).message === 'invalid_threshold' ? 'eşik 50–95 arası olmalı' : (e as Error).message}`, true);
    }
  });
  $('test').addEventListener('click', async () => {
    await api('/test', 'POST').catch((e) => say((e as Error).message, true));
    say('Test istendi: puanlama işinin 15 dakikalık çalışmasında gönderilir.');
    await load();
  });
  mountLogin(document.getElementById('login') as HTMLFormElement, async () => {
    token = getToken();
    await load();
  });
</script>
