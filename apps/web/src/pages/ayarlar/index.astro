---
import Base from '../../layouts/Base.astro';
import AdminLogin from '../../components/AdminLogin.astro';
---
<Base title="Ayarlar — av.livn" description="Öneri tercihleri ve bildirimler.">
  <div class="wrap st">
    <h1>Ayarlar</h1>
    <!-- J3/J5: device preferences and how-to, visible without the admin login -->
    <section aria-labelledby="t-pref">
      <h2 id="t-pref">Öneriler (bu cihaz)</h2>
      <label class="chk"><input type="checkbox" id="outside-bursa" /> Ana öneriye Bursa dışını da dahil et <span class="muted">(Yalova kıyısı: Armutlu, Fıstıklı, Kapaklı; il rozeti görünür)</span></label>
      <p class="hint">Bu cihazda saklanır. Kapalıyken ana öneri ve alternatifler yalnız Bursa meralarından seçilir; Bursa dışı meralar listede rozetle durur. Bildirim alıyorsanız bildirim ayarları da bu tercihe uyar.</p>
      <h2>Uzaktan lamba gözlemi</h2>
      <p class="hint">Bir iskelenin gece aydınlatmasını kendiniz kontrol edebilirsiniz: Google Haritalar'da ya da Sokak Görünümü'nde iskeleye ve çevresindeki fotoğraflara bakın. Direk ve armatür görüyorsanız, mümkünse gece çekilmiş bir fotoğrafta ışığın suya düştüğünü görüyorsanız, mera kartındaki “Saha girişi”nden (<code>/saha/</code>) kaynak olarak <b>Uzaktan gözlem</b>'i seçip lambayı <b>var</b> ya da <b>yok</b> olarak girin. Fotoğraf yüklemek gerekmez. Bu giriş o meranın lamba varsayımının yerine geçer (saha &gt; uzaktan &gt; masa başı &gt; varsayım). Site Google görüntülerini otomatik çekmez; bakan ve karar veren sizsiniz.</p>
    </section>
    <!-- M2: the visitor's own tackle, on this device only -->
    <section id="takimim" aria-labelledby="t-tk">
      <h2 id="t-tk">Takımım <span class="muted">(isteğe bağlı, yalnız bu cihaz)</span></h2>
      <p class="hint">Girmezseniz öneriler genel takım sınıflarıyla verilir: <b>Ultra hafif / LRF (0,5–5 g)</b>, <b>Hafif spin (3–15 g)</b>, <b>Spin (6–30 g)</b>; ip PE 0.2–0.4 + ≈3–5 lb florokarbon lider gibi genel ölçülerle. Girerseniz öneri sizin atar aralığınıza göre inceltilir ve kartta “senin takımına göre” yazar. Bilgiler bu tarayıcıda kalır, sunucuya gönderilmez. Boş bıraktığınız takım için genel sınıf kullanılır.</p>
      <form id="my-tackle" class="stack" novalidate>
        <fieldset data-set="light"><legend>Hafif takım (LRF)</legend>
          <div class="two"><label class="lbl">Atar en az (g)<input name="min" inputmode="decimal" placeholder="0,5" /></label><label class="lbl">Atar en çok (g)<input name="max" inputmode="decimal" placeholder="5" /></label></div>
          <div class="two"><label class="lbl">Ana ip<input name="line" maxlength="60" placeholder="PE 0.3" /></label><label class="lbl">Lider<input name="leader" maxlength="60" placeholder="≈4 lb florokarbon" /></label></div>
        </fieldset>
        <fieldset data-set="heavy"><legend>Ağır takım (spin)</legend>
          <div class="two"><label class="lbl">Atar en az (g)<input name="min" inputmode="decimal" placeholder="6" /></label><label class="lbl">Atar en çok (g)<input name="max" inputmode="decimal" placeholder="30" /></label></div>
          <div class="two"><label class="lbl">Ana ip<input name="line" maxlength="60" placeholder="PE 0.8" /></label><label class="lbl">Lider<input name="leader" maxlength="60" placeholder="≈10 lb florokarbon" /></label></div>
        </fieldset>
        <!-- V2.3: what I own and what I fish with; the method suggestion puts owned gear first -->
        <fieldset id="gear"><legend>Elimdekiler <span class="muted">(yöntem önerisi önce bunları kullanır)</span></legend>
          <div class="seg" role="radiogroup" aria-label="Yöntem tercihi">
            <label><input type="radio" name="mode" value="hepsi" /> Hepsi</label>
            <label><input type="radio" name="mode" value="suni" /> Yalnız suni yem</label>
            <label><input type="radio" name="mode" value="dogal" /> Yalnız doğal yem</label>
          </div>
          <div id="gear-groups" class="gear-groups"></div>
          <p class="hint">Hiçbirini seçmezseniz öneri envanteri bilmiyor sayar; seçtiğiniz ölçüler "elimde var", seçmedikleriniz "yok" demektir.</p>
        </fieldset>
        <div class="btns">
          <button type="submit" class="primary">Bu cihazda kaydet</button>
          <button type="button" id="tk-clear" class="ghost">Temizle (genel sınıfa dön)</button>
          <button type="button" id="tk-move" class="ghost admin-only" hidden>Sunucudaki profilimi bu cihaza taşı</button>
        </div>
        <p class="hint" id="tk-msg" role="status"></p>
      </form>
    </section>

    <h2 class="admin-only" hidden>Bildirimler</h2>
    <details class="owner-login" id="owner-login"><summary>Yönetici girişi</summary><AdminLogin /></details>
    <p class="msg" id="msg" role="status"></p>

    <section id="panel" hidden>
      <h2>Bu cihaz</h2>
      <p class="hint" id="ios" hidden>iPhone/iPad: bildirim yalnız <b>Ana Ekrana Ekle</b> ile kurulan uygulamada çalışır (Safari → Paylaş → Ana Ekrana Ekle, sonra uygulamadan bu sayfayı açın).</p>
      <p id="dev-state" class="state"></p>
      <div class="btns">
        <button type="button" id="enable" class="primary">Bu cihazda bildirimleri aç</button>
        <button type="button" id="disable" class="ghost" hidden>Bu cihazda kapat</button>
      </div>

      <h2>Kanal</h2>
      <div class="seg" role="radiogroup" id="channels">
        <label><input type="radio" name="ch" value="push" /> PWA bildirimi</label>
        <label><input type="radio" name="ch" value="ntfy" /> ntfy</label>
        <label><input type="radio" name="ch" value="both" /> İkisi</label>
      </div>
      <p class="hint">ntfy yedek kanaldır: ntfy uygulamasında gizli konuya abone olunur (konu adı yalnız repo secret'ında; NOTIFICATIONS.md).</p>

      <h2>Balık türleri</h2>
      <p class="hint">Günlük özet ve fırsat bildirimleri seçili türler için ayrı ayrı gelir.</p>
      <label class="chk"><input type="checkbox" class="sp" value="istavrit" /> İstavrit</label>
      <label class="chk"><input type="checkbox" class="sp" value="levrek" /> Levrek <span class="muted">(deneysel)</span></label>

      <h2>Bildirim türleri</h2>
      <label class="chk"><input type="checkbox" id="daily" /> Günlük özet, 17:00 — önümüzdeki 24 saatin en iyi 3 penceresi</label>
      <label class="chk"><input type="checkbox" id="opportunity" /> Fırsat — 12 saat içinde eşiği geçen, bandı dar pencere (aynı pencere bir kez)</label>
      <label class="lbl inl">Fırsat eşiği<input type="number" id="threshold" min="50" max="95" step="1" inputmode="numeric" /></label>
      <label class="chk"><input type="checkbox" id="safety" /> Güvenlik — favori merada rüzgar/dalga eşiği aşılacaksa (günde bir)</label>

      <h2>Sessiz saatler</h2>
      <div class="two">
        <label class="lbl">Başlangıç<select id="q-from"></select></label>
        <label class="lbl">Bitiş<select id="q-to"></select></label>
      </div>
      <p class="hint">Sessiz saatlerde yalnız test bildirimi gelir; bekleyen fırsat/güvenlik uyarısı hâlâ geçerliyse sonra gönderilir.</p>

      <h2>Favori meralar <span class="muted">(güvenlik uyarısı için)</span></h2>
      <ol class="favs" id="favs"></ol>

      <div class="btns">
        <button type="button" id="save" class="primary">Kaydet</button>
        <button type="button" id="test" class="ghost">Test bildirimi gönder</button>
      </div>
      <p class="hint" id="test-state"></p>
      <h2>Son gönderilenler</h2>
      <ol class="sent" id="sent"></ol>
    </section>
  </div>
</Base>

<style>
  .st h1 { font-size: var(--fs-5); font-weight: 740; font-stretch: 80%; margin: 16px 0 6px; }
  .st h2 { font-size: var(--fs-3); margin: 24px 0 8px; }
  .st h2 .muted { font-weight: 400; font-size: var(--fs-2); }
  .hint { font-size: var(--fs-2); color: var(--mist); }
  .stack { display: grid; gap: 12px; }
  fieldset { border: 1px solid var(--swell); border-radius: 10px; padding: 8px 12px 12px; margin: 0; }
  .gear-groups { display: grid; gap: 10px; margin-top: 10px; }
  .gear-groups :global(.gg) { display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: 4px 8px; align-items: start; }
  .gear-groups :global(.gg .gear-ic) { margin-top: 10px; color: var(--fg-2); }
  .gear-groups :global(.gg b) { font-size: var(--fs-2); grid-column: 2; }
  .gear-groups :global(.chips) { grid-column: 2; display: flex; flex-wrap: wrap; gap: 6px; }
  .gear-groups :global(.chip) { min-height: 44px; padding: 0 12px; border-radius: 999px; border: 1px solid var(--line); background: transparent; color: var(--fg-1); font: inherit; font-size: var(--fs-2); cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
  .gear-groups :global(.chip[aria-pressed='true']) { background: var(--act); border-color: var(--act); color: var(--act-ink); }
  legend { padding: 0 4px; font-weight: 600; }
  .owner-login { margin-top: 32px; border-top: 1px solid var(--swell); padding-top: 8px; }
  .owner-login summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; color: var(--mist); }
  .lbl { display: grid; gap: 4px; font-size: var(--fs-2); color: var(--mist); }
  .lbl.inl { grid-template-columns: 1fr 110px; align-items: center; margin: 4px 0 8px 30px; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  input, select { min-height: 48px; }
  .chk { display: flex; gap: 10px; align-items: flex-start; padding: 8px 0; min-height: 44px; }
  .chk input { width: 20px; height: 20px; margin-top: 2px; flex: none; }
  .btns { display: grid; gap: 10px; margin-top: 14px; }
  .primary { background: var(--sodium); color: #1a1205; border: 0; border-radius: 12px; font-weight: 750; min-height: 52px; font: inherit; }
  .ghost { background: transparent; color: var(--foam); border: 1px solid var(--swell); border-radius: 12px; min-height: 52px; font: inherit; font-weight: 650; }
  .seg { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .seg label { display: flex; gap: 6px; align-items: center; justify-content: center; min-height: 48px; border: 1px solid var(--swell); border-radius: 10px; font-size: var(--fs-2); }
  .seg label:has(input:checked) { border-color: var(--sodium); color: var(--sodium); }
  .favs, .sent { list-style: none; padding: 0; margin: 0; }
  .favs :global(label) { display: flex; gap: 10px; align-items: center; min-height: 44px; border-bottom: 1px solid var(--swell); }
  .favs :global(input) { width: 20px; height: 20px; }
  .sent :global(li) { font-size: var(--fs-2); color: var(--mist); padding: 4px 0; border-bottom: 1px solid var(--swell); }
  .state { font-weight: 650; }
  .msg { min-height: 1.4em; font-size: var(--fs-2); }
  .msg.err { color: var(--storm); }
</style>

<script>
  import { getToken, mountLogin, showLogin } from '../../scripts/admin';
  import { BAITS, fmtG, fromServer, GEAR_OPTIONS, loadMy, parseMy, saveMy, type MyGear, type MyTackle } from '../../scripts/mytackle';
  import { gearSvg, type GearIcon } from '../../scripts/gearIcons';

  // M2: Takımım (device only)
  const tkForm = document.getElementById('my-tackle') as HTMLFormElement;
  const tkMsg = document.getElementById('tk-msg')!;
  const fillTk = (m: MyTackle | null) => {
    for (const k of ['light', 'heavy'] as const) {
      const fs = tkForm.querySelector<HTMLFieldSetElement>(`[data-set="${k}"]`)!;
      const v = m?.[k] ?? null;
      for (const f of ['min', 'max', 'line', 'leader'] as const) (fs.querySelector(`[name="${f}"]`) as HTMLInputElement).value = v ? (typeof v[f] === 'number' ? fmtG(v[f] as number) : String(v[f])) : '';
    }
  };
  // V2.3: inventory chips (sizes owned) and the method preference
  const GROUPS: [keyof typeof GEAR_OPTIONS | 'flags' | 'baits', string, GearIcon, string][] = [
    ['jighead', 'Jighead', 'jighead', 'g'], ['silikon', 'Silikon', 'silikon', 'cm'], ['mikroJig', 'Mikro jig', 'mikroJig', 'g'],
    ['kursun', 'Kurşun (dropshot / dip)', 'kursun', 'g'], ['igne', 'İğne', 'igne', 'no'], ['flags', 'Diğer', 'samandira', ''], ['baits', 'Yem', 'hamsi', ''],
  ];
  const BAIT_TR: Record<string, string> = { hamsi: 'hamsi', karides: 'karides', midye: 'midye' };
  const chip = (group: string, value: string, label: string, icon?: GearIcon) => `<button type="button" class="chip" data-g="${group}" data-v="${value}" aria-pressed="false">${icon ? gearSvg(icon, 18) : ''}${label}</button>`;
  document.getElementById('gear-groups')!.innerHTML = GROUPS.map(([g, title, icon, unit]) => {
    const items = g === 'flags' ? chip('flags', 'samandira', 'şamandıra', 'samandira') + chip('flags', 'capari', 'çapari', 'capari')
      : g === 'baits' ? BAITS.map((b) => chip('baits', b, BAIT_TR[b]!, b as GearIcon)).join('')
      : GEAR_OPTIONS[g].map((v) => chip(g, String(v), unit === 'no' ? `#${v}` : `${fmtG(v)} ${unit}`)).join('');
    return `<div class="gg">${gearSvg(icon)}<b>${title}</b><div class="chips">${items}</div></div>`;
  }).join('');
  const chips = () => [...document.querySelectorAll<HTMLButtonElement>('#gear-groups .chip')];
  chips().forEach((c) => c.addEventListener('click', () => c.setAttribute('aria-pressed', String(c.getAttribute('aria-pressed') !== 'true'))));
  const fillGear = (m: MyTackle | null) => {
    const g = m?.gear;
    chips().forEach((c) => {
      const { g: grp, v } = c.dataset as { g: string; v: string };
      const on = !g ? false : grp === 'flags' ? !!g[v as 'samandira' | 'capari'] : grp === 'baits' ? g.baits.includes(v as never) : (g[grp as keyof typeof GEAR_OPTIONS] as number[]).includes(Number(v));
      c.setAttribute('aria-pressed', String(on));
    });
    tkForm.querySelectorAll<HTMLInputElement>('input[name=mode]').forEach((r) => (r.checked = r.value === (m?.mode ?? 'hepsi')));
  };
  const readGear = (): { mode: string; gear: MyGear | null } => {
    const on = chips().filter((c) => c.getAttribute('aria-pressed') === 'true');
    const list = (grp: string) => on.filter((c) => c.dataset.g === grp).map((c) => Number(c.dataset.v));
    const mode = tkForm.querySelector<HTMLInputElement>('input[name=mode]:checked')?.value ?? 'hepsi';
    if (!on.length) return { mode, gear: null };
    return { mode, gear: { jighead: list('jighead'), silikon: list('silikon'), mikroJig: list('mikroJig'), kursun: list('kursun'), igne: list('igne'),
      samandira: on.some((c) => c.dataset.v === 'samandira'), capari: on.some((c) => c.dataset.v === 'capari'),
      baits: on.filter((c) => c.dataset.g === 'baits').map((c) => c.dataset.v as MyGear['baits'][number]) } };
  };
  fillTk(loadMy());
  fillGear(loadMy());
  tkForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const raw: Record<string, unknown> = {};
    for (const k of ['light', 'heavy']) {
      const fs = tkForm.querySelector<HTMLFieldSetElement>(`[data-set="${k}"]`)!;
      const v = (f: string) => (fs.querySelector(`[name="${f}"]`) as HTMLInputElement).value.trim();
      if (!v('min') && !v('max')) continue;
      raw[k] = { min: Number(v('min').replace(',', '.')), max: Number(v('max').replace(',', '.')), line: v('line'), leader: v('leader') };
    }
    const sets = Object.keys(raw);
    const { mode, gear } = readGear();
    if (mode !== 'hepsi') raw.mode = mode;
    if (gear) raw.gear = gear;
    const m = parseMy(JSON.stringify(raw));
    if (sets.length && (!m || sets.some((k) => !m[k as keyof MyTackle]))) { tkMsg.textContent = 'Atar aralığını gram olarak girin (en az ≤ en çok, 0,1–100 g).'; return; }
    saveMy(m);
    tkMsg.textContent = m ? 'Kaydedildi: öneriler bu cihazda senin takımına göre.' : 'Takım girilmedi; genel sınıflar kullanılıyor.';
  });
  document.getElementById('tk-clear')!.addEventListener('click', () => { saveMy(null); fillTk(null); fillGear(null); tkMsg.textContent = 'Silindi; genel takım sınıfları kullanılıyor.'; });
  document.getElementById('tk-move')!.addEventListener('click', async () => {
    const r = await fetch('/api/admin/tackle', { cache: 'no-store', headers: { authorization: `Bearer ${getToken()}` } }).catch(() => null);
    if (!r || !r.ok) { tkMsg.textContent = 'Sunucudaki profil okunamadı (yönetici anahtarı gerekli).'; return; }
    const b = (await r.json()) as { stored: boolean; profiles: Parameters<typeof fromServer>[0] };
    if (!b.stored) { tkMsg.textContent = 'Sunucuda kayıtlı kişisel profil yok.'; return; }
    const m = fromServer(b.profiles);
    saveMy(m);
    fillTk(m);
    tkMsg.textContent = 'Sunucudaki profiliniz bu cihaza taşındı (sunucudaki kopya yalnız yöneticiye açık olarak duruyor).';
  });
  // owner tools: the login stays folded for visitors; with a key on this device it is not shown
  const ownerLogin = document.getElementById('owner-login') as HTMLDetailsElement;
  if (getToken()) ownerLogin.hidden = true;

  type Settings = { daily: boolean; opportunity: boolean; safety: boolean; threshold: number; quiet: [number, number]; favourites: string[]; channels: 'push' | 'ntfy' | 'both'; species?: string[]; outside_bursa?: boolean };
  // J3: "include spots outside Bursa in the home plan" — stored on this device; notifications follow it
  const OB = 'av-livn-outside-bursa';
  const obBox = document.getElementById('outside-bursa') as HTMLInputElement;
  try { obBox.checked = localStorage.getItem(OB) === '1'; } catch {}
  obBox.addEventListener('change', async () => {
    try { localStorage.setItem(OB, obBox.checked ? '1' : '0'); } catch {}
    if (st?.settings) {
      try { await api('/settings', 'PUT', { ...st.settings, outside_bursa: obBox.checked }); st.settings.outside_bursa = obBox.checked; say('Tercih kaydedildi; bildirimler de buna uyacak.'); } catch { say('Tercih bu cihazda kaydedildi; bildirim ayarı güncellenemedi.', true); }
    }
  });
  type Status = {
    vapid_public_key: string; settings: Settings; subscriptions: { id: string }[]; sent: { kind: string; sent_at: string; key: string }[];
    test: { requested_at: string | null; done: string | null; result: Record<string, unknown> | null }; secrets: { push: boolean; ntfy: boolean } | null;
  };
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  let token = getToken();
  let st: Status;
  const KIND: Record<string, string> = { daily: 'Günlük özet', opp: 'Fırsat', safe: 'Güvenlik', test: 'Test' };
  const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  function say(t: string, err = false) { const m = $('msg'); m.textContent = t; m.classList.toggle('err', err); }

  async function api(path: string, method = 'GET', body?: unknown) {
    const r = await fetch(`/api/admin/notify${path}`, { method, headers: { authorization: `Bearer ${token}`, 'content-type': 'application/json' }, body: body === undefined ? undefined : JSON.stringify(body), cache: 'no-cache' });
    const j = await r.json().catch(() => ({}));
    if (r.status === 401) { $('panel').hidden = true; ownerLogin.hidden = false; ownerLogin.open = true; showLogin('Anahtar artık geçerli değil; yeniden girin.'); throw new Error('Anahtar hatalı.'); }
    if (!r.ok) throw new Error(j.error ?? String(r.status));
    return j;
  }

  const b64 = (s: string) => {
    const p = '='.repeat((4 - (s.length % 4)) % 4);
    const raw = atob((s + p).replace(/-/g, '+').replace(/_/g, '/'));
    return Uint8Array.from(raw, (c) => c.charCodeAt(0));
  };
  const isIos = /iphone|ipad|ipod/i.test(navigator.userAgent);
  const standalone = matchMedia('(display-mode: standalone)').matches || (navigator as Navigator & { standalone?: boolean }).standalone === true;

  async function device() {
    $('ios').hidden = !(isIos && !standalone);
    if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
      $('dev-state').textContent = isIos && !standalone ? 'Bu tarayıcıda push yok: önce Ana Ekrana Ekleyin.' : 'Bu tarayıcı push bildirimini desteklemiyor. ntfy kanalını kullanın.';
      $('enable').hidden = true;
      return null;
    }
    const reg = await navigator.serviceWorker.getRegistration();
    if (!reg) {
      $('dev-state').textContent = 'Uygulama henüz yüklenmedi; sayfayı yenileyin.';
      return null;
    }
    const sub = await reg.pushManager.getSubscription();
    $('dev-state').textContent = sub ? 'Bu cihaz kayıtlı: bildirim alır.' : Notification.permission === 'denied' ? 'Bildirim izni reddedilmiş: tarayıcı ayarlarından açın.' : 'Bu cihaz kayıtlı değil.';
    $('enable').hidden = !!sub;
    $('disable').hidden = !sub;
    return sub;
  }

  async function load() {
    st = await api('');
    $('login').hidden = true;
    $('panel').hidden = false;
    const s = st.settings;
    (['daily', 'opportunity', 'safety'] as const).forEach((k) => ($<HTMLInputElement>(k).checked = s[k]));
    $<HTMLInputElement>('threshold').value = String(s.threshold);
    document.querySelectorAll<HTMLInputElement>('input.sp').forEach((i) => (i.checked = (s.species ?? ['istavrit']).includes(i.value)));
    const hours = Array.from({ length: 24 }, (_, h) => `<option value="${h}">${String(h).padStart(2, '0')}:00</option>`).join('');
    $('q-from').innerHTML = hours;
    $('q-to').innerHTML = hours;
    $<HTMLSelectElement>('q-from').value = String(s.quiet[0]);
    $<HTMLSelectElement>('q-to').value = String(s.quiet[1]);
    document.querySelectorAll<HTMLInputElement>('input[name="ch"]').forEach((r) => (r.checked = r.value === s.channels));
    const spots = ((await (await fetch('/api/spots', { cache: 'no-cache' })).json()).spots as { id: string; name: string }[]).sort((a, b) => a.name.localeCompare(b.name, 'tr'));
    $('favs').innerHTML = spots.map((x) => `<li><label><input type="checkbox" value="${esc(x.id)}" ${s.favourites.includes(x.id) ? 'checked' : ''}/> ${esc(x.name)}</label></li>`).join('');
    $('sent').innerHTML = st.sent.length
      ? st.sent.map((x) => `<li>${new Date(x.sent_at).toLocaleString('tr-TR', { timeZone: 'Europe/Istanbul', dateStyle: 'short', timeStyle: 'short' })} · ${KIND[x.kind] ?? x.kind}</li>`).join('')
      : '<li>Henüz bildirim gönderilmedi.</li>';
    const t = st.test;
    const sec = st.secrets;
    const missing = sec ? [!sec.push && 'VAPID_PRIVATE_KEY', !sec.ntfy && 'NTFY_TOPIC'].filter(Boolean) : [];
    $('test-state').textContent = [
      t.requested_at && t.requested_at !== t.done ? `Test istendi (${new Date(t.requested_at).toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' })}); bir sonraki saatlik puanlamada (en geç ~1 saat) gönderilir.` : '',
      t.result ? `Son test: ${Object.entries(t.result).filter(([k]) => k !== 'at').map(([k, v]) => `${k} ${typeof v === 'object' ? `${(v as { ok: number }).ok} cihaz` : v === true ? 'iletildi' : v}`).join(', ')}.` : '',
      missing.length ? `Eksik repo secret: ${missing.join(', ')}.` : '',
    ].filter(Boolean).join(' ');
    await device();
  }

  $('enable').addEventListener('click', async () => {
    try {
      const perm = await Notification.requestPermission();
      if (perm !== 'granted') return say('Bildirim izni verilmedi.', true);
      const reg = await navigator.serviceWorker.ready;
      const sub = await reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: b64(st.vapid_public_key) });
      await api('/subscribe', 'POST', sub.toJSON());
      say('Bu cihaz kaydedildi.');
      await device();
    } catch (e) {
      say(`Açılamadı: ${(e as Error).message}`, true);
    }
  });
  $('disable').addEventListener('click', async () => {
    const reg = await navigator.serviceWorker.ready;
    const sub = await reg.pushManager.getSubscription();
    if (sub) {
      await api('/subscribe', 'DELETE', { endpoint: sub.endpoint }).catch(() => {});
      await sub.unsubscribe();
    }
    say('Bu cihazda bildirimler kapatıldı.');
    await device();
  });
  $('save').addEventListener('click', async () => {
    const body: Settings = {
      daily: $<HTMLInputElement>('daily').checked, opportunity: $<HTMLInputElement>('opportunity').checked, safety: $<HTMLInputElement>('safety').checked,
      threshold: Number($<HTMLInputElement>('threshold').value), quiet: [Number($<HTMLSelectElement>('q-from').value), Number($<HTMLSelectElement>('q-to').value)],
      favourites: [...document.querySelectorAll<HTMLInputElement>('#favs input:checked')].map((i) => i.value),
      channels: (document.querySelector<HTMLInputElement>('input[name="ch"]:checked')?.value ?? 'push') as Settings['channels'],
      species: [...document.querySelectorAll<HTMLInputElement>('input.sp:checked')].map((i) => i.value),
      outside_bursa: obBox.checked,
    };
    try {
      await api('/settings', 'PUT', body);
      say('Ayarlar kaydedildi.');
    } catch (e) {
      say(`Kaydedilmedi: ${(e as Error).message === 'invalid_threshold' ? 'eşik 50–95 arası olmalı' : (e as Error).message}`, true);
    }
  });
  $('test').addEventListener('click', async () => {
    await api('/test', 'POST').catch((e) => say((e as Error).message, true));
    say('Test istendi: bir sonraki saatlik puanlamada (en geç ~1 saat) gönderilir.');
    await load();
  });
  mountLogin(document.getElementById('login') as HTMLFormElement, async () => {
    token = getToken();
    document.querySelectorAll<HTMLElement>('.admin-only').forEach((e) => (e.hidden = false));
    await load();
  });
</script>
