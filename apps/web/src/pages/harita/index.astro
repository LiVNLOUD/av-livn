---
import Base from '../../layouts/Base.astro';
---
<Base title="Dip haritası — av.livn" description="Gemlik–Mudanya kıyısı derinlik konturları ve meralar." fullscreen>
  <section class="mapwrap">
    <div id="map" class="map" role="region" aria-label="Derinlik haritası ve meralar"></div>
    <aside class="card" id="card" hidden aria-live="polite"></aside>
    <div class="layers" role="radiogroup" aria-label="Harita katmanı" id="layers">
      <label><input type="radio" name="layer" value="puan" checked /><span>Puan</span></label>
      <label><input type="radio" name="layer" value="ruzgar" /><span>Rüzgar</span></label>
      <label><input type="radio" name="layer" value="dalga" /><span>Dalga</span></label>
      <label><input type="radio" name="layer" value="akinti" /><span>Akıntı</span></label>
      <label><input type="radio" name="layer" value="sst" /><span>Su sıcaklığı</span></label>
      <label><input type="radio" name="layer" value="yagis" /><span>Yağış</span></label>
      <label><input type="radio" name="layer" value="bulut" /><span>Bulut</span></label>
    </div>
    <div class="layer-info" id="layer-info" hidden aria-live="polite"></div>
    <details class="legend" id="legend">
      <summary>Lejant</summary>
      <ol class="scale" id="scale"></ol>
      <p><span class="sw survey"></span> <b>Ölçülmüş alan:</b> EMODnet'in yerinde ölçüm (sounding) olan bölgesi; ince çerçeve ve "ölçülmüş alan" yazısı. İçindeki konturlar düz çizgi.</p>
      <p><span class="sw dash"></span> Ölçülmemiş bölge: derinlik GEBCO dolgusu / enterpolasyon. Konturlar kesikli ve soluk; buradaki derinlik tahmindir. Gemlik Körfezi'nin büyük kısmı bu sınıfta.</p>
      <p><label class="lt"><input type="checkbox" id="show-interp" /> <span class="sw hatch"></span> Belirsiz derinlik katmanını göster (ölçülmemiş bölge taralı)</label></p>
      <p>Meralar uzak görünümde yerleşim rozetinde toplanır ("Armutlu · 18 mera", en iyi puanın rengi); rozete dokununca liste açılır, yakınlaşınca her mera kendi yerinde görünür.</p>
      <p><span class="sw dot"></span> Meralar v2 puan rengiyle: <b class="g">≥ 65</b>, <b class="w">40–65</b>, <b class="b">&lt; 40</b>. Yakın meralar yakınlaştırınca ayrılır; ince çizgi gerçek konumu gösterir.</p>
      <p><label class="lt"><input type="checkbox" id="show-cand" checked /> <span class="sw cand"></span> Aday yerler (OSM envanteri, henüz puanlanmadı)</label></p>
      <p><label class="lt"><input type="checkbox" id="show-forb" checked /> <span class="sw forb"></span> Taralı kırmızı alan: ticari liman, sanayi, askeri alan veya işaretlenmiş yasak alan; mera eklenmez</label></p>
      <p><span class="sw pick"></span> Turuncu halka: ana sayfadaki önerilen mera</p>
      <p>Çizgiler 2, 5, 10, 15, 20, 30, 50, 75, 100 m. EMODnet DTM ~115 m çözünürlüktedir; atış mesafesindeki derinliği göstermez. Zoom 15'ten sonra derinlik dolgusu soluklaşır ve 16'da kapanır; bu ölçekte derinlik verisi yetersizdir, yalnız sığ konturlar (≤ 10 m) kesikli kalır.</p>
    </details>
    <div class="slider" id="slider" aria-label="Haritanın saati (72 saat)"></div>
  </section>
</Base>

<style>
  .mapwrap { position: fixed; inset: 0 0 var(--tabbar-h) 0; }
  .map { position: absolute; inset: 0 0 var(--slider-h) 0; background: #11293a; }
  .mapwrap { --slider-h: 64px; }
  /* P3: 72-hour slider under the map */
  .slider { position: absolute; left: 0; right: 0; bottom: 0; height: var(--slider-h); padding: 4px 12px 6px; background: var(--deep); border-top: 1px solid var(--swell); display: grid; grid-template-columns: 1fr auto; grid-template-rows: 22px 1fr; column-gap: 10px; align-items: center; }
  :global(.ts-band) { grid-column: 1; grid-row: 1; position: relative; height: 22px; margin: 0 8px; background: rgb(245 168 60 / .10); border-radius: 3px; }
  :global(.ts-night) { position: absolute; top: 0; bottom: 0; background: #03080d; border-left: 1px solid rgb(219 230 234 / .08); border-right: 1px solid rgb(219 230 234 / .08); }
  :global(.ts-day) { position: absolute; top: 0; bottom: -28px; border-left: 1px solid rgb(219 230 234 / .35); padding-left: 4px; font-size: var(--fs-1); color: var(--mist); white-space: nowrap; pointer-events: none; }
  :global(.ts-day b) { font-weight: 560; text-shadow: 0 0 3px var(--deep); }
  :global(.ts-now) { position: absolute; top: 0; bottom: -28px; border-left: 2px solid var(--sodium); pointer-events: none; }
  :global(.ts-now i) { position: absolute; right: 3px; top: 0; font-style: normal; font-size: var(--fs-1); color: var(--sodium); }
  :global(.ts-range) { grid-column: 1; grid-row: 2; width: 100%; margin: 0; min-height: 32px; accent-color: var(--sodium); }
  :global(.ts-out) { grid-column: 2; grid-row: 1 / 3; font-size: var(--fs-2); color: var(--foam); font-weight: 600; min-width: 9.5em; text-align: right; }
  @media (max-width: 600px) { .mapwrap { --slider-h: 76px; } .slider { grid-template-columns: 1fr; grid-template-rows: 20px 1fr 18px; } :global(.ts-out) { grid-column: 1; grid-row: 3; text-align: left; min-width: 0; font-size: var(--fs-1); } }
  /* P5: layer picker and its legend */
  .layers { position: absolute; z-index: 3; top: calc(var(--header-h) + 4px); left: 10px; right: 56px; display: flex; flex-wrap: wrap; gap: 4px; } /* Q4: wraps, never scrolls sideways */
  .layers label { flex: none; position: relative; }
  .layers input { position: absolute; opacity: 0; pointer-events: none; }
  .layers span { display: inline-flex; align-items: center; min-height: 32px; padding: 0 10px; border-radius: 16px; background: color-mix(in oklab, var(--sea) 92%, transparent); border: 1px solid var(--swell); color: var(--foam); font-size: var(--fs-1); cursor: pointer; white-space: nowrap; }
  .layers input:checked + span { background: var(--sodium); color: #0e1c27; border-color: var(--sodium); font-weight: 650; }
  .layers input:focus-visible + span { outline: 2px solid var(--foam); outline-offset: 1px; }
  .layer-info { position: absolute; z-index: 3; right: 10px; bottom: calc(var(--slider-h) + 30px); max-width: min(300px, calc(100% - 20px)); background: color-mix(in oklab, var(--sea) 94%, transparent); border: 1px solid var(--swell); border-radius: 10px; padding: 8px 10px; font-size: var(--fs-1); color: var(--mist); display: grid; gap: 4px; line-height: 1.35; }
  .layer-info[hidden] { display: none; }
  :global(.ramp-bar) { display: block; height: 8px; border-radius: 4px; }
  :global(.ramp-ends) { display: flex; justify-content: space-between; color: var(--foam); }
  :global(.layer-info .muted) { opacity: .75; }
  :global(canvas.particles) { position: absolute; left: 0; top: 0; pointer-events: none; z-index: 1; }
  .legend {
    position: absolute; left: 10px; bottom: calc(var(--slider-h) + 30px); max-width: min(310px, calc(100% - 20px));
    background: color-mix(in oklab, var(--sea) 92%, transparent); border: 1px solid var(--swell); border-radius: 10px;
    padding: 8px 12px; font-size: var(--fs-1); color: var(--mist); z-index: 3;
  }
  .legend summary { cursor: pointer; color: var(--foam); font-weight: 620; font-size: var(--fs-2); min-height: 28px; display: flex; align-items: center; }
  .legend p { margin: 6px 0 0; line-height: 1.4; }
  .legend .lt { display: flex; gap: 6px; align-items: center; min-height: 32px; }
  .legend .lt input { width: 18px; height: 18px; margin: 0; }
  .sw.pick { width: 12px; height: 12px; border-radius: 50%; border: 2.5px solid var(--sodium); background: none; }
  .sw.cand { width: 10px; height: 10px; transform: rotate(45deg); border: 2px solid #b9c4c9; display: inline-block; margin: 0 4px; }
  .sw.forb { width: 14px; height: 10px; background: repeating-linear-gradient(135deg, rgb(214 80 72 / .8) 0 1.6px, transparent 1.6px 5px); border: 1.2px solid #d65048; display: inline-block; }
  .legend b.g { color: var(--good); } .legend b.w { color: var(--warn); } .legend b.b { color: var(--bad); }
  .sw { display: inline-block; width: 14px; height: 10px; border-radius: 2px; vertical-align: -1px; margin-right: 4px; }
  .sw.hatch { background: repeating-linear-gradient(135deg, rgb(219 230 234 / .7) 0 1.6px, transparent 1.6px 5.6px), #2f78a6; }
  .sw.survey { background: transparent; border: 1.5px solid #e9d9a6; }
  .sw.dash { height: 0; border-top: 2px dashed rgb(219 230 234 / .5); border-radius: 0; vertical-align: 3px; }
  .sw.dot { width: 10px; border-radius: 50%; background: var(--good); box-shadow: 0 0 0 2px var(--sea); }
  .scale { list-style: none; display: grid; grid-template-columns: repeat(6, 1fr); gap: 2px; padding: 0; margin: 8px 0 0; }
  :global(.scale li) { height: 22px; display: grid; place-items: end start; padding: 0 3px; font-size: var(--fs-1); color: var(--foam); border-radius: 2px; }
  .card {
    position: absolute; z-index: 4; left: 10px; right: 10px; top: 54px; max-width: 360px;
    background: var(--sea); border: 1px solid var(--swell); border-radius: 12px; padding: 12px 14px;
    display: grid; grid-template-columns: auto 1fr auto; gap: 12px; align-items: center; box-shadow: 0 8px 30px rgb(0 0 0 / .35);
  }
  :global(.card h2) { margin: 0; font-size: var(--fs-3); line-height: 1.25; }
  :global(.card p) { margin: 2px 0 0; font-size: var(--fs-2); color: var(--mist); }
  :global(.card a.go) { grid-column: 1 / -1; text-align: center; text-decoration: none; }
  :global(.card button.x) { background: none; border: 0; color: var(--mist); padding: 4px 8px; font-size: var(--fs-4); line-height: 1; min-width: 44px; min-height: 44px; }
  :global(.maplibregl-ctrl-attrib) { font-size: var(--fs-1); background: rgb(14 28 39 / .85) !important; color: var(--mist); }
  :global(.maplibregl-ctrl-attrib a) { color: var(--foam); }
  :global(.maplibregl-ctrl-group) { background: var(--sea); }
  :global(.maplibregl-ctrl-group button .maplibregl-ctrl-icon) { filter: invert(1); }
  :global(.maplibregl-ctrl-scale) { background: rgb(14 28 39 / .8); color: var(--foam); border-color: var(--foam); font-size: var(--fs-1); }
  :global(.maplibregl-ctrl-top-right) { top: 48px; }
  .card { top: calc(var(--header-h) + 48px); }
  @media (max-width: 600px) { .card { top: calc(var(--header-h) + 84px); } .legend:not([open]) { bottom: calc(var(--slider-h) + 30px); } .layer-info { left: 10px; right: auto; bottom: calc(var(--slider-h) + 70px); } }
</style>

<script>
  import { mountMap } from '../../scripts/map';
  import { mountSlider } from '../../scripts/timeslider';
  import { spotGlyphs, weatherLayers, type LayerName } from '../../scripts/layers';
  const q = new URLSearchParams(location.search);
  const HOURS = 72;
  const from = Math.floor(Date.now() / 3_600_000);
  // P3: coming from the plan (?t=…) the slider opens at the suggested hour
  const t = q.get('t') ? Math.floor(Date.parse(q.get('t')!) / 3_600_000) : NaN;
  let hour = Number.isFinite(t) && t >= from && t < from + HOURS ? t : from;
  const api = mountMap({ container: document.getElementById('map')!, focusId: q.get('id'), at: hour === from ? null : new Date(hour * 3_600_000).toISOString() });
  const info = document.getElementById('layer-info')!;
  const picker = document.getElementById('layers')!;
  api.ready.then((map) => {
    if (!map) { picker.hidden = true; return; } // no WebGL: the map note stands alone, layers switch off silently
    const wx = weatherLayers(map, document.getElementById('map')!, (html) => { info.innerHTML = html; info.hidden = !html; });
    const glyphs = spotGlyphs(map);
    const refresh = () => glyphs(hour, api.spotsNow());
    void wx.setHour(hour);
    void refresh();
    mountSlider(document.getElementById('slider')!, from, HOURS, hour, async (h) => {
      hour = h;
      const iso = h === from ? null : new Date(h * 3_600_000).toISOString();
      const u = new URL(location.href);
      if (iso) u.searchParams.set('t', iso); else u.searchParams.delete('t');
      history.replaceState(null, '', u);
      await Promise.all([api.setHour(iso), wx.setHour(h)]);
      await refresh();
    });
    picker.addEventListener('change', (e) => void wx.set((e.target as HTMLInputElement).value as LayerName));
    document.documentElement.dataset.layersReady = '1';
  });
</script>
