---
import Base from '../../layouts/Base.astro';
---
<Base title="Mera yönetimi — av.livn">
  <div class="wrap">
    <h1>Mera yönetimi</h1>
    <form id="login" class="stack">
      <label>Yönetici anahtarı<input type="password" id="token" autocomplete="current-password" required /></label>
      <button type="submit">Giriş yap</button>
    </form>
    <p class="msg" id="msg" role="status"></p>

    <section id="panel" hidden>
      <p><a href="/sahadayim/" class="go">Sahadayım</a> · <a href="/admin/tahmin/" class="go">Tahmin ve gerçek</a> · <a href="/saha/" class="go">Saha formu</a> · <a href="/gunluk/" class="go">Av günlüğü</a> · <button type="button" id="logout" class="linkish">Çıkış (anahtarı bu cihazdan sil)</button></p>
      <h2>Adaylar <span class="muted" id="cand-n"></span></h2>
      <p class="muted small">OpenStreetMap envanterinden önerilen yerler (docs/spots-candidates.md). Onaylanan aday bir sonraki saatlik puanlamada listeye girer; reddedilen haritadan kalkar.</p>
      <label class="toggle"><input type="text" id="cand-filter" placeholder="Ara: yerleşim, tip, ad" /></label>
      <ol class="cands" id="cands"></ol>

      <h2>Mevcut meralar</h2>
      <label>Düzenlenecek mera<select id="pick"></select></label>
      <form id="edit" class="stack">
        <label>Ad<input id="e-name" maxlength="80" required /></label>
        <label>Lamba
          <select id="e-light"><option value="">Bilinmiyor</option><option value="true">Var</option><option value="false">Yok</option></select>
        </label>
        <label>Durum
          <select id="e-status"><option value="candidate">Doğrulanmadı</option><option value="verified">Sahada doğrulandı</option><option value="rejected">Elendi</option><option value="proposed">Aday (onay bekliyor)</option></select>
        </label>
        <label>Notlar<textarea id="e-notes" rows="3" maxlength="1000"></textarea></label>
        <button type="submit">Değişiklikleri kaydet</button>
      </form>

      <h2>Yeni mera ekle</h2>
      <form id="add" class="stack">
        <label>Ad<input id="a-name" maxlength="80" required /></label>
        <div class="two">
          <label>Enlem<input id="a-lat" inputmode="decimal" required placeholder="40.3760" /></label>
          <label>Boylam<input id="a-lon" inputmode="decimal" required placeholder="28.8830" /></label>
        </div>
        <label>Denize bakan yön (derece, 0 = kuzey)<input id="a-normal" inputmode="numeric" required placeholder="0" /></label>
        <div class="two">
          <label>Deniz noktası enlem<input id="a-plat" inputmode="decimal" placeholder="isteğe bağlı" /></label>
          <label>Deniz noktası boylam<input id="a-plon" inputmode="decimal" placeholder="isteğe bağlı" /></label>
        </div>
        <button type="submit">Merayı ekle</button>
      </form>
    </section>
  </div>
</Base>

<style>
  h1 { font-size: 1.8rem; font-weight: 740; font-stretch: 80%; margin: 16px 0 12px; }
  h2 { font-size: 1rem; margin: 26px 0 10px; }
  .stack { display: grid; gap: 12px; margin-top: 12px; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .msg { min-height: 1.5em; font-size: 0.9rem; }
  .msg.err { color: var(--storm); }
  .go { color: var(--sodium); font-weight: 650; }
  .small { font-size: 0.84rem; margin: 0 0 8px; }
  .cands { list-style: none; padding: 0; margin: 8px 0 0; max-height: 60vh; overflow: auto; }
  .cands li { display: grid; grid-template-columns: 1fr auto auto; gap: 8px; align-items: center; padding: 8px 0; border-top: 1px solid var(--swell); }
  .cands b { font-weight: 620; }
  .cands span { display: block; font-size: 0.8rem; color: var(--mist); }
  .cands button { min-height: 44px; padding: 0 12px; }
  #cand-filter { width: 100%; }
  .linkish { background: none; border: 0; color: var(--mist); text-decoration: underline; cursor: pointer; font: inherit; padding: 0; }
</style>

<script>
  import { getToken, logout, setToken } from '../../scripts/admin';
  type Spot = { id: string; name: string; status: string; has_light: boolean | null; notes: string | null; kind: string; place: string | null; access: string | null };
  const KIND_TR: Record<string, string> = { pier: 'iskele', breakwater: 'mendirek', groyne: 'mahmuz', quay: 'rıhtım', harbour: 'liman / barınak', rocky: 'kayalık kıyı', beach: 'kumsal', river_mouth: 'dere ağzı', manual: 'elle' };
  const ACCESS_TR: Record<string, string> = { acik: 'erişim açık (tahmin)', belirsiz: 'erişim belirsiz', kisitli_feribot: 'kısıtlı olabilir' };
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  let token = getToken();
  let spots: Spot[] = [];

  function say(text: string, err = false) {
    const m = $('msg');
    m.textContent = text;
    m.classList.toggle('err', err);
  }

  async function api(path: string, method: string, body: unknown) {
    const r = await fetch(path, { method, headers: { authorization: `Bearer ${token}`, 'content-type': 'application/json' }, body: JSON.stringify(body) });
    const j = await r.json().catch(() => ({}));
    if (r.status === 401) throw new Error('Anahtar geçersiz. Tekrar giriş yapın.');
    if (r.status === 503) throw new Error('Yönetim kapalı: sunucuda ADMIN_TOKEN tanımlı değil.');
    if (!r.ok) throw new Error(`Kaydedilmedi (${j.error ?? r.status}).`);
    return j;
  }

  async function load() {
    const b = await (await fetch('/api/admin/spots', { headers: { authorization: `Bearer ${token}` }, cache: 'no-cache' })).json();
    spots = b.spots;
    renderCands();
    $('pick').innerHTML = spots.filter((s) => s.status !== 'proposed').map((s) => `<option value="${s.id}">${s.name.replace(/</g, '&lt;')}</option>`).join('');
    fill();
  }

  function renderCands() {
    const q = $<HTMLInputElement>('cand-filter').value.trim().toLocaleLowerCase('tr');
    const all = spots.filter((s) => s.status === 'proposed');
    const shown = all.filter((s) => !q || `${s.name} ${s.place ?? ''} ${KIND_TR[s.kind] ?? s.kind}`.toLocaleLowerCase('tr').includes(q));
    $('cand-n').textContent = `(${all.length})`;
    const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    $('cands').innerHTML = shown.length
      ? shown.map((s) => `<li><div><b>${esc(s.name)}</b><span>${esc(KIND_TR[s.kind] ?? s.kind)} · ${esc(s.place ?? '—')} · ${esc(ACCESS_TR[s.access ?? ''] ?? 'erişim ?')}</span></div>
          <button type="button" data-id="${esc(s.id)}" data-to="candidate">Onayla</button><button type="button" data-id="${esc(s.id)}" data-to="rejected">Reddet</button></li>`).join('')
      : '<li class="muted">Bekleyen aday yok.</li>';
  }

  $('cand-filter').addEventListener('input', renderCands);
  $('cands').addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest('button');
    if (!b) return;
    try {
      await api(`/api/admin/spots/${encodeURIComponent(b.dataset.id!)}`, 'PATCH', { status: b.dataset.to });
      say(b.dataset.to === 'candidate' ? 'Aday onaylandı: sonraki saatlik puanlamada listeye girer.' : 'Aday reddedildi.');
      await load();
    } catch (err) {
      say((err as Error).message, true);
    }
  });

  function fill() {
    const s = spots.find((x) => x.id === $<HTMLSelectElement>('pick').value);
    if (!s) return;
    $<HTMLInputElement>('e-name').value = s.name;
    $<HTMLSelectElement>('e-light').value = s.has_light === null ? '' : String(s.has_light);
    $<HTMLSelectElement>('e-status').value = s.status;
    $<HTMLTextAreaElement>('e-notes').value = s.notes ?? '';
  }

  function open() {
    $('login').hidden = true;
    $('panel').hidden = false;
    load().catch(() => say('Meralar alınamadı.', true));
  }

  $('login').addEventListener('submit', async (e) => {
    e.preventDefault();
    token = $<HTMLInputElement>('token').value.trim();
    try {
      // Probe auth with an empty patch: 400 means the token is accepted.
      await api('/api/admin/spots/_', 'PATCH', {}).catch((err: Error) => { if (!/empty_patch/.test(err.message)) throw err; });
      setToken(token);
      say('Giriş yapıldı.');
      open();
    } catch (err) {
      say((err as Error).message, true);
    }
  });

  $('pick').addEventListener('change', fill);

  $('edit').addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = $<HTMLSelectElement>('pick').value;
    const light = $<HTMLSelectElement>('e-light').value;
    try {
      await api(`/api/admin/spots/${encodeURIComponent(id)}`, 'PATCH', {
        name: $<HTMLInputElement>('e-name').value,
        has_light: light === '' ? null : light === 'true',
        status: $<HTMLSelectElement>('e-status').value,
        notes: $<HTMLTextAreaElement>('e-notes').value || null,
      });
      say('Değişiklikler kaydedildi.');
      await load();
      $<HTMLSelectElement>('pick').value = id;
      fill();
    } catch (err) {
      say((err as Error).message, true);
    }
  });

  $('add').addEventListener('submit', async (e) => {
    e.preventDefault();
    const n = (id: string) => ($<HTMLInputElement>(id).value.trim() === '' ? null : Number($<HTMLInputElement>(id).value.replace(',', '.')));
    try {
      const r = await api('/api/admin/spots', 'POST', {
        name: $<HTMLInputElement>('a-name').value, lat: n('a-lat'), lon: n('a-lon'), shore_normal_deg: n('a-normal'),
        probe_lat: n('a-plat'), probe_lon: n('a-plon'),
      });
      say(`Mera eklendi. Hava verisi bir sonraki saatlik güncellemede gelir.`);
      ($('add') as HTMLFormElement).reset();
      await load();
      $<HTMLSelectElement>('pick').value = r.spot.id;
      fill();
    } catch (err) {
      say((err as Error).message, true);
    }
  });

  $('logout').addEventListener('click', () => { logout(); location.reload(); });
  if (token) open();
</script>
